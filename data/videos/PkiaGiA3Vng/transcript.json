  },
  {
    "start": 1236.56,
    "duration": 2,
    "text": "根本不需要開槍",
    "hasSignLanguage": false
  },
  {
    "start": 1238.56,
    "duration": 3,
    "text": "並稱這是濫用職權導致的悲劇",
    "hasSignLanguage": false
  },
  {
    "start": 1252.56,
    "duration": 2,
    "text": "國會的民主黨陣營",
    "hasSignLanguage": false
  },
  {
    "start": 1254.56,
    "duration": 2,
    "text": "和幾位共和黨議員",
    "hasSignLanguage": false
  },
  {
    "start": 1256.56,
    "duration": 2,
    "text": "也紛紛提出了一系列",
    "hasSignLanguage": false
  },
  {
    "start": 1258.56,
    "duration": 2,
    "text": "強硬的回應措施",
    "hasSignLanguage": false
  },
  {
    "start": 1260.56,
    "duration": 2,
    "text": "包括了完整全面性的調查",
    "hasSignLanguage": false
  },
  {
    "start": 1262.56,
    "duration": 2,
    "text": "削減ICE的經費",
    "hasSignLanguage": false
  },
  {
    "start": 1264.56,
    "duration": 3,
    "text": "甚至是彈劾國土安全部長諾姆",
    "hasSignLanguage": false
  },
  {
    "start": 1267.56,
    "duration": 2,
    "text": "而民間的自由派團體週末",
