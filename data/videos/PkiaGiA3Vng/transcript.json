  },
  {
    "start": 1269.56,
    "duration": 2,
    "text": "也在全美一千個城市",
    "hasSignLanguage": false
  },
  {
    "start": 1271.56,
    "duration": 2,
    "text": "發動反ICE大遊行",
    "hasSignLanguage": false
  },
  {
    "start": 1273.56,
    "duration": 2,
    "text": "公視新聞往後再編譯",
    "hasSignLanguage": false
  },
  {
    "start": 1281.56,
    "duration": 10,
    "text": "今天大陸冷氣團減弱",
    "hasSignLanguage": true
  },
  {
    "start": 1291.56,
    "duration": 3,
    "text": "北部級東北部氣溫回升",
    "hasSignLanguage": true
  },
  {
    "start": 1294.56,
    "duration": 7,
    "text": "各地早晚人就偏冷",
