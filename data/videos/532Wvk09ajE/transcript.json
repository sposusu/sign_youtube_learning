    "start": 1009,
    "duration": 2,
    "text": "許多年輕醫師為了未來植癌發展"
  },
  {
    "sequence": 287,
    "start": 1011,
    "duration": 2,
    "text": "不願成為兒科醫師"
  },
  {
    "sequence": 288,
    "start": 1013,
    "duration": 2,
    "text": "也造成部分醫院"
  },
  {
    "sequence": 289,
    "start": 1015,
    "duration": 2,
    "text": "兒科住院醫師招募困難"
  },
  {
    "sequence": 290,
    "start": 1017,
    "duration": 2,
    "text": "連帶影響兒科加護病房值班人力"
  },
  {
    "sequence": 291,
    "start": 1019,
    "duration": 2,
    "text": "臺北榮總也坦言"
  },
  {
    "sequence": 292,
    "start": 1021,
    "duration": 2,
    "text": "的確有兒科醫師訓練完"
  },
  {
    "sequence": 293,
    "start": 1023,
    "duration": 2,
    "text": "就決定離開自行開業"
  },
  {
    "sequence": 294,
    "start": 1049,
    "duration": 2,
    "text": "臺北市醫事公會發聲明指出"
  },
  {
    "sequence": 295,
    "start": 1051,
    "duration": 2,
    "text": "兒童族群量體小"
  },
  {
    "sequence": 296,
    "start": 1053,
    "duration": 2,
    "text": "健保給付有限"
  },
  {
    "sequence": 297,
    "start": 1055,
    "duration": 2,
    "text": "難以依靠治療患者帶來的健保收益"
  },
  {
    "sequence": 298,
    "start": 1057,
    "duration": 2,
    "text": "達成收益平衡"
  },
  {
    "sequence": 299,
    "start": 1059,
    "duration": 2,
    "text": "並強調這次徵才風波"
  },
  {
    "sequence": 300,
    "start": 1061,
    "duration": 2,
    "text": "反映後續需要政府"
  },
  {
    "sequence": 301,
    "start": 1063,
    "duration": 2,
    "text": "關心整體醫療生態"
  },
  {
    "sequence": 302,
    "start": 1065,
    "duration": 2,
    "text": "避免未來兒童擊中男孩等病症"
  },
  {
    "sequence": 303,
    "start": 1067,
    "duration": 2,
    "text": "沒有兒科醫師診療"
  },
  {
    "sequence": 304,
    "start": 1069,
    "duration": 2,
    "text": "成為另一種國外危機"
  },
  {
    "sequence": 305,
    "start": 1071,
    "duration": 2,
    "text": "公視新聞賴淑敏 莊志誠"
  },
  {
    "sequence": 306,
    "start": 1073,
    "duration": 2,
    "text": "臺北報導"
  },
  {
    "sequence": 307,
    "start": 1075,
    "duration": 2,
    "text": "中華職棒"
  },
  {
    "sequence": 308,
    "start": 1077,
    "duration": 2,
    "text": "臺灣大賽第五戰"
  },
  {
    "sequence": 309,
    "start": 1079,
    "duration": 2,
    "text": "昨晚在中信兄弟的主場"
  },
  {
    "sequence": 310,
    "start": 1081,
    "duration": 2,
    "text": "台中洲際棒球場來進行"
  },
  {
    "sequence": 311,
    "start": 1083,
    "duration": 2,
    "text": "和樂天桃園"
  },
  {
    "sequence": 312,
    "start": 1085,
    "duration": 2,
    "text": "是一路纏鬥到延長賽"
  },
  {
    "sequence": 313,
    "start": 1087,
    "duration": 2,
    "text": "而最後"
  },
  {
    "sequence": 314,
    "start": 1089,
    "duration": 2,
    "text": "樂天桃園"
  },
  {
    "sequence": 315,
    "start": 1091,
    "duration": 2,
    "text": "9比7擊敗了"
  },
  {
    "sequence": 316,
    "start": 1093,
    "duration": 2,
    "text": "中信兄弟"
  },
  {
    "sequence": 317,
    "start": 1095,
    "duration": 2,
    "text": "奪下睽違六年的對許"
  },
  {
    "sequence": 318,
    "start": 1097,
    "duration": 2,
    "text": "第八冠"
  },
  {
    "sequence": 319,
    "start": 1099,
    "duration": 2,
    "text": "而這也是樂天集團"
  },
  {
    "sequence": 320,
    "start": 1101,
    "duration": 2,
    "text": "接手制度"
  },
  {
    "sequence": 321,
    "start": 1103,
    "duration": 2,
    "text": "的第八冠"
  },
  {
    "sequence": 322,
    "start": 1105,
    "duration": 2,
    "text": "這是樂天集團"
  },
  {
    "sequence": 323,
    "start": 1107,
    "duration": 2,
    "text": "接手之後的首座"
  },
  {
    "sequence": 324,
    "start": 1109,
    "duration": 2,
    "text": "總冠軍金杯"
  },
  {
    "sequence": 325,
    "start": 1111,
    "duration": 12,
    "text": "台中洲際球場的外野看臺"
  },
  {
    "sequence": 326,
    "start": 1123,
    "duration": 2,
    "text": "灑下酒紅色彩帶"
  },
  {
    "sequence": 327,
    "start": 1125,
    "duration": 2,
    "text": "樂天桃園拿下中華職棒"
  },
  {
    "sequence": 328,
    "start": 1127,
    "duration": 2,
    "text": "36年總冠軍"
  },
  {
    "sequence": 329,
    "start": 1129,
    "duration": 2,
    "text": "經過延長11局激戰"
  },
  {
    "sequence": 330,
    "start": 1131,
    "duration": 2,
    "text": "全隊衝進場內慶祝"
  },
  {
    "sequence": 331,
    "start": 1133,
    "duration": 2,
    "text": "最先得分的也是樂天桃園"
  },
  {
    "sequence": 332,
    "start": 1135,
    "duration": 8,
    "text": "原隊首局率先發動攻勢"
  },
  {
    "sequence": 333,
    "start": 1143,
    "duration": 2,
    "text": "林立和林宏裕連線幫助樂天先持得點"
  },
  {
    "sequence": 334,
    "start": 1145,
    "duration": 2,
    "text": "中信兄弟下個半局"
  },
  {
    "sequence": 335,
    "start": 1147,
    "duration": 2,
    "text": "馬上展開反攻"
  },
  {
    "sequence": 336,
    "start": 1149,
    "duration": 2,
    "text": "兩屆總冠軍賽MVP陳俊秀"
  },
  {
    "sequence": 337,
    "start": 1151,
    "duration": 2,
    "text": "系列賽首度先發展現老將價值"
  },
  {
    "sequence": 338,
    "start": 1161,
    "duration": 2,
    "text": "關鍵安打帶回兩分"
  },
  {
    "sequence": 339,
    "start": 1163,
    "duration": 2,
    "text": "相對單局攻下三分逆轉反超"
  },
  {
    "sequence": 340,
    "start": 1165,
    "duration": 2,
    "text": "原隊一路虎虎追趕"
  },
  {
    "sequence": 341,
    "start": 1167,
    "duration": 2,
    "text": "但關鍵時刻熟背卻平平出包"
  },
  {
    "sequence": 342,
    "start": 1169,
    "duration": 2,
    "text": "單場出現三次失誤"
  },
  {
    "sequence": 343,
    "start": 1171,
    "duration": 2,
    "text": "宋成瑞還在傷口上撒鹽"
  },
  {
    "sequence": 344,
    "start": 1173,
    "duration": 8,
    "text": "宋成瑞的關鍵二壘安打"
  },
  {
    "sequence": 345,
    "start": 1181,
    "duration": 2,
    "text": "幫助相對單局一口氣攻下三分"
  },
  {
    "sequence": 346,
    "start": 1183,
    "duration": 2,
    "text": "一度擴大領先來到7比3"
  },
  {
    "sequence": 347,
    "start": 1185,
    "duration": 2,
    "text": "但桃園沒有放棄"
  },
  {
    "sequence": 348,
    "start": 1187,
    "duration": 2,
    "text": "七八兩局都有分數進帳"
  },
  {
    "sequence": 349,
    "start": 1189,
    "duration": 2,
    "text": "林自瑋的滾地球讓比賽回到原點"
  },
  {
    "sequence": 350,
    "start": 1191,
    "duration": 2,
    "text": "7比7的平手局面"
  },
  {
    "sequence": 351,
    "start": 1193,
    "duration": 2,
    "text": "一直要到延長第十一局才出現變化"
  },
  {
    "sequence": 352,
    "start": 1195,
    "duration": 20,
    "text": "老將林宏裕劍功一棒突破僵局"
  },
  {
    "sequence": 353,
    "start": 1215,
    "duration": 2,
    "text": "幫樂天9比7逆轉反超"
  },
  {
    "sequence": 354,
    "start": 1217,
    "duration": 2,
    "text": "他單場四壘安打以39歲"
  },
  {
    "sequence": 355,
    "start": 1219,
    "duration": 4,
    "text": "又219天改寫總冠軍賽最年長記錄"
  },
  {
    "sequence": 356,
    "start": 1223,
    "duration": 2,
    "text": "也獲全瞻搶MVP"
  },
  {
    "sequence": 357,
    "start": 1225,
    "duration": 2,
    "text": "最後半局原隊守護神朱承陽登板"
  },
  {
    "sequence": 358,
    "start": 1227,
    "duration": 2,
    "text": "行程變向三向三下"
  },
  {
    "sequence": 359,
    "start": 1229,
    "duration": 2,
    "text": "單屆總冠軍賽四次救援成功"
  },
  {
    "sequence": 360,
    "start": 1231,
    "duration": 2,
    "text": "同樣締造新紀錄"
  },
  {
    "sequence": 361,
    "start": 1233,
    "duration": 6,
    "text": "樂天桃園成為史上第二支"
  },
  {
    "sequence": 362,
    "start": 1239,
    "duration": 2,
    "text": "沒有拿下季冠軍最終下課上"
  },
  {
    "sequence": 363,
    "start": 1241,
    "duration": 2,
    "text": "獲得總冠軍的隊伍"
  },
  {
    "sequence": 364,
    "start": 1243,
    "duration": 2,
    "text": "系列賽四勝一敗拿下"
  },
  {
    "sequence": 365,
    "start": 1245,
    "duration": 2,
    "text": "台北史第八座總冠軍"
  },
  {
    "sequence": 366,
    "start": 1247,
    "duration": 2,
    "text": "也是樂天集團入主後首冠"
  },
  {
    "sequence": 367,
    "start": 1249,
    "duration": 2,
    "text": "預計11月2號舉辦「瘋王遊行」"
  },
  {
    "sequence": 368,
    "start": 1251,
    "duration": 2,
    "text": "公視新聞正為人綜合報導"
  },
  {
    "sequence": 369,
    "start": 1253,
    "duration": 4,
    "text": "2025年亞洲盃"
  },
  {
    "sequence": 370,
    "start": 1257,
    "duration": 2,
    "text": "競技諜盃錦標賽"
  },
  {
    "sequence": 371,
    "start": 1259,
    "duration": 4,
    "text": "昨天在中國大連落幕"
  },
  {
    "sequence": 372,
    "start": 1263,
    "duration": 2,
    "text": "五國代表隊以43斤"
  },
  {
    "sequence": 373,
    "start": 1265,
    "duration": 2,
    "text": "26銀"
  },
  {
    "sequence": 374,
    "start": 1267,
    "duration": 2,
    "text": "22銅的得牌數"
  },
  {
    "sequence": 375,
    "start": 1269,
    "duration": 2,
    "text": "成為本屆最大贏家"
  },
  {
    "sequence": 376,
    "start": 1271,
    "duration": 2,
    "text": "共刷新了7項的世界記錄"
  },
  {
    "sequence": 377,
    "start": 1275,
    "duration": 2,
    "text": "而其中來自桃園"
  },
  {
    "sequence": 378,
    "start": 1277,
    "duration": 2,
    "text": "15歲的賽德克族少女"
  },
  {
    "sequence": 379,
    "start": 1279,
    "duration": 2,
    "text": "莎瑪巴紹"
  },
  {
    "sequence": 380,
    "start": 1281,
    "duration": 2,
    "text": "更以11斤3銀的驚人成績"
  },
  {
    "sequence": 381,
    "start": 1283,
    "duration": 2,
    "text": "橫掃亞洲"
  },
  {
    "sequence": 382,
    "start": 1285,
    "duration": 2,
    "text": "並刷新了三項世界記錄"
  },
  {
    "sequence": 383,
    "start": 1287,
    "duration": 10,
    "text": "來自桃園15歲的"
  },
  {
    "sequence": 384,
    "start": 1297,
    "duration": 2,
    "text": "賽德克族少女莎瑪巴紹"
  },
  {
    "sequence": 385,
    "start": 1299,
    "duration": 2,
    "text": "以壓倒性速度"
  },
  {
    "sequence": 386,
    "start": 1301,
    "duration": 2,
    "text": "在2025亞洲盃競技諜盃錦標賽中"
  },
  {
    "sequence": 387,
    "start": 1303,
    "duration": 2,
    "text": "個人包辦11斤3銀"
  },
  {
    "sequence": 388,
    "start": 1305,
    "duration": 2,
    "text": "還刷新三項世界記錄"
  },
  {
    "sequence": 389,
    "start": 1307,
    "duration": 2,
    "text": "成為世界最快的原住民族女孩"
  },
  {
    "sequence": 390,
    "start": 1309,
    "duration": 4,
    "text": "此外 莎瑪與11歲的呂宥辰"
  },
  {
    "sequence": 391,
    "start": 1313,
    "duration": 2,
    "text": "兩人攜手初戰雙人項目"
  },
  {
    "sequence": 392,
    "start": 1315,
    "duration": 2,
    "text": "也以絕佳默契"
  },
  {
    "sequence": 393,
    "start": 1317,
    "duration": 2,
    "text": "刷新16U世界記錄"
  },
  {
    "sequence": 394,
    "start": 1319,
    "duration": 8,
    "text": "而在團體賽部分"
  },
  {
    "sequence": 395,
    "start": 1327,
    "duration": 2,
    "text": "莎瑪也與李子玉等其他好手"
  },
  {
    "sequence": 396,
    "start": 1329,
    "duration": 2,
    "text": "組成CTGO的隊"
  },
  {
    "sequence": 397,
    "start": 1331,
    "duration": 2,
    "text": "橫掃18歲以下組三項團體冠軍"
  },
  {
    "sequence": 398,
    "start": 1333,
    "duration": 2,
    "text": "擁多三金隊伍榮顯"
  },
  {
    "sequence": 399,
    "start": 1359,
    "duration": 2,
    "text": "今年亞洲盃競技諜盃錦標賽"
  },
  {
    "sequence": 400,
    "start": 1361,
    "duration": 2,
    "text": "26號在中國大連落幕"
  },
  {
    "sequence": 401,
    "start": 1363,
    "duration": 2,
    "text": "我國代表隊以43斤26銀"
  },
  {
    "sequence": 402,
    "start": 1365,
    "duration": 2,
    "text": "22銅得牌數"
  },
  {
    "sequence": 403,
    "start": 1367,
    "duration": 2,
    "text": "成為本屆最大贏家"
  },
  {
    "sequence": 404,
    "start": 1369,
    "duration": 2,
    "text": "總共刷新7項世界記錄"
  },
  {
    "sequence": 405,
    "start": 1371,
    "duration": 2,
    "text": "中華競技諜盃運動推廣協會表示"
  },
  {
    "sequence": 406,
    "start": 1373,
    "duration": 2,
    "text": "臺灣透過競技諜盃運動"
  },
  {
    "sequence": 407,
    "start": 1375,
    "duration": 2,
    "text": "邁向國際"
  },
  {
    "sequence": 408,
    "start": 1377,
    "duration": 2,
    "text": "也讓世界看到臺灣"
  },
  {
    "sequence": 409,
    "start": 1379,
    "duration": 2,
    "text": "公視新聞賴淑敏莊志誠開報導"
  },
  {
    "sequence": 410,
    "start": 1389,
    "duration": 2,
    "text": "中國新創公司"
  },
  {
    "sequence": 411,
    "start": 1391,
    "duration": 2,
    "text": "推出了另一種模式"
  },
  {
    "sequence": 412,
    "start": 1393,
    "duration": 2,
    "text": "真人遠端駕駛"
  },
  {
    "sequence": 413,
    "start": 1395,
    "duration": 2,
    "text": "也就是租車的時候"
  },
  {
    "sequence": 414,
    "start": 1397,
    "duration": 2,
    "text": "會有遠端的真人"
  },
  {
    "sequence": 415,
    "start": 1399,
    "duration": 2,
    "text": "把空車開到定點"
  },
  {
    "sequence": 416,
    "start": 1401,
    "duration": 2,
    "text": "把乘客接到目的地"
  },
  {
    "sequence": 417,
    "start": 1403,
    "duration": 2,
    "text": "下車之後"
  },
  {
    "sequence": 418,
    "start": 1405,
    "duration": 2,
    "text": "車子就會直接自己開走"
  },
  {
    "sequence": 419,
    "start": 1407,
    "duration": 2,
    "text": "不必找停車位"
  },
  {
    "sequence": 420,
    "start": 1409,
    "duration": 2,
    "text": "而這項服務"
  },
  {
    "sequence": 421,
    "start": 1411,
    "duration": 2,
    "text": "已經在美國拉斯維加斯的"
  },
  {
    "sequence": 422,
    "start": 1413,
    "duration": 2,
    "text": "賭城上路"
  },
  {
    "sequence": 423,
    "start": 1415,
    "duration": 2,
    "text": "年底將會進軍"
  },
  {
    "sequence": 424,
    "start": 1417,
    "duration": 2,
    "text": "歐洲"
  },
  {
    "sequence": 425,
    "start": 1419,
    "duration": 14,
    "text": "跟多數的計程車"
  },
  {
    "sequence": 426,
    "start": 1433,
    "duration": 2,
    "text": "叫車服務一樣"
  },
  {
    "sequence": 427,
    "start": 1435,
    "duration": 2,
    "text": "APP上會顯示配對到的司機名字"
  },
  {
    "sequence": 428,
    "start": 1437,
    "duration": 2,
    "text": "但車子開來之後"
  },
  {
    "sequence": 429,
    "start": 1439,
    "duration": 2,
    "text": "司機並不在方向盤後方"
  },
  {
    "sequence": 430,
    "start": 1441,
    "duration": 2,
    "text": "其實駕駛是在遠端負責"
  },
  {
    "sequence": 431,
    "start": 1443,
    "duration": 2,
    "text": "把空車開到顧客面前"
  },
  {
    "sequence": 432,
    "start": 1445,
    "duration": 2,
    "text": "只要顧客一接手方向盤"
  },
  {
    "sequence": 433,
    "start": 1447,
    "duration": 2,
    "text": "遠端駕駛就完成了"
  },
  {
    "sequence": 434,
    "start": 1449,
    "duration": 2,
    "text": "這一趟服務"
  },
  {
    "sequence": 435,
    "start": 1451,
    "duration": 16,
    "text": "與其說這是計程車服務"
  },
  {
    "sequence": 436,
    "start": 1467,
    "duration": 2,
    "text": "不如說這是一種全新的"
  },
  {
    "sequence": 437,
    "start": 1469,
    "duration": 2,
    "text": "汽車租賃模式"
  },
  {
    "sequence": 438,
    "start": 1471,
    "duration": 2,
    "text": "需要租車的顧客完全不必"
  },
  {
    "sequence": 439,
    "start": 1473,
    "duration": 2,
    "text": "考慮找車或停車的問題"
  },
  {
    "sequence": 440,
    "start": 1475,
    "duration": 2,
    "text": "全部都有遠端"
  },
  {
    "sequence": 441,
    "start": 1477,
    "duration": 2,
    "text": "坐在駕駛台上的司機代勞"
  },
  {
    "sequence": 442,
    "start": 1479,
    "duration": 2,
    "text": "而透過多個高解析度"
  },
  {
    "sequence": 443,
    "start": 1481,
    "duration": 2,
    "text": "攝影機和感應器"
  },
  {
    "sequence": 444,
    "start": 1483,
    "duration": 2,
    "text": "遠端駕駛也能夠安全地在路上行駛"
  },
  {
    "sequence": 445,
    "start": 1485,
    "duration": 2,
    "text": "大大的減少了時間"
  },
  {
    "sequence": 446,
    "start": 1487,
    "duration": 2,
    "text": "和空間"
  },
  {
    "sequence": 447,
    "start": 1501,
    "duration": 2,
    "text": "這種遠端真人駕駛的無人車"
  },
  {
    "sequence": 448,
    "start": 1503,
    "duration": 2,
    "text": "已經在美國堵塵"
  },
  {
    "sequence": 449,
    "start": 1505,
    "duration": 2,
    "text": "投入商業營運"
  },
  {
    "sequence": 450,
    "start": 1507,
    "duration": 2,
    "text": "並累積了兩萬五千次轎車"
  },
  {
    "sequence": 451,
    "start": 1509,
    "duration": 2,
    "text": "由於它隨時都有真人"
  },
  {
    "sequence": 452,
    "start": 1511,
    "duration": 2,
    "text": "在遠端監控安全"
  },
  {
    "sequence": 453,
    "start": 1513,
    "duration": 2,
    "text": "因此也成了第一個通過歐洲監管"
  },
  {
    "sequence": 454,
    "start": 1515,
    "duration": 2,
    "text": "十二月將在母國"
  },
  {
    "sequence": 455,
    "start": 1517,
    "duration": 2,
    "text": "德國合法上路的無人車"
  },
  {
    "sequence": 456,
    "start": 1519,
    "duration": 2,
    "text": "隨著技術進步"
  },
  {
    "sequence": 457,
    "start": 1521,
    "duration": 2,
    "text": "法令放寬"
  },
  {
    "sequence": 458,
    "start": 1523,
    "duration": 2,
    "text": "未來還有更多無人車加入商業運營"
  },
  {
    "sequence": 459,
    "start": 1525,
    "duration": 2,
    "text": "城市交通"
  },
  {
    "sequence": 460,
    "start": 1527,
    "duration": 2,
    "text": "因此將變得更多元"
  },
  {
    "sequence": 461,
    "start": 1529,
    "duration": 2,
    "text": "大大減少道路雍色"
  },
  {
    "sequence": 462,
