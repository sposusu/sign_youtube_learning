  {
    "sequence": 178,
    "start": 606,
    "duration": 3,
    "text": "45名友台議員"
  },
  {
    "sequence": 179,
    "start": 609,
    "duration": 2,
    "text": "昨天起居臺灣"
  },
  {
    "sequence": 180,
    "start": 611,
    "duration": 4,
    "text": "因為歐洲跨國議會平台"
  },
  {
    "sequence": 181,
    "start": 615,
    "duration": 3,
