[
  {
    "sequence": 1,
    "start": 0,
    "duration": 10,
    "text": "MING PAO CANADA | MING PAO TORONTO"
  },
  {
    "sequence": 2,
    "start": 10,
    "duration": 2,
    "text": "MING PAO CANADA | MING PAO TORONTO"
  },
  {
    "sequence": 3,
    "start": 12,
    "duration": 2,
    "text": "看新聞 開視野"
  },
  {
    "sequence": 4,
    "start": 14,
    "duration": 6,
    "text": "歡迎收看今天10月28號的公視手語新聞"
  },
  {
    "sequence": 5,
    "start": 20,
    "duration": 2,
    "text": "首先來關心"
  },
  {
    "sequence": 6,
    "start": 22,
    "duration": 2,
    "text": "台中無期一處養豬場"
  },
  {
    "sequence": 7,
    "start": 24,
    "duration": 4,
    "text": "傳出非洲豬瘟疫情"
  },
  {
    "sequence": 8,
    "start": 28,
    "duration": 5,
    "text": "台中地檢署昨天傳訊養豬場負責人陳信負責等人"
  },
  {
    "sequence": 9,
    "start": 33,
    "duration": 2,
    "text": "來了解案情"
  },
  {
    "sequence": 10,
    "start": 35,
    "duration": 4,
    "text": "而訊後四人都請回"
  },
  {
    "sequence": 11,
    "start": 39,
    "duration": 2,
    "text": "對於疫調顯示"
  },
  {
    "sequence": 12,
    "start": 41,
    "duration": 3,
    "text": "感染來源可能是廚餘"
  },
  {
    "sequence": 13,
    "start": 44,
    "duration": 2,
    "text": "但是該案場"
  },
  {
    "sequence": 14,
    "start": 46,
    "duration": 4,
    "text": "未依規定上傳針阻紀錄"
  },
  {
    "sequence": 15,
    "start": 50,
    "duration": 2,
    "text": "台中市政府說"
  },
  {
    "sequence": 16,
    "start": 52,
    "duration": 2,
    "text": "中央規定不上傳"
  },
  {
    "sequence": 17,
    "start": 54,
    "duration": 2,
    "text": "也沒有罰則"
  },
  {
    "sequence": 18,
    "start": 56,
    "duration": 3,
    "text": "等同於沒有強制力"
  },
  {
    "sequence": 19,
    "start": 59,
    "duration": 3,
    "text": "政委陳時中則是回應"
  },
  {
    "sequence": 20,
    "start": 62,
    "duration": 2,
    "text": "目前都有相關罰則"
  },
  {
    "sequence": 21,
    "start": 64,
    "duration": 4,
    "text": "並非不告不理"
  },
  {
    "sequence": 22,
    "start": 68,
    "duration": 3,
    "text": "釐清非洲豬瘟疫情的來龍去脈"
  },
  {
    "sequence": 23,
    "start": 71,
    "duration": 3,
    "text": "台中地檢27日傳訊陳信豬農父子"
  },
  {
    "sequence": 24,
    "start": 74,
    "duration": 2,
    "text": "寄信特約受醫師"
  },
  {
    "sequence": 25,
    "start": 76,
    "duration": 2,
    "text": "以及賴信動保處人員"
  },
  {
    "sequence": 26,
    "start": 78,
    "duration": 3,
    "text": "訊後四人請回"
  },
  {
    "sequence": 27,
    "start": 81,
    "duration": 4,
    "text": "還是有哪個地方出問題你知道嗎"
  },
  {
    "sequence": 28,
    "start": 85,
    "duration": 3,
    "text": "臺灣市農業局表示經過了解"
  },
  {
    "sequence": 29,
    "start": 88,
    "duration": 3,
    "text": "無期該養豬場豬隻異常死亡期間"
  },
  {
    "sequence": 30,
    "start": 91,
    "duration": 2,
    "text": "包括寄信特約受醫師"
  },
  {
    "sequence": 31,
    "start": 93,
    "duration": 2,
    "text": "以及王信受醫佐"
  },
  {
    "sequence": 32,
    "start": 95,
    "duration": 2,
    "text": "兩個人都沒有到現場"
  },
  {
    "sequence": 33,
    "start": 97,
    "duration": 3,
    "text": "他是有講到就是說"
  },
  {
    "sequence": 34,
    "start": 100,
    "duration": 2,
    "text": "有生病的徵兆"
  },
  {
    "sequence": 35,
    "start": 102,
    "duration": 2,
    "text": "然後他有這個"
  },
  {
    "sequence": 36,
    "start": 104,
    "duration": 3,
    "text": "跟王信受醫師有做聯絡"
  },
  {
    "sequence": 37,
    "start": 107,
    "duration": 3,
    "text": "沒來啦 我沒過來啦"
  },
  {
    "sequence": 38,
    "start": 110,
    "duration": 2,
    "text": "你有沒有什麼問題"
  },
  {
    "sequence": 39,
    "start": 112,
    "duration": 3,
    "text": "我只知道一來沒辦法"
  },
  {
    "sequence": 40,
    "start": 115,
    "duration": 3,
    "text": "沒辦法給他處理"
  },
  {
    "sequence": 41,
    "start": 118,
    "duration": 3,
    "text": "一定要做研究"
  },
  {
    "sequence": 42,
    "start": 121,
    "duration": 1,
    "text": "市府農業局表示"
  },
  {
    "sequence": 43,
    "start": 122,
    "duration": 1,
    "text": "事案發三天後"
  },
  {
    "sequence": 44,
    "start": 123,
    "duration": 3,
    "text": "掌握到王信受醫佐沒有受醫執照"
  },
  {
    "sequence": 45,
    "start": 126,
    "duration": 3,
    "text": "但他疑似透過電話給予建議"
  },
  {
    "sequence": 46,
    "start": 129,
    "duration": 3,
    "text": "是否有違反動物傳染病防治條例"
  },
  {
    "sequence": 47,
    "start": 132,
    "duration": 2,
    "text": "已經請台中檢方釐清調查"
  },
  {
    "sequence": 48,
    "start": 134,
    "duration": 3,
    "text": "不過案場沒有依照規定上傳處遇資料"
  },
  {
    "sequence": 49,
    "start": 137,
    "duration": 1,
    "text": "台中市政府回應"
  },
  {
    "sequence": 50,
    "start": 138,
    "duration": 3,
    "text": "中央規定不上傳也沒有罰則"
  },
  {
    "sequence": 51,
    "start": 141,
    "duration": 2,
    "text": "等同沒有強制力"
  },
  {
    "sequence": 52,
    "start": 143,
    "duration": 1,
    "text": "建議應該修法"
  },
  {
    "sequence": 53,
    "start": 144,
    "duration": 2,
    "text": "你說他8月都沒傳"
  },
  {
    "sequence": 54,
    "start": 146,
    "duration": 2,
    "text": "那其實並不違法"
  },
  {
    "sequence": 55,
    "start": 148,
    "duration": 2,
    "text": "因為他並沒有罰則"
  },
  {
    "sequence": 56,
    "start": 150,
    "duration": 2,
    "text": "不過解決問題比較重要"
  },
  {
    "sequence": 57,
    "start": 152,
    "duration": 2,
    "text": "但是行政府政務委員陳時中回應"
  },
  {
    "sequence": 58,
    "start": 154,
    "duration": 2,
    "text": "目前有相關罰則"
  },
  {
    "sequence": 59,
    "start": 156,
    "duration": 1,
    "text": "而非不告不理"
  },
  {
    "sequence": 60,
    "start": 157,
    "duration": 2,
    "text": "在廢棄物清理法中"
  },
  {
    "sequence": 61,
    "start": 159,
    "duration": 3,
    "text": "如果養豬場收受一般家戶用廚餘"
  },
  {
    "sequence": 62,
    "start": 162,
    "duration": 2,
    "text": "位一規定徵主"
  },
  {
    "sequence": 63,
    "start": 164,
    "duration": 2,
    "text": "可處1200元到6000元罰還"
  },
  {
    "sequence": 64,
    "start": 166,
    "duration": 3,
    "text": "如果是利用事業廚餘的養豬場"
  },
  {
    "sequence": 65,
    "start": 169,
    "duration": 2,
    "text": "可處最高300萬罰還"
  },
  {
    "sequence": 66,
    "start": 171,
    "duration": 14,
    "text": "防堵疫情刻不容緩"
  },
  {
    "sequence": 67,
    "start": 185,
    "duration": 2,
    "text": "中央災害應變中心已經要求市府"
  },
  {
    "sequence": 68,
    "start": 187,
    "duration": 3,
    "text": "28日下午前要提出完整疫調"
  },
  {
    "sequence": 69,
    "start": 190,
    "duration": 3,
    "text": "另外在武器養豬場清消後"
  },
  {
    "sequence": 70,
    "start": 193,
    "duration": 2,
    "text": "仍舊有兩處驗出病毒陽性"
  },
  {
    "sequence": 71,
    "start": 195,
    "duration": 3,
    "text": "也已經請地方加強再清消"
  },
  {
    "sequence": 72,
    "start": 198,
    "duration": 1,
    "text": "公視新聞林建生"
  },
  {
    "sequence": 73,
    "start": 199,
    "duration": 3,
    "text": "網路桃豬鳳豬武器商綜合報導"
  },
  {
    "sequence": 74,
    "start": 202,
    "duration": 5,
    "text": "台中養豬場爆發非洲豬瘟"
  },
  {
    "sequence": 75,
    "start": 207,
    "duration": 6,
    "text": "全台豬隻進載禁運到11月6日"
  },
  {
    "sequence": 76,
    "start": 213,
    "duration": 6,
    "text": "而到時候會多出大約30萬頭豬可以銷售"
  },
  {
    "sequence": 77,
    "start": 219,
    "duration": 2,
    "text": "怕豬價崩盤"
  },
  {
    "sequence": 78,
    "start": 221,
    "duration": 4,
    "text": "中央提出了配套措施"
  },
  {
    "sequence": 79,
    "start": 225,
    "duration": 4,
    "text": "會以登記方式秩序出租"
  },
  {
    "sequence": 80,
    "start": 229,
    "duration": 9,
    "text": "而另外也宣布啟動第二輪防疫強化措施"
  },
  {
    "sequence": 81,
    "start": 238,
    "duration": 4,
    "text": "清消部分落實移動人車管制"
  },
  {
    "sequence": 82,
    "start": 242,
    "duration": 3,
    "text": "增加隨機攔檢作業"
  },
  {
    "sequence": 83,
    "start": 245,
    "duration": 7,
    "text": "隨著爆發非洲豬瘟首例疫情"
  },
  {
    "sequence": 84,
    "start": 252,
    "duration": 3,
    "text": "農業部祭出禁運進宅等配套措施"
  },
  {
    "sequence": 85,
    "start": 255,
    "duration": 2,
    "text": "延長十天到11月6日"
  },
  {
    "sequence": 86,
    "start": 257,
    "duration": 2,
    "text": "全國每天上市的豬隻大約兩萬頭"
  },
  {
    "sequence": 87,
    "start": 259,
    "duration": 4,
    "text": "養豬協會預估將會有約30萬頭等待上市"
  },
  {
    "sequence": 88,
    "start": 263,
    "duration": 3,
    "text": "外界擔心到時候大批豬隻湧入拍賣市場"
  },
  {
    "sequence": 89,
    "start": 266,
    "duration": 1,
    "text": "豬價會崩盤"
  },
  {
    "sequence": 90,
    "start": 267,
    "duration": 3,
    "text": "為了平穩豬價農業部提出配套措施"
  },
  {
    "sequence": 91,
    "start": 270,
    "duration": 3,
    "text": "聯合養豬協會等單位開會討論"
  },
  {
    "sequence": 92,
    "start": 273,
    "duration": 2,
    "text": "以登記的方式秩序出租"
  },
  {
    "sequence": 93,
    "start": 282,
    "duration": 3,
    "text": "那因為有秩序的出租"
  },
  {
    "sequence": 94,
    "start": 285,
    "duration": 4,
    "text": "才有機會讓我們的價格能夠穩定"
  },
  {
    "sequence": 95,
    "start": 289,
    "duration": 8,
    "text": "雖然豬隻禁運進宅"
  },
  {
    "sequence": 96,
    "start": 297,
    "duration": 4,
    "text": "臺南還是發生了私自運送豬隻的違規案件"
  },
  {
    "sequence": 97,
    "start": 301,
    "duration": 1,
    "text": "除了重罰之外"
  },
  {
    "sequence": 98,
    "start": 302,
    "duration": 3,
    "text": "政府也宣佈啟動第二輪的防疫強化措施"
  },
  {
    "sequence": 99,
    "start": 305,
    "duration": 2,
    "text": "包括分級查訪 強化清消"
  },
  {
    "sequence": 100,
    "start": 307,
    "duration": 4,
    "text": "精準疫調和擴大追查等四大措施的精進措施"
  },
  {
    "sequence": 101,
    "start": 311,
    "duration": 2,
    "text": "以下是依風險分級豬場"
  },
  {
    "sequence": 102,
    "start": 313,
    "duration": 3,
    "text": "相對高風險者每日訪視 清消的部分"
  },
  {
    "sequence": 103,
    "start": 316,
    "duration": 4,
    "text": "落實移動人車管制 增加隨機攔檢作業等等"
  },
  {
    "sequence": 104,
    "start": 320,
    "duration": 13,
    "text": "由於臺中岸場已經完成清消"
  },
  {
    "sequence": 105,
    "start": 333,
    "duration": 3,
    "text": "卻還是被檢出兩處有核酸陽性反應"
  },
  {
    "sequence": 106,
    "start": 336,
    "duration": 2,
    "text": "是否因為現場管制不佳造成污染"
  },
  {
    "sequence": 107,
    "start": 338,
    "duration": 3,
    "text": "應變中心要求臺中市府進行加強管制"
  },
  {
    "sequence": 108,
    "start": 341,
    "duration": 10,
    "text": "對於政府是否對豬農和攤商補助"
  },
  {
    "sequence": 109,
    "start": 351,
    "duration": 3,
    "text": "經濟部表示會去瞭解傳統市場攤商的情況"
  },
  {
    "sequence": 110,
    "start": 354,
    "duration": 4,
    "text": "一週內擬出補助方案 行政府長卓翁泰強調"
  },
  {
    "sequence": 111,
    "start": 358,
    "duration": 2,
    "text": "會依照時程及需要來做處理"
  },
  {
    "sequence": 112,
    "start": 360,
    "duration": 2,
    "text": "為了滿足國人所需 農業部"
  },
  {
    "sequence": 113,
    "start": 362,
    "duration": 2,
    "text": "已經媒合肉品冷凍工會"
  },
  {
    "sequence": 114,
    "start": 364,
    "duration": 3,
    "text": "提供冷凍冷藏豬肉和十七萬噸的雞肉"
  },
  {
    "sequence": 115,
    "start": 367,
    "duration": 3,
    "text": "做肉品替代來源 並且建立肉品供應"
  },
  {
    "sequence": 116,
    "start": 370,
    "duration": 3,
    "text": "調度聯繫平臺和廠商名單 提供團善的"
  },
  {
    "sequence": 117,
    "start": 373,
    "duration": 4,
    "text": "業者聯繫協助調度供應 公視新聞陳佳馨"
  },
  {
    "sequence": 118,
    "start": 377,
    "duration": 2,
    "text": "謝其文 邱福財臺北報導"
  },
  {
    "sequence": 119,
    "start": 379,
    "duration": 6,
    "text": "中央宣佈活豬禁載禁運令再延長"
  },
  {
    "sequence": 120,
    "start": 385,
    "duration": 3,
    "text": "儘管業者都願意配合防疫"
  },
  {
    "sequence": 121,
    "start": 388,
    "duration": 4,
    "text": "但是仍受到了不小的影響"
  },
  {
    "sequence": 122,
    "start": 392,
    "duration": 3,
    "text": "有些像是只賣肉圓或香腸等單一"
  },
  {
    "sequence": 123,
    "start": 395,
    "duration": 2,
    "text": "肉品的店家就說"
  },
  {
    "sequence": 124,
    "start": 397,
    "duration": 3,
    "text": "如果真的買不到豬肉"
  },
  {
    "sequence": 125,
    "start": 400,
    "duration": 2,
    "text": "恐怕只能暫時停業"
  },
  {
    "sequence": 126,
    "start": 402,
    "duration": 4,
    "text": "店門口天上限量告示 高雄老店"
  },
  {
    "sequence": 127,
    "start": 406,
    "duration": 3,
    "text": "阿英排骨飯在二十二號宣佈活豬禁載"
  },
  {
    "sequence": 128,
    "start": 409,
    "duration": 2,
    "text": "禁運令當天就多叫貨備用"
  },
  {
    "sequence": 129,
    "start": 411,
    "duration": 3,
    "text": "在每天限量方式希望撐過五天禁令"
  },
  {
    "sequence": 130,
    "start": 414,
    "duration": 3,
    "text": "但由於中央禁令將再延長十天"
  },
  {
    "sequence": 131,
    "start": 417,
    "duration": 2,
    "text": "店家只能走一步算一步"
  },
  {
    "sequence": 132,
    "start": 419,
    "duration": 2,
    "text": "另一老店業上海澤無奈表示"
  },
  {
    "sequence": 133,
    "start": 421,
    "duration": 2,
    "text": "非洲豬瘟案例爆發至今"
  },
  {
    "sequence": 134,
    "start": 423,
    "duration": 2,
    "text": "生意已下滑約兩成"
  },
  {
    "sequence": 135,
    "start": 425,
    "duration": 2,
    "text": "三合市場僅剩的一個豬肉攤商"
  },
  {
    "sequence": 136,
    "start": 427,
    "duration": 2,
    "text": "庫存也只剩三天"
  },
  {
    "sequence": 137,
    "start": 429,
    "duration": 4,
    "text": "禮拜五那天 它是臨時公佈的"
  },
  {
    "sequence": 138,
    "start": 433,
    "duration": 3,
    "text": "我們就沒辦法去大賣場拿貨了"
  },
  {
    "sequence": 139,
    "start": 436,
    "duration": 3,
    "text": "就算你有錢你也買不到豬肉"
  },
  {
    "sequence": 140,
    "start": 439,
    "duration": 5,
    "text": "就暫時吃一些牛肉 雞肉 鴨肉 鵝肉"
  },
  {
    "sequence": 141,
    "start": 444,
    "duration": 2,
    "text": "受非洲豬瘟疾活豬禁載禁運影響"
  },
  {
    "sequence": 142,
    "start": 446,
    "duration": 3,
    "text": "市場人潮變少 買不到生鮮豬肉"
  },
  {
    "sequence": 143,
    "start": 449,
    "duration": 3,
    "text": "有民眾選擇到滷味等小吃攤位買熟食"
