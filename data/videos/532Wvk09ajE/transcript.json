    "text": "來自歐洲議會及歐洲十八國國會的"
  },
  {
    "sequence": 198,
    "start": 669,
    "duration": 2,
    "text": "45名友台議員起居臺灣"
  },
  {
    "sequence": 199,
    "start": 683,
    "duration": 11,
    "text": "福爾摩沙俱樂部在2019年10月"
