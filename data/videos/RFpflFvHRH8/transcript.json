  {
    "sequence": 287,
    "start": 862,
    "duration": 2,
    "text": "教育主管機關應有實際政策"
  },
  {
    "sequence": 288,
    "start": 864,
    "duration": 2,
    "text": "呼應對教育專業的支持"
  },
  {
    "sequence": 289,
    "start": 866,
    "duration": 2,
    "text": "而面對校事會議亂象"
  },
  {
    "sequence": 290,
    "start": 868,
