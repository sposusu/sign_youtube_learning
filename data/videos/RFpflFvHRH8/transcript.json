[
  {
    "sequence": 1,
    "start": 0,
    "duration": 12,
    "text": "[音樂]"
  },
  {
    "sequence": 2,
    "start": 12,
    "duration": 2,
    "text": "看新聞,開視野"
  },
  {
    "sequence": 3,
    "start": 14,
    "duration": 5,
    "text": "歡迎收看今天9月10號的公視手語新聞"
  },
  {
    "sequence": 4,
    "start": 19,
    "duration": 1,
    "text": "首先來關心"
  },
  {
    "sequence": 5,
    "start": 20,
    "duration": 2,
    "text": "高雄興達電廠"
  },
  {
    "sequence": 6,
    "start": 22,
    "duration": 3,
    "text": "昨天晚間傳出火警"
  },
  {
    "sequence": 7,
    "start": 25,
    "duration": 3,
    "text": "所幸火勢在半個小時左右撲滅"
  },
  {
    "sequence": 8,
    "start": 28,
    "duration": 2,
    "text": "沒有傳出傷亡"
  },
  {
    "sequence": 9,
    "start": 30,
    "duration": 2,
    "text": "台電指出"
  },
  {
    "sequence": 10,
    "start": 32,
    "duration": 2,
    "text": "起火的是新建機組"
  },
  {
    "sequence": 11,
    "start": 34,
    "duration": 3,
    "text": "目前正處於測試階段"
  },
  {
    "sequence": 12,
    "start": 37,
    "duration": 3,
    "text": "火災沒有影響既有的機組運轉"
  },
  {
    "sequence": 13,
    "start": 40,
    "duration": 4,
    "text": "也不會影響今年的整體供電狀況"
  },
  {
    "sequence": 14,
    "start": 44,
    "duration": 3,
    "text": "不過這起事故也讓附近民眾嚇壞了"
  },
  {
    "sequence": 15,
    "start": 47,
    "duration": 3,
    "text": "地方里長要求台電全面停工"
  },
  {
    "sequence": 16,
    "start": 50,
    "duration": 2,
    "text": "釐清責任"
  },
  {
    "sequence": 17,
    "start": 52,
    "duration": 3,
    "text": "台電董事長曾文生說明"
  },
  {
    "sequence": 18,
    "start": 55,
    "duration": 4,
    "text": "這場意外應該是天然氣洩漏造成"
  },
  {
    "sequence": 19,
    "start": 59,
    "duration": 3,
    "text": "上午9點會先由施工處"
  },
  {
    "sequence": 20,
    "start": 62,
    "duration": 2,
    "text": "以及興達電廠廠長"
  },
  {
    "sequence": 21,
    "start": 64,
    "duration": 3,
    "text": "來向里長說明"
  },
  {
    "sequence": 22,
    "start": 67,
    "duration": 5,
    "text": "熊熊火光照亮夜空"
  },
  {
    "sequence": 23,
    "start": 72,
    "duration": 2,
    "text": "還伴隨濃煙不斷竄出"
  },
  {
    "sequence": 24,
    "start": 74,
    "duration": 2,
    "text": "不時還傳出爆炸聲響"
  },
  {
    "sequence": 25,
    "start": 76,
    "duration": 3,
    "text": "讓廠區員工都平平後退"
  },
  {
    "sequence": 26,
    "start": 79,
    "duration": 1,
    "text": "火勢一發不可收拾"
  },
  {
    "sequence": 27,
    "start": 80,
    "duration": 1,
    "text": "好幾公里外的民眾"
  },
  {
    "sequence": 28,
    "start": 81,
    "duration": 3,
    "text": "都錄下電廠大火的瞬間"
  },
  {
    "sequence": 29,
    "start": 84,
    "duration": 2,
    "text": "高雄興達發電廠傳出火警"
  },
  {
    "sequence": 30,
    "start": 86,
    "duration": 2,
    "text": "嚇壞附近民眾"
  },
  {
    "sequence": 31,
    "start": 88,
    "duration": 17,
    "text": "9號晚間8點左右"
  },
  {
    "sequence": 32,
    "start": 105,
    "duration": 2,
    "text": "高雄興達發電廠2號"
  },
  {
    "sequence": 33,
    "start": 107,
    "duration": 2,
    "text": "新機組要施運轉"
  },
  {
    "sequence": 34,
    "start": 109,
    "duration": 1,
    "text": "疑似因為天然氣洩漏"
  },
  {
    "sequence": 35,
    "start": 110,
    "duration": 3,
    "text": "導致現場頻頻傳出爆炸聲"
  },
  {
    "sequence": 36,
    "start": 113,
    "duration": 2,
    "text": "也讓廠區陷入火海"
  },
  {
    "sequence": 37,
    "start": 115,
    "duration": 3,
    "text": "由於爆炸疑似與天然氣外洩有關"
  },
  {
    "sequence": 38,
    "start": 118,
    "duration": 1,
    "text": "地方里長抨擊台電"
  },
  {
    "sequence": 39,
    "start": 119,
    "duration": 3,
    "text": "為即時通報要求立即啟動"
  },
  {
    "sequence": 40,
    "start": 122,
    "duration": 16,
    "text": "興達電廠原本是燃煤電廠"
  },
  {
    "sequence": 41,
    "start": 138,
    "duration": 1,
    "text": "1998年增設"
  },
  {
    "sequence": 42,
    "start": 139,
    "duration": 2,
    "text": "5部燃氣渦輪發電機組"
  },
  {
    "sequence": 43,
    "start": 141,
    "duration": 3,
    "text": "目前燃煤一二號機已經處以轉為"
  },
  {
    "sequence": 44,
    "start": 144,
    "duration": 2,
    "text": "緊急備用電力設施"
  },
  {
    "sequence": 45,
    "start": 146,
    "duration": 1,
    "text": "為了強化供電韌性"
  },
  {
    "sequence": 46,
    "start": 147,
    "duration": 3,
    "text": "台電啟動燃氣機組更新改建計畫"
  },
  {
    "sequence": 47,
    "start": 150,
    "duration": 2,
    "text": "在南側基地新設燃氣機組"
  },
  {
    "sequence": 48,
    "start": 152,
    "duration": 2,
    "text": "9號起火的位置就是"
  },
  {
    "sequence": 49,
    "start": 154,
    "duration": 3,
    "text": "施工中的新2號燃氣機組"
  },
  {
    "sequence": 50,
    "start": 171,
    "duration": 3,
    "text": "這個天然氣的管線是沒有哪個地方"
  },
  {
    "sequence": 51,
    "start": 174,
    "duration": 1,
    "text": "有可能有洩漏"
  },
  {
    "sequence": 52,
    "start": 175,
    "duration": 2,
    "text": "因為現在火場還是黑的"
  },
  {
    "sequence": 53,
    "start": 177,
    "duration": 2,
    "text": "那也還不能夠收電"
  },
  {
    "sequence": 54,
    "start": 179,
    "duration": 2,
    "text": "所以我們會等明天早上天亮"
  },
  {
    "sequence": 55,
    "start": 181,
    "duration": 3,
    "text": "來做一個清楚的處理"
  },
  {
    "sequence": 56,
    "start": 184,
    "duration": 1,
    "text": "台電董事長曾文生"
  },
  {
    "sequence": 57,
    "start": 185,
    "duration": 2,
    "text": "凌晨到現場瞭解狀況"
  },
  {
    "sequence": 58,
    "start": 187,
    "duration": 3,
    "text": "初步判斷因天然氣外洩導致起火"
  },
  {
    "sequence": 59,
    "start": 190,
    "duration": 1,
    "text": "並排除人為因素"
  },
  {
    "sequence": 60,
    "start": 191,
    "duration": 2,
    "text": "後續將召集相關單位"
  },
  {
    "sequence": 61,
    "start": 193,
    "duration": 2,
    "text": "釐清事故原因"
  },
  {
    "sequence": 62,
    "start": 195,
    "duration": 2,
    "text": "公視新聞綜合報導"
  },
  {
    "sequence": 63,
    "start": 198,
    "duration": 3,
    "text": "獨報時間來看到"
  },
  {
    "sequence": 64,
    "start": 201,
    "duration": 2,
    "text": "自由時報報導"
  },
  {
    "sequence": 65,
    "start": 203,
    "duration": 3,
    "text": "尼泊爾政府封鎖了社群媒體"
  },
  {
    "sequence": 66,
    "start": 206,
    "duration": 2,
    "text": "還有貪腐文化"
  },
  {
    "sequence": 67,
    "start": 208,
    "duration": 4,
    "text": "都引發年輕人不滿上街抗議"
  },
  {
    "sequence": 68,
    "start": 212,
    "duration": 4,
    "text": "警方射殺至少19名的抗議者後"
  },
  {
    "sequence": 69,
    "start": 216,
    "duration": 4,
    "text": "首都加德滿都陷入混亂"
  },
  {
    "sequence": 70,
    "start": 220,
    "duration": 4,
    "text": "總理奧利昨天宣布辭職"
  },
  {
    "sequence": 71,
    "start": 224,
    "duration": 5,
    "text": "但是為平行民怨抗議運動持續升級"
  },
  {
    "sequence": 72,
    "start": 229,
    "duration": 3,
    "text": "中國時報是"
  },
  {
    "sequence": 73,
    "start": 232,
    "duration": 2,
    "text": "南韓現代汽車"
  },
  {
    "sequence": 74,
    "start": 234,
    "duration": 3,
    "text": "在美國喬治亞州的電池工廠"
  },
  {
    "sequence": 75,
    "start": 237,
    "duration": 5,
    "text": "遭到美國移民單位大動作查緝"
  },
  {
    "sequence": 76,
    "start": 242,
    "duration": 2,
    "text": "逮捕了300多名"
  },
  {
    "sequence": 77,
    "start": 244,
    "duration": 3,
    "text": "涉嫌在美國非法打工的韓國人"
  },
  {
    "sequence": 78,
    "start": 247,
    "duration": 3,
    "text": "而此舉震驚國際"
  },
  {
    "sequence": 79,
    "start": 250,
    "duration": 2,
    "text": "目前多家韓國企業"
  },
  {
    "sequence": 80,
    "start": 252,
    "duration": 5,
    "text": "已經暫停了22項在美國的建廠計畫"
  },
  {
    "sequence": 81,
    "start": 257,
    "duration": 4,
    "text": "聯合報提到了"
  },
  {
    "sequence": 82,
    "start": 261,
    "duration": 5,
    "text": "中央統籌分配稅款與補助款爭議延燒"
  },
  {
    "sequence": 83,
    "start": 266,
    "duration": 2,
    "text": "台中市長盧秀燕"
  },
  {
    "sequence": 84,
    "start": 268,
    "duration": 3,
    "text": "召集藍白與無黨籍絕症"
  },
  {
    "sequence": 85,
    "start": 271,
    "duration": 3,
    "text": "共15縣市首長"
  },
  {
    "sequence": 86,
    "start": 274,
    "duration": 4,
    "text": "今天將要在台北市開記者會"
  },
  {
    "sequence": 87,
    "start": 278,
    "duration": 4,
    "text": "與中央公平公開分配"
  },
  {
    "sequence": 88,
    "start": 282,
    "duration": 5,
    "text": "而看完了報紙的重點之後"
  },
  {
    "sequence": 89,
    "start": 287,
    "duration": 2,
    "text": "繼續再來關心"
  },
  {
    "sequence": 90,
    "start": 289,
    "duration": 3,
    "text": "台股昨天開紅盤"
  },
  {
    "sequence": 91,
    "start": 292,
    "duration": 4,
    "text": "盤中跟收盤都創歷史新高"
  },
  {
    "sequence": 92,
    "start": 296,
    "duration": 5,
    "text": "中場收債24855點"
  },
  {
    "sequence": 93,
    "start": 301,
    "duration": 3,
    "text": "總市值一口氣突破了80兆元"
  },
  {
    "sequence": 94,
    "start": 304,
    "duration": 4,
    "text": "成為全球股市規模第十大"
  },
  {
    "sequence": 95,
    "start": 308,
    "duration": 2,
    "text": "美股四大指數全面收紅"
  },
  {
    "sequence": 96,
    "start": 310,
    "duration": 2,
    "text": "九號台股跟著創歷史新高"
  },
  {
    "sequence": 97,
    "start": 312,
    "duration": 2,
    "text": "盤中拉高24880點"
  },
  {
    "sequence": 98,
    "start": 314,
    "duration": 3,
    "text": "隨後漲勢收鏈收債24855點"
  },
  {
    "sequence": 99,
    "start": 317,
    "duration": 2,
    "text": "雙雙斜歷史紀錄"
  },
  {
    "sequence": 100,
    "start": 319,
    "duration": 2,
    "text": "全值股台積電也同樣亮眼"
  },
  {
    "sequence": 101,
    "start": 321,
    "duration": 3,
    "text": "收盤1200元觸及歷史高點"
  },
  {
    "sequence": 102,
    "start": 324,
    "duration": 3,
    "text": "台股總市值同時衝破80兆元大關"
  },
  {
    "sequence": 103,
    "start": 327,
    "duration": 3,
    "text": "成為全球股市規模第十大市場"
  },
  {
    "sequence": 104,
    "start": 330,
    "duration": 3,
    "text": "相關的傳產受到的衝擊影響"
  },
  {
    "sequence": 105,
    "start": 333,
    "duration": 1,
    "text": "就會比較大"
  },
  {
    "sequence": 106,
    "start": 334,
    "duration": 3,
    "text": "那當然這就相對凸顯了"
  },
  {
    "sequence": 107,
    "start": 337,
    "duration": 2,
    "text": "沒有受到對等關稅"
  },
  {
    "sequence": 108,
    "start": 339,
    "duration": 3,
    "text": "跟二三二影響的半導體"
  },
  {
    "sequence": 109,
    "start": 342,
    "duration": 3,
    "text": "跟AI供應鏈相對就會比較強勢"
  },
  {
    "sequence": 110,
    "start": 345,
    "duration": 2,
    "text": "法人分析本週半導體戰"
  },
  {
    "sequence": 111,
    "start": 347,
    "duration": 2,
    "text": "蘋果公司新機發表等都市力多"
  },
  {
    "sequence": 112,
    "start": 349,
    "duration": 2,
    "text": "但美中晶片戰陰影之下"
  },
  {
    "sequence": 113,
    "start": 351,
    "duration": 3,
    "text": "全球供應鏈重組地緣政治風險加大"
  },
  {
    "sequence": 114,
    "start": 354,
    "duration": 2,
    "text": "華碩董事長施崇棠認為"
  },
  {
    "sequence": 115,
    "start": 356,
    "duration": 2,
    "text": "今年是主權AI部署轉折點"
  },
  {
    "sequence": 116,
    "start": 358,
    "duration": 2,
    "text": "臺灣不能缺席"
  },
  {
    "sequence": 117,
    "start": 360,
    "duration": 4,
    "text": "我們不是參與這場變局的旁觀者"
  },
  {
    "sequence": 118,
    "start": 364,
    "duration": 3,
    "text": "更應該成為可信任應用"
  },
  {
    "sequence": 119,
    "start": 367,
    "duration": 2,
    "text": "垂直場域導入"
  },
  {
    "sequence": 120,
    "start": 369,
    "duration": 3,
    "text": "與AI治理實踐的貢獻者"
  },
  {
    "sequence": 121,
    "start": 372,
    "duration": 1,
    "text": "施崇棠認為"
  },
  {
    "sequence": 122,
    "start": 373,
    "duration": 3,
    "text": "臺灣擁有供應鏈完整與系統整合等優勢"
  },
  {
    "sequence": 123,
    "start": 376,
    "duration": 3,
    "text": "可建立一個可信賴可落地的國家AI品牌"
  },
  {
    "sequence": 124,
    "start": 379,
    "duration": 3,
    "text": "因為主權AI就是各國或各單位"
  },
  {
    "sequence": 125,
    "start": 382,
    "duration": 2,
    "text": "獨立建立的人工智慧"
  },
  {
    "sequence": 126,
    "start": 384,
    "duration": 4,
    "text": "並使用國民的資料國家語言訓練大型語言模型"
  },
  {
    "sequence": 127,
    "start": 388,
    "duration": 3,
    "text": "符合國家價值觀也保護資訊安全"
  },
  {
    "sequence": 128,
    "start": 391,
    "duration": 2,
    "text": "資料量好像就是到一個瓶頸上不去"
  },
  {
    "sequence": 129,
    "start": 393,
    "duration": 2,
    "text": "大家都努力的投資算力"
  },
  {
    "sequence": 130,
    "start": 395,
    "duration": 4,
    "text": "但是跟國際主流的這些AI的公司來比較之下"
  },
  {
    "sequence": 131,
    "start": 399,
    "duration": 2,
    "text": "其實都還是差蠻多的"
  },
  {
    "sequence": 132,
    "start": 401,
    "duration": 3,
    "text": "那這個對我們發展主權AI來說的話"
  },
  {
    "sequence": 133,
    "start": 404,
    "duration": 1,
    "text": "我們就會更實力"
  },
  {
    "sequence": 134,
    "start": 405,
    "duration": 2,
    "text": "受惠AI商機 財政部公佈"
  },
  {
    "sequence": 135,
    "start": 407,
    "duration": 4,
    "text": "八月出口金額統計達到五百八十四點九億美元"
  },
  {
    "sequence": 136,
    "start": 411,
    "duration": 1,
    "text": "創歷年單月新高"
  },
  {
    "sequence": 137,
    "start": 412,
    "duration": 4,
    "text": "更是史上同一回單月出口表現超越難含"
  },
  {
    "sequence": 138,
    "start": 416,
    "duration": 4,
    "text": "尤其電子及資通訊產品出口就佔比百分之七十四點八"
  },
  {
    "sequence": 139,
    "start": 420,
    "duration": 4,
    "text": "出口金額也較去年同期增加一百四十八點六億美元"
  },
  {
    "sequence": 140,
    "start": 424,
    "duration": 1,
    "text": "增幅三成"
  },
  {
    "sequence": 141,
    "start": 425,
    "duration": 5,
    "text": "不過傳產業包含塑橡膠 基本金屬 礦產品出口都出現衰退"
  },
  {
    "sequence": 142,
    "start": 430,
    "duration": 2,
    "text": "不排除受美國關稅影響"
  },
  {
    "sequence": 143,
    "start": 432,
    "duration": 15,
    "text": "公視循環一天 吳嘉寶 郭婕霖 台北報導"
  },
  {
    "sequence": 144,
    "start": 447,
    "duration": 6,
    "text": "民眾黨前主席柯文哲 週一才剛以七千萬元交保"
  },
  {
    "sequence": 145,
    "start": 453,
    "duration": 3,
    "text": "但是台北地檢署不服"
  },
  {
    "sequence": 146,
    "start": 456,
    "duration": 5,
    "text": "認為金華成案還有重要證人尚未調查完畢"
  },
  {
    "sequence": 147,
    "start": 461,
    "duration": 6,
    "text": "所以在昨天晨晚已經提起抗告"
  },
  {
    "sequence": 148,
    "start": 467,
    "duration": 2,
    "text": "交保後隔天再度重回法院"
  },
  {
    "sequence": 149,
    "start": 469,
    "duration": 7,
    "text": "前民眾黨主席柯文哲被起訴的金華成等案上午開庭審理"
  },
  {
    "sequence": 150,
    "start": 476,
    "duration": 2,
    "text": "九號的開庭終點同樣是結問證人"
  },
  {
    "sequence": 151,
    "start": 478,
    "duration": 5,
    "text": "到庭作證的前北市都委會委員許國成在偵查中曾說"
  },
  {
    "sequence": 152,
    "start": 483,
    "duration": 3,
    "text": "大會通過的決議擔任主席的彭政生"
  },
  {
    "sequence": 153,
    "start": 486,
    "duration": 3,
    "text": "可以近自決定委員指示背書"
  },
  {
    "sequence": 154,
    "start": 489,
    "duration": 3,
    "text": "這次出庭說明 某種程度上是主席決定"
  },
  {
    "sequence": 155,
    "start": 492,
    "duration": 4,
    "text": "但當時有問大家有無意見沒人表示反對"
  },
  {
    "sequence": 156,
    "start": 496,
    "duration": 3,
    "text": "而柯文哲僅簡短表示對於證人說的"
  },
  {
    "sequence": 157,
    "start": 499,
    "duration": 5,
    "text": "如果重來一次不要再當都委會委員讓他感觸很深"
  },
  {
    "sequence": 158,
    "start": 520,
    "duration": 2,
    "text": "到目前為止不知道"
  },
  {
    "sequence": 159,
    "start": 522,
    "duration": 3,
    "text": "柯文哲八號交保後質疑檢方偵辦根本查無不法"
  },
  {
    "sequence": 160,
    "start": 525,
    "duration": 3,
    "text": "讓北檢發聲明譴責混淆視聽"
  },
  {
    "sequence": 161,
    "start": 528,
    "duration": 1,
    "text": "也將盡速抗告"
  },
  {
    "sequence": 162,
    "start": 529,
    "duration": 3,
    "text": "再被民眾黨批評檢方睜眼說瞎話"
  },
  {
    "sequence": 163,
    "start": 532,
    "duration": 3,
    "text": "但柯文哲不只重話批檢察官"
  },
  {
    "sequence": 164,
    "start": 535,
    "duration": 2,
    "text": "更把砲口對準總統賴清德"
  },
  {
    "sequence": 165,
    "start": 537,
    "duration": 3,
    "text": "總統怎麼看柯文哲說你讓台灣四分五裂"
  },
  {
    "sequence": 166,
    "start": 540,
    "duration": 2,
    "text": "賴清德被點名讓台灣四分五裂"
  },
  {
    "sequence": 167,
    "start": 542,
    "duration": 3,
    "text": "總統府重申不評論司法個案"
  },
  {
    "sequence": 168,
    "start": 545,
    "duration": 2,
    "text": "但也不接受不是事實的抹黑"
  },
  {
    "sequence": 169,
    "start": 547,
    "duration": 3,
    "text": "用攻擊元首或者是污衊司法的方法"
  },
  {
    "sequence": 170,
    "start": 550,
    "duration": 2,
    "text": "無助於釐清事實"
  },
  {
    "sequence": 171,
    "start": 552,
    "duration": 2,
    "text": "任何人只要涉犯了法律"
  },
  {
    "sequence": 172,
    "start": 554,
    "duration": 3,
    "text": "不論黨派 不論何人 不論身份"
  },
  {
    "sequence": 173,
    "start": 557,
    "duration": 4,
    "text": "我們都支持檢調要依法來釐清事實"
  },
  {
    "sequence": 174,
    "start": 561,
    "duration": 2,
    "text": "也能夠依法就辦"
  },
  {
    "sequence": 175,
    "start": 563,
    "duration": 2,
    "text": "柯文哲被控的精華城與政治陷阱案"
  },
  {
    "sequence": 176,
    "start": 565,
    "duration": 2,
    "text": "週四將再次開提"
  },
  {
    "sequence": 177,
    "start": 567,
    "duration": 3,
    "text": "民眾黨秘書長周宇修等人都將倒挺作證"
  },
  {
    "sequence": 178,
    "start": 570,
    "duration": 2,
    "text": "全案未完待續"
  },
  {
    "sequence": 179,
    "start": 572,
    "duration": 2,
    "text": "公視新聞 台北報導"
  },
  {
    "sequence": 180,
    "start": 575,
    "duration": 3,
    "text": "運動部昨天正式揭牌"
  },
  {
    "sequence": 181,
    "start": 578,
    "duration": 4,
    "text": "最年輕的部長李楊走馬上任"
  },
  {
    "sequence": 182,
    "start": 582,
    "duration": 2,
    "text": "總統賴清德"
  },
  {
    "sequence": 183,
    "start": 584,
    "duration": 4,
    "text": "行政府長卓榮泰都到場"
  },
  {
    "sequence": 184,
    "start": 588,
    "duration": 2,
    "text": "而李楊強調"
  },
  {
    "sequence": 185,
    "start": 590,
    "duration": 3,
    "text": "深知肩負重大責任"
  },
  {
    "sequence": 186,
    "start": 593,
    "duration": 4,
    "text": "他也提出運動部未來工作六大面向"
  },
  {
    "sequence": 187,
    "start": 597,
    "duration": 4,
    "text": "希望全民可以一起來參與運動"
  },
  {
    "sequence": 188,
    "start": 604,
    "duration": 3,
    "text": "特任李楊為運動部部長"
  },
  {
    "sequence": 189,
    "start": 607,
    "duration": 4,
    "text": "請院長頒授任命令"
  },
  {
    "sequence": 190,
    "start": 611,
    "duration": 2,
    "text": "從行政府長卓榮泰手中"
  },
  {
    "sequence": 191,
    "start": 613,
    "duration": 3,
    "text": "接下運動部長的任命令和硬信"
  },
  {
    "sequence": 192,
    "start": 616,
    "duration": 2,
    "text": "兩屆奧運羽球男雙金牌"
  },
  {
    "sequence": 193,
    "start": 618,
    "duration": 2,
    "text": "30歲的李楊正式走馬上任"
  },
  {
    "sequence": 194,
    "start": 620,
    "duration": 4,
    "text": "身為一位運動員 我熱愛挑戰"
  },
  {
    "sequence": 195,
    "start": 624,
    "duration": 3,
    "text": "也喜歡和團隊一起贏得勝利"
  },
  {
    "sequence": 196,
    "start": 627,
    "duration": 2,
    "text": "接下來的每一步"
  },
  {
    "sequence": 197,
    "start": 629,
    "duration": 2,
    "text": "我都會秉持運動精神"
  },
  {
    "sequence": 198,
    "start": 631,
    "duration": 3,
    "text": "用行動和大家一起打造"
  },
  {
    "sequence": 199,
    "start": 634,
    "duration": 3,
    "text": "台灣運動新的里程碑"
  },
  {
    "sequence": 200,
    "start": 637,
    "duration": 2,
    "text": "特別能體會運動員新生"
  },
  {
    "sequence": 201,
    "start": 639,
    "duration": 3,
    "text": "也清楚台灣運動發展各項挑戰"
  },
  {
    "sequence": 202,
    "start": 642,
    "duration": 2,
    "text": "李楊強調未來運動部"
  },
  {
    "sequence": 203,
    "start": 644,
    "duration": 1,
    "text": "工作的六個面向"
  },
  {
    "sequence": 204,
    "start": 645,
    "duration": 2,
    "text": "總統賴清德致詞強調"
  },
  {
    "sequence": 205,
    "start": 647,
    "duration": 1,
    "text": "李楊已做好準備"
  },
  {
    "sequence": 206,
    "start": 648,
    "duration": 2,
    "text": "行政府長卓榮泰期許李楊"
  },
  {
    "sequence": 207,
    "start": 650,
    "duration": 3,
    "text": "是擦亮金字招牌的部長"
  },
  {
    "sequence": 208,
    "start": 653,
    "duration": 4,
    "text": "我本人還有卓院長率領的行政團隊"
  },
  {
    "sequence": 209,
    "start": 657,
    "duration": 3,
    "text": "一定鼎力支持李楊部長"
  },
  {
    "sequence": 210,
    "start": 660,
    "duration": 2,
    "text": "萬事起頭難"
  },
  {
    "sequence": 211,
    "start": 662,
    "duration": 5,
    "text": "再難都沒有得奧運金牌這麼難"
  },
  {
    "sequence": 212,
    "start": 667,
    "duration": 7,
    "text": "而且他還可以得兩次"
  },
  {
    "sequence": 213,
    "start": 674,
    "duration": 2,
    "text": "事實上李楊從步入會場前"
  },
  {
    "sequence": 214,
    "start": 676,
    "duration": 1,
    "text": "就略顯緊張"
  },
  {
    "sequence": 215,
    "start": 677,
    "duration": 2,
    "text": "但只要遇到有人向他致意"
  },
  {
    "sequence": 216,
    "start": 679,
    "duration": 2,
    "text": "皆以笑臉鞠躬回應"
  },
  {
    "sequence": 217,
    "start": 681,
    "duration": 2,
    "text": "連訪時的狀態輕鬆許多"
  },
  {
    "sequence": 218,
    "start": 683,
    "duration": 1,
    "text": "再次強調"
  },
  {
    "sequence": 219,
    "start": 684,
    "duration": 3,
    "text": "最先要做的就是落實全民運動"
  },
  {
    "sequence": 220,
    "start": 687,
    "duration": 3,
    "text": "我真的非常希望說全民真的"
  },
  {
    "sequence": 221,
    "start": 690,
    "duration": 1,
    "text": "有運動的習慣這件事情"
  },
  {
    "sequence": 222,
    "start": 691,
    "duration": 2,
    "text": "我覺得像我自己就很喜歡打籃球"
  },
  {
    "sequence": 223,
    "start": 693,
    "duration": 2,
    "text": "很喜歡打桌球"
  },
  {
    "sequence": 224,
    "start": 695,
    "duration": 1,
    "text": "那我覺得包含我自己"
  },
  {
    "sequence": 225,
    "start": 696,
    "duration": 2,
    "text": "不只是只有羽球有趣而已"
  },
  {
    "sequence": 226,
    "start": 698,
    "duration": 1,
    "text": "我覺得每一項運動"
  },
  {
    "sequence": 227,
    "start": 699,
    "duration": 2,
    "text": "都有它有趣的地方"
  },
  {
    "sequence": 228,
    "start": 701,
    "duration": 2,
    "text": "會擠出時間運動以身作則"
  },
  {
    "sequence": 229,
    "start": 703,
    "duration": 3,
    "text": "而自己從國小到高中都是體育班"
  },
  {
    "sequence": 230,
    "start": 706,
    "duration": 1,
    "text": "會和教育部討論"
  },
  {
    "sequence": 231,
    "start": 707,
    "duration": 2,
    "text": "如何完善體育班制度"
  },
  {
    "sequence": 232,
    "start": 709,
    "duration": 3,
    "text": "畢竟我當時在參加體育班的時候"
  },
  {
    "sequence": 233,
    "start": 712,
    "duration": 3,
    "text": "確實有遇到相當類似的案例"
  },
  {
    "sequence": 234,
    "start": 715,
    "duration": 3,
    "text": "但我覺得我們未來會再跟"
  },
  {
    "sequence": 235,
    "start": 718,
    "duration": 2,
    "text": "教育部這邊好好去進行溝通"
  },
  {
    "sequence": 236,
    "start": 720,
    "duration": 1,
    "text": "運動部正式揭牌"
  },
  {
    "sequence": 237,
    "start": 721,
    "duration": 3,
    "text": "明年度編列預算達到248億元"
  },
  {
    "sequence": 238,
    "start": 724,
    "duration": 2,
    "text": "李洋說每一分錢都是納稅人的錢"
  },
  {
    "sequence": 239,
    "start": 726,
    "duration": 3,
    "text": "一定要用在刀口上會特別把關"
  },
  {
    "sequence": 240,
    "start": 729,
    "duration": 1,
    "text": "至於要到立院備詢"
  },
  {
    "sequence": 241,
    "start": 730,
    "duration": 2,
    "text": "笑著說自己也沒經驗"
  },
  {
    "sequence": 242,
    "start": 732,
    "duration": 2,
    "text": "會和次長們請教"
  },
  {
    "sequence": 243,
    "start": 734,
    "duration": 1,
    "text": "公視新聞李小慧 沈志明"
  },
  {
    "sequence": 244,
    "start": 735,
    "duration": 2,
    "text": "SNG台北報導"
  },
  {
    "sequence": 245,
    "start": 737,
    "duration": 3,
    "text": "教師節就快到了"
  },
  {
    "sequence": 246,
    "start": 740,
    "duration": 2,
    "text": "教育部將首度發放"
  },
  {
    "sequence": 247,
    "start": 742,
    "duration": 3,
    "text": "進師禮券1000元"
  },
  {
    "sequence": 248,
    "start": 745,
    "duration": 3,
    "text": "教育部鎖匣高中以下的"
  },
  {
    "sequence": 249,
    "start": 748,
    "duration": 2,
    "text": "公司立專任教師"
  },
  {
    "sequence": 250,
    "start": 750,
    "duration": 3,
    "text": "代理教師都使用"
  },
  {
    "sequence": 251,
    "start": 753,
    "duration": 2,
    "text": "相較去年"
  },
  {
    "sequence": 252,
    "start": 755,
    "duration": 4,
    "text": "今年各縣市的進師禮幾乎都增加"
  },
  {
    "sequence": 253,
    "start": 759,
    "duration": 2,
    "text": "比如嘉義縣市"
  },
  {
    "sequence": 254,
    "start": 761,
    "duration": 2,
    "text": "去年是送賀卡一張"
  },
  {
    "sequence": 255,
    "start": 763,
    "duration": 4,
    "text": "今年則是600元的禮券"
  },
  {
    "sequence": 256,
    "start": 770,
    "duration": 2,
    "text": "配合進師活動"
  },
  {
    "sequence": 257,
    "start": 772,
    "duration": 3,
    "text": "激勵教師士氣及提升教師工作績效"
  },
  {
    "sequence": 258,
    "start": 775,
    "duration": 1,
    "text": "教育部長曾一耀8號"
  },
  {
    "sequence": 259,
    "start": 776,
    "duration": 2,
    "text": "在教育部內部會議拍板定案"
  },
  {
    "sequence": 260,
    "start": 778,
    "duration": 2,
    "text": "比照公務人員激勵辦法"
  },
  {
    "sequence": 261,
    "start": 780,
    "duration": 2,
    "text": "發放1000元教師禮券"
  },
  {
    "sequence": 262,
    "start": 782,
    "duration": 2,
    "text": "教育部鎖匣高中以下"
  },
  {
    "sequence": 263,
    "start": 784,
    "duration": 2,
    "text": "學校公司立專任教師代理教師"
  },
  {
    "sequence": 264,
    "start": 786,
    "duration": 3,
    "text": "適用 預估2400萬經費"
  },
  {
    "sequence": 265,
    "start": 789,
    "duration": 2,
    "text": "2.4萬名老師受惠"
  },
  {
    "sequence": 266,
    "start": 801,
    "duration": 4,
    "text": "教育部首次針對轄下學校"
  },
  {
    "sequence": 267,
    "start": 805,
    "duration": 3,
    "text": "發放進師禮全教總予以肯定"
  },
  {
    "sequence": 268,
    "start": 808,
    "duration": 3,
    "text": "但也提醒法務部管轄的矯正學校"
  },
  {
    "sequence": 269,
    "start": 811,
    "duration": 2,
    "text": "以及國防部轄下的中正育校"
  },
  {
    "sequence": 270,
    "start": 813,
    "duration": 2,
    "text": "不能被忽略"
  },
  {
    "sequence": 271,
    "start": 815,
    "duration": 11,
    "text": "而今年各縣市的進師禮"
  },
  {
    "sequence": 272,
    "start": 826,
    "duration": 2,
    "text": "六都禮 臺北市和新北市"
  },
  {
    "sequence": 273,
    "start": 828,
    "duration": 3,
    "text": "維持去年的2000元和1000元禮券"
  },
  {
    "sequence": 274,
    "start": 831,
    "duration": 2,
    "text": "桃園 臺中和高雄"
  },
  {
    "sequence": 275,
    "start": 833,
    "duration": 2,
    "text": "從600條到1000元禮券"
  },
  {
    "sequence": 276,
    "start": 835,
    "duration": 3,
    "text": "臺南市從330條到600元禮券"
  },
  {
    "sequence": 277,
    "start": 838,
    "duration": 2,
    "text": "其他縣市 宜蘭縣去年200元"
  },
  {
    "sequence": 278,
    "start": 840,
    "duration": 2,
    "text": "今年600元禮券"
  },
  {
    "sequence": 279,
    "start": 842,
    "duration": 2,
    "text": "嘉義縣市去年是進師卡"
  },
  {
    "sequence": 280,
    "start": 844,
    "duration": 2,
    "text": "今年是禮券600元"
  },
  {
    "sequence": 281,
    "start": 846,
    "duration": 1,
    "text": "幾乎都加碼"
  },
  {
    "sequence": 282,
    "start": 847,
    "duration": 2,
    "text": "但有基層教師說"
  },
  {
    "sequence": 283,
    "start": 849,
    "duration": 2,
    "text": "更希望教育部和地方政府"
  },
  {
    "sequence": 284,
    "start": 851,
    "duration": 2,
    "text": "解決目前面臨的困境"
