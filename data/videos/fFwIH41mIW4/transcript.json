    "start": 1281.1,
    "duration": 1.9600000000000364,
    "text": "日本便利商店門口報紙頭版",
    "hasSignLanguage": false
  },
  {
    "start": 1283.06,
    "duration": 2.5,
    "text": "青衣色都是自民黨魁選舉的消息",
    "hasSignLanguage": false
  },
  {
    "start": 1285.56,
    "duration": 2.1000000000001364,
    "text": "前經濟安保大臣高市早苗",
    "hasSignLanguage": false
  },
  {
    "start": 1287.66,
    "duration": 2.480000000000018,
    "text": "當選有望成為日本第一位女首相",
    "hasSignLanguage": false
  },
  {
    "start": 1290.14,
    "duration": 1.8799999999998818,
    "text": "接下來的發展備受關注",
