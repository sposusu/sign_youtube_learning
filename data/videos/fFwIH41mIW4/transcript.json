  },
  {
    "start": 1294.22,
    "duration": 2.3599999999999,
    "text": "就寫著高市早苗當選新任黨魁",
    "hasSignLanguage": false
  },
  {
    "start": 1296.58,
    "duration": 0.9200000000000728,
    "text": "但裡頭也提及",
