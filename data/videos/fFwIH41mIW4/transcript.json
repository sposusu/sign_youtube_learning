  },
  {
    "start": 1360.78,
    "duration": 2.6800000000000637,
    "text": "的一個合作公開的部分的話",
    "hasSignLanguage": false
  },
  {
    "start": 1363.46,
    "duration": 4.1599999999998545,
    "text": "可能就不見得會像之前高市早苗",
    "hasSignLanguage": false
  },
  {
    "start": 1367.62,
    "duration": 2.040000000000191,
    "text": "對臺灣表現的那麼友好",
    "hasSignLanguage": false
  },
  {
    "start": 1369.66,
    "duration": 1.8399999999999181,
    "text": "向來對臺友好的高市早苗",
    "hasSignLanguage": false
  },
  {
    "start": 1371.5,
    "duration": 1.3199999999999363,
    "text": "若順利成為首相",
    "hasSignLanguage": false
  },
  {
    "start": 1372.82,
    "duration": 1.8800000000001091,
    "text": "雖然難以和臺灣直接互動",
    "hasSignLanguage": false
  },
  {
    "start": 1374.7,
    "duration": 3.119999999999891,
    "text": "但從政策路線和黨內人士就不難看出",
    "hasSignLanguage": false
  },
  {
    "start": 1377.82,
    "duration": 2.240000000000009,
    "text": "台日關係有望更加堅定",
