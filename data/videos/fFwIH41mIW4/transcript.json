  },
  {
    "start": 1064.26,
    "duration": 1.9600000000000364,
    "text": "民眾擔心引發山林火警",
    "hasSignLanguage": false
  },
  {
    "start": 1066.22,
    "duration": 1.6399999999998727,
    "text": "太魯閣國家公園管理處",
