  },
  {
    "start": 1297.5,
    "duration": 1,
    "text": "接下來在內政",
    "hasSignLanguage": false
  },
  {
    "start": 1298.5,
    "duration": 2.380000000000109,
    "text": "還有外交上將面臨不少挑戰",
    "hasSignLanguage": false
  },
  {
    "start": 1300.88,
    "duration": 2.5799999999999272,
    "text": "內政上包括在少數執政的情況下",
