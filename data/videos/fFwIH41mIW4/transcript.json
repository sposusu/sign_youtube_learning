  },
  {
    "start": 1292.02,
    "duration": 0.8800000000001091,
    "text": "攤開日本報紙",
    "hasSignLanguage": false
  },
  {
    "start": 1292.9,
    "duration": 1.3199999999999363,
    "text": "在頭版上斗大的標題",
