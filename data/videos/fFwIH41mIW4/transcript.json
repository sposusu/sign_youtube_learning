  },
  {
    "start": 1330.88,
    "duration": 10.539999999999964,
    "text": "高市早苗",
    "hasSignLanguage": false
  },
  {
    "start": 1341.42,
    "duration": 2.0799999999999272,
    "text": "被認為繼承前首相安倍晉三",
    "hasSignLanguage": false
  },
  {
    "start": 1343.5,
    "duration": 3.160000000000082,
    "text": "重視美日同盟對中國強硬的路線",
    "hasSignLanguage": false
  },
  {
    "start": 1346.66,
    "duration": 1.240000000000009,
    "text": "現在傳出他考慮",
    "hasSignLanguage": false
  },
  {
    "start": 1347.9,
    "duration": 3.0399999999999636,
    "text": "讓與安倍友好的最高顧問麻生泰郎",
    "hasSignLanguage": false
  },
  {
    "start": 1350.94,
    "duration": 1.240000000000009,
    "text": "擔任副黨魁",
    "hasSignLanguage": false
  },
  {
    "start": 1352.18,
    "duration": 3.0399999999999636,
    "text": "有些政策就是只能夠做",
