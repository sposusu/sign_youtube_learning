  },
  {
    "start": 1303.46,
    "duration": 1.4400000000000546,
    "text": "如何與在野黨合作",
    "hasSignLanguage": false
  },
  {
    "start": 1304.9,
    "duration": 2.3599999999999,
    "text": "以及物價上漲的因應對策",
    "hasSignLanguage": false
  },
  {
    "start": 1307.26,
    "duration": 2.7200000000000273,
    "text": "外交上首要關注的就是美日關係",
    "hasSignLanguage": false
  },
  {
    "start": 1309.98,
    "duration": 1.2799999999999727,
    "text": "尤其日媒報導",
    "hasSignLanguage": false
  },
  {
    "start": 1311.26,
    "duration": 3.0799999999999272,
    "text": "美國總統川普可能在10月27號訪問日本",
