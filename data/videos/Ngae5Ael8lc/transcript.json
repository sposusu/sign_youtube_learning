  {
    "sequence": 418,
    "start": 1281.88,
    "duration": 0.959999999999809,
    "text": "公視新聞"
  },
  {
    "sequence": 419,
    "start": 1282.84,
    "duration": 0.9600000000000364,
    "text": "黃遠林編譯"
  },
  {
    "sequence": 420,
    "start": 1283.8,
    "duration": 2.6000000000001364,
    "text": "關心天氣"
  },
  {
    "sequence": 421,
    "start": 1286.4,
    "duration": 2.7999999999999545,
    "text": "今天熱對流發展依舊旺盛"
  },
  {
    "sequence": 422,
    "start": 1289.2,
    "duration": 4,
    "text": "桃園以南的地區出現午後雷雨機會高"
  },
  {
    "sequence": 423,
    "start": 1294,
    "duration": 3.839999999999918,
    "text": "會有時雨量超過40毫米的短延時大雨"
  },
  {
    "sequence": 424,
    "start": 1297.84,
    "duration": 5.160000000000082,
    "text": "來解決就提供您各地的氣象資料"
  },
  {
    "sequence": 425,
    "start": 1324.44,
    "duration": 3,
    "text": "感謝您收看這一節的公視手語新聞"
