[
  {
    "sequence": 1,
    "start": 0,
    "duration": 11.84,
    "text": "[音樂]"
  },
  {
    "sequence": 2,
    "start": 11.84,
    "duration": 2.92,
    "text": "看新聞 開視野"
  },
  {
    "sequence": 3,
    "start": 14.76,
    "duration": 4.5600000000000005,
    "text": "歡迎收看今天8月27號的公視手語新聞"
  },
  {
    "sequence": 4,
    "start": 19.32,
    "duration": 3.16,
    "text": "首先來關心"
  },
  {
    "sequence": 5,
    "start": 22.48,
    "duration": 2.719999999999999,
    "text": "丹娜斯颱風過後"
  },
  {
    "sequence": 6,
    "start": 25.2,
    "duration": 2.6400000000000006,
    "text": "傳染病風險上升"
  },
  {
    "sequence": 7,
    "start": 29.12,
    "duration": 1.1600000000000001,
    "text": "疾管署公布"
  },
  {
    "sequence": 8,
    "start": 30.28,
    "duration": 3.5600000000000023,
    "text": "新增9例類鼻居本土病例"
  },
  {
    "sequence": 9,
    "start": 33.84,
    "duration": 3,
    "text": "而其中1例死亡"
  },
  {
    "sequence": 10,
    "start": 36.84,
    "duration": 3.8399999999999963,
    "text": "從發病到過世僅僅10天"
  },
  {
    "sequence": 11,
    "start": 40.68,
    "duration": 5.68,
    "text": "另外高端螺旋體病新增6例"
  },
  {
    "sequence": 12,
    "start": 46.36,
    "duration": 3.1199999999999974,
    "text": "登革熱則是新增4例"
  },
  {
    "sequence": 13,
    "start": 49.48,
    "duration": 3.8000000000000043,
    "text": "也是今年第一起本土社區群聚事件"
  },
  {
    "sequence": 14,
    "start": 53.28,
    "duration": 2.719999999999999,
    "text": "丹娜斯颱風過後"
  },
  {
    "sequence": 15,
    "start": 56,
    "duration": 1.6799999999999997,
    "text": "類鼻居個案再添一死"
  },
  {
    "sequence": 16,
    "start": 57.88,
    "duration": 3.479999999999997,
    "text": "疾管署公布上週新增9例類鼻居本土病例"
  },
  {
    "sequence": 17,
    "start": 61.36,
    "duration": 1.1600000000000037,
    "text": "其中1例死亡"
  },
  {
    "sequence": 18,
    "start": 62.52,
    "duration": 2.079999999999991,
    "text": "個案為南部50多歲男性"
  },
  {
    "sequence": 19,
    "start": 64.6,
    "duration": 1.8400000000000034,
    "text": "本身有多重慢性病史"
  },
  {
    "sequence": 20,
    "start": 66.44,
    "duration": 3.519999999999996,
    "text": "8月中旬出現咳嗽流鼻水腹瀉等症狀"
  },
  {
    "sequence": 21,
    "start": 69.96,
    "duration": 1.6400000000000006,
    "text": "三度就醫到急診時"
  },
  {
    "sequence": 22,
    "start": 71.6,
    "duration": 2,
    "text": "已經肺炎合併呼吸衰竭"
  },
  {
    "sequence": 23,
    "start": 73.6,
    "duration": 2.5200000000000102,
    "text": "經過搶救隔天仍不幸過世"
  },
  {
    "sequence": 24,
    "start": 76.12,
    "duration": 2.4399999999999977,
    "text": "從發病到死亡只有10天"
  },
  {
    "sequence": 25,
    "start": 78.56,
    "duration": 1.1599999999999966,
    "text": "做疫調的時候"
  },
  {
    "sequence": 26,
    "start": 79.72,
    "duration": 1.519999999999996,
    "text": "是有發現說這個個案"
  },
  {
    "sequence": 27,
    "start": 81.24,
    "duration": 1.5600000000000023,
    "text": "他其實腳部有傷口"
  },
  {
    "sequence": 28,
    "start": 82.8,
    "duration": 4.159999999999997,
    "text": "那不過他在這個颱風期間是沒有出門的"
  },
  {
    "sequence": 29,
    "start": 86.96,
    "duration": 2.5600000000000023,
    "text": "而且這個他家的這個附近"
  },
  {
    "sequence": 30,
    "start": 89.52,
    "duration": 1.2800000000000011,
    "text": "其實也沒有發生水患"
  },
  {
    "sequence": 31,
    "start": 90.8,
    "duration": 2.680000000000007,
    "text": "不過他個人他到底有沒有接觸到污水污泥"
  },
  {
    "sequence": 32,
    "start": 93.48,
    "duration": 1.2800000000000011,
    "text": "是沒有辦法確認"
  },
  {
    "sequence": 33,
    "start": 94.76,
    "duration": 1.6799999999999926,
    "text": "另外勾端螺旋體病"
  },
  {
    "sequence": 34,
    "start": 96.44,
    "duration": 1.960000000000008,
    "text": "上週新增6例本土病例"
  },
  {
    "sequence": 35,
    "start": 98.4,
    "duration": 2.519999999999996,
    "text": "年齡介於20多歲到70多歲"
  },
  {
    "sequence": 36,
    "start": 100.92,
    "duration": 3.799999999999997,
    "text": "個案大多因為發燒肌肉痛或腹瀉症狀就醫"
  },
  {
    "sequence": 37,
    "start": 104.72,
    "duration": 4.040000000000006,
    "text": "登革熱則是出現今年首起本土社區群聚事件"
  },
  {
    "sequence": 38,
    "start": 108.76,
    "duration": 2.6400000000000006,
    "text": "除了指標個案同住家人和鄰居"
  },
  {
    "sequence": 39,
    "start": 111.4,
    "duration": 2.6400000000000006,
    "text": "都是衛生單位主動擴大採檢時"
  },
  {
    "sequence": 40,
    "start": 114.04,
    "duration": 1.4399999999999977,
    "text": "才驗出確定病例"
  },
  {
    "sequence": 41,
    "start": 115.72,
    "duration": 2.480000000000004,
    "text": "次人都是感染登革病毒第二行"
  },
  {
    "sequence": 42,
    "start": 118.2,
    "duration": 3.280000000000001,
    "text": "衛生單位那有針對這些確診個案的"
  },
  {
    "sequence": 43,
    "start": 121.48,
    "duration": 2.1199999999999903,
    "text": "一個居住地以及他的工作地"
  },
  {
    "sequence": 44,
    "start": 123.6,
    "duration": 1.0400000000000063,
    "text": "來做一些"
  },
  {
    "sequence": 45,
    "start": 124.64,
    "duration": 2.1200000000000045,
    "text": "資深園的一些查核"
  },
  {
    "sequence": 46,
    "start": 126.76,
    "duration": 3.1199999999999903,
    "text": "那也做也做了一些相關的一些防治"
  },
  {
    "sequence": 47,
    "start": 129.88,
    "duration": 1.759999999999991,
    "text": "的一個工作機關署提醒"
  },
  {
    "sequence": 48,
    "start": 131.64,
    "duration": 2.440000000000026,
    "text": "不論是類比居勾端螺旋體病"
  },
  {
    "sequence": 49,
    "start": 134.08,
    "duration": 1.9599999999999795,
    "text": "或是登革熱都是環境病"
  },
  {
    "sequence": 50,
    "start": 136.04,
    "duration": 2.8000000000000114,
    "text": "尤其目前正是登革熱流行季節"
  },
  {
    "sequence": 51,
    "start": 138.84,
    "duration": 3.079999999999984,
    "text": "加上近期天氣高溫常有午後降雨"
  },
  {
    "sequence": 52,
    "start": 141.92,
    "duration": 2.960000000000008,
    "text": "有利於病媒文字聲傳播風險增加"
  },
  {
    "sequence": 53,
    "start": 145.08,
    "duration": 2.6399999999999864,
    "text": "呼籲民眾要主動清除積水容器"
  },
  {
    "sequence": 54,
    "start": 147.72,
    "duration": 3.1200000000000045,
    "text": "落實循道清刷才能徹底阻斷"
  },
  {
    "sequence": 55,
    "start": 150.84,
    "duration": 1.4399999999999977,
    "text": "登革熱的傳播途徑"
  },
  {
    "sequence": 56,
    "start": 152.28,
    "duration": 0.7599999999999909,
    "text": "公視新聞"
  },
  {
    "sequence": 57,
    "start": 153.04,
    "duration": 5.480000000000018,
    "text": "今天凌晨兩點多"
  },
  {
    "sequence": 58,
    "start": 158.52,
    "duration": 3.4799999999999898,
    "text": "新北板橋一處公寓民宅的二樓"
  },
  {
    "sequence": 59,
    "start": 162,
    "duration": 1.759999999999991,
    "text": "突然傳出了火警"
  },
  {
    "sequence": 60,
    "start": 163.76,
    "duration": 2.480000000000018,
    "text": "屋主下樓求救"
  },
  {
    "sequence": 61,
    "start": 166.24,
    "duration": 4,
    "text": "表示自己的老婆跟三個孩子都還在"
  },
  {
    "sequence": 62,
    "start": 170.24,
    "duration": 0.8799999999999955,
    "text": "房間裡頭"
  },
  {
    "sequence": 63,
    "start": 172.24,
    "duration": 3.1999999999999886,
    "text": "所幸消防員迅速趕到控制火勢"
  },
  {
    "sequence": 64,
    "start": 175.44,
    "duration": 3.1200000000000045,
    "text": "並且陸續救出了七位民眾"
  },
  {
    "sequence": 65,
    "start": 178.56,
    "duration": 2.5200000000000102,
    "text": "其中兩人一度意識不清"
  },
  {
    "sequence": 66,
    "start": 181.08,
    "duration": 2.559999999999974,
    "text": "送醫後意識逐漸恢復"
  },
  {
    "sequence": 67,
    "start": 183.64,
    "duration": 4.960000000000008,
    "text": "大批消防員出現在狹小上弄"
  },
  {
    "sequence": 68,
    "start": 188.6,
    "duration": 2.4399999999999977,
    "text": "未剛鋪面的火勢鬆了一口氣"
  },
  {
    "sequence": 69,
    "start": 191.04,
    "duration": 2.0400000000000205,
    "text": "二十七日凌晨兩點多"
  },
  {
    "sequence": 70,
    "start": 193.08,
    "duration": 1.9199999999999875,
    "text": "板橋區文化路一段"
  },
  {
    "sequence": 71,
    "start": 195,
    "duration": 2.1599999999999966,
    "text": "移動四層樓公寓二樓突然"
  },
  {
    "sequence": 72,
    "start": 197.16,
    "duration": 0.960000000000008,
    "text": "竄出火苗"
  },
  {
    "sequence": 73,
    "start": 198.12,
    "duration": 2.079999999999984,
    "text": "濃煙瞬間往外四散"
  },
  {
    "sequence": 74,
    "start": 200.6,
    "duration": 2.0800000000000125,
    "text": "消防人員獲報後迅速趕底"
  },
  {
    "sequence": 75,
    "start": 202.68,
    "duration": 2.5999999999999943,
    "text": "短短不到半小時就控制火勢"
  },
  {
    "sequence": 76,
    "start": 205.28,
    "duration": 3.4799999999999898,
    "text": "並且成功救出四男三女共七位民眾"
  },
  {
    "sequence": 77,
    "start": 208.76,
    "duration": 1.200000000000017,
    "text": "有一個屋主"
  },
  {
    "sequence": 78,
    "start": 209.96,
    "duration": 1.9199999999999875,
    "text": "已經下來這邊做求救"
  },
  {
    "sequence": 79,
    "start": 211.88,
    "duration": 1.960000000000008,
    "text": "說他有四名家人"
  },
  {
    "sequence": 80,
    "start": 213.84,
    "duration": 1.4799999999999898,
    "text": "他老婆跟三個孩子"
  },
  {
    "sequence": 81,
    "start": 215.32,
    "duration": 5.1200000000000045,
    "text": "那我們立即部署水線上樓做一個搶救"
  },
  {
    "sequence": 82,
    "start": 220.44,
    "duration": 3.319999999999993,
    "text": "那一方面控制客廳的一個火勢"
  },
  {
    "sequence": 83,
    "start": 223.76,
    "duration": 3.3200000000000216,
    "text": "另外一組人員迅速的到隔壁"
  },
  {
    "sequence": 84,
    "start": 227.08,
    "duration": 2.2399999999999807,
    "text": "的這個核四之內的把"
  },
  {
    "sequence": 85,
    "start": 229.68,
    "duration": 2.5600000000000023,
    "text": "四個一大三小的民眾"
  },
  {
    "sequence": 86,
    "start": 232.24,
    "duration": 3.359999999999985,
    "text": "救出來消防局表示主要燃燒地點"
  },
  {
    "sequence": 87,
    "start": 235.6,
    "duration": 2.640000000000015,
    "text": "位在民宅客廳總燃燒面積大約"
  },
  {
    "sequence": 88,
    "start": 238.24,
    "duration": 1.2800000000000011,
    "text": "二十五平方公尺"
  },
  {
    "sequence": 89,
    "start": 239.52,
    "duration": 1.8400000000000034,
    "text": "救出的七位民眾中"
  },
  {
    "sequence": 90,
    "start": 241.36,
    "duration": 3.319999999999993,
    "text": "八歲及十六歲兩名男性一度意識不清"
  },
  {
    "sequence": 91,
    "start": 244.68,
    "duration": 2.4799999999999898,
    "text": "所幸送醫後意識逐漸恢復"
  },
  {
    "sequence": 92,
    "start": 247.16,
    "duration": 1.960000000000008,
    "text": "其餘五人意識清楚"
  },
  {
    "sequence": 93,
    "start": 249.12,
    "duration": 1.8799999999999955,
    "text": "也預防性送醫治療"
  },
  {
    "sequence": 94,
    "start": 251,
    "duration": 3.8000000000000114,
    "text": "暗夜火警驚魂所幸最終平安落幕"
  },
  {
    "sequence": 95,
    "start": 254.8,
    "duration": 2.8000000000000114,
    "text": "公視新聞之中健康綜合報導"
  },
  {
    "sequence": 96,
    "start": 258.56,
    "duration": 1.9599999999999795,
    "text": "看完報紙重點繼續來關心"
  },
  {
    "sequence": 97,
    "start": 260.52,
    "duration": 2.4399999999999977,
    "text": "核三重啟公投"
  },
  {
    "sequence": 98,
    "start": 262.96,
    "duration": 1.3600000000000136,
    "text": "金門"
  },
  {
    "sequence": 99,
    "start": 264.32,
    "duration": 1.240000000000009,
    "text": "連江"
  },
  {
    "sequence": 100,
    "start": 265.56,
    "duration": 1.7199999999999704,
    "text": "苗栗的統一票"
  },
  {
    "sequence": 101,
    "start": 267.28,
    "duration": 1.2800000000000296,
    "text": "比率最高"
  },
  {
    "sequence": 102,
    "start": 268.56,
    "duration": 3.2799999999999727,
    "text": "就有民眾提案"
  },
  {
    "sequence": 103,
    "start": 271.84,
    "duration": 3.6000000000000227,
    "text": "將核廢料除放在這三個縣市"
  },
  {
    "sequence": 104,
    "start": 275.44,
    "duration": 5.1200000000000045,
    "text": "四天就突破了八千人通過連署"
  },
  {
    "sequence": 105,
    "start": 280.56,
    "duration": 3.160000000000025,
    "text": "金門立委"
  },
  {
    "sequence": 106,
    "start": 283.72,
    "duration": 1.759999999999991,
    "text": "陳玉真則拋出"
  },
  {
    "sequence": 107,
    "start": 286.52,
    "duration": 2.8799999999999955,
    "text": "只要符合三個必須條件"
  },
  {
    "sequence": 108,
    "start": 289.4,
    "duration": 3.6000000000000227,
    "text": "可以將無人居住的二檔島納入評估"
  },
  {
    "sequence": 109,
    "start": 293,
    "duration": 3.240000000000009,
    "text": "八二三核三重啟公投剛落幕"
  },
  {
    "sequence": 110,
    "start": 296.24,
    "duration": 1.1200000000000045,
    "text": "雖然未打門檻"
  },
  {
    "sequence": 111,
    "start": 297.36,
    "duration": 3,
    "text": "但也開出了四百三十四萬多張統一票"
  },
  {
    "sequence": 112,
    "start": 300.36,
    "duration": 2.519999999999982,
    "text": "遠高於不同意的一百五十一萬多"
  },
  {
    "sequence": 113,
    "start": 302.88,
    "duration": 1.1999999999999886,
    "text": "反映部分民意"
  },
  {
    "sequence": 114,
    "start": 304.08,
    "duration": 3.080000000000041,
    "text": "而公投前則有反核人士在公共政策網路"
  },
  {
    "sequence": 115,
    "start": 307.16,
    "duration": 2.67999999999995,
    "text": "參與平臺提案建議將核廢料除放在"
  },
  {
    "sequence": 116,
    "start": 309.84,
    "duration": 3.160000000000025,
    "text": "重啟核三公投贊成比例最高的三個縣市"
  },
  {
    "sequence": 117,
    "start": 313,
    "duration": 2.2799999999999727,
    "text": "短短四天不僅突破富裔門檻"
  },
  {
    "sequence": 118,
    "start": 315.36,
    "duration": 1.6399999999999864,
    "text": "更超過八千人連署"
  },
  {
    "sequence": 119,
    "start": 317,
    "duration": 20.920000000000016,
    "text": "依規定提案成案後"
  },
  {
    "sequence": 120,
    "start": 337.92,
    "duration": 2.839999999999975,
    "text": "權責機關必須在兩個月內說明評估"
  },
  {
    "sequence": 121,
    "start": 340.76,
    "duration": 2.3600000000000136,
    "text": "提案人表示希望藉此呼籲民眾"
  },
  {
    "sequence": 122,
    "start": 343.16,
    "duration": 3.0399999999999636,
    "text": "唯有真正解決核廢核能才會是選項"
  },
  {
    "sequence": 123,
    "start": 346.2,
    "duration": 1.3600000000000136,
    "text": "而根據中選會統計"
  },
  {
    "sequence": 124,
    "start": 347.56,
    "duration": 2.839999999999975,
    "text": "公投結果所有縣市都是同意大於不同意"
  },
  {
    "sequence": 125,
    "start": 350.4,
    "duration": 2.8000000000000114,
    "text": "不過比例最高的縣市依序為金門縣的"
  },
  {
    "sequence": 126,
    "start": 353.2,
    "duration": 1.5200000000000387,
    "text": "百分之九十四點二一"
  },
  {
    "sequence": 127,
    "start": 354.72,
    "duration": 3,
    "text": "連江縣九十四苗栗縣八十六點五六"
  },
  {
    "sequence": 128,
    "start": 357.72,
    "duration": 1.919999999999959,
    "text": "另外統一票數最多的地方"
  },
  {
    "sequence": 129,
    "start": 359.64,
    "duration": 2.3600000000000136,
    "text": "則是新北市有七十七萬多票"
  },
  {
    "sequence": 130,
    "start": 370.4,
    "duration": 2.7600000000000477,
    "text": "不只金門連江縣長王忠銘也表示"
  },
  {
    "sequence": 131,
    "start": 373.16,
    "duration": 2.7999999999999545,
    "text": "提案成案後已經詢問多位媽祖相親"
  },
  {
    "sequence": 132,
    "start": 375.96,
    "duration": 2.6000000000000227,
    "text": "統統不同意將核廢料放在當地"
  },
  {
    "sequence": 133,
    "start": 378.56,
    "duration": 2.8000000000000114,
    "text": "不過金門立委陳玉真則提出可將無人"
  },
  {
    "sequence": 134,
    "start": 381.36,
    "duration": 1.919999999999959,
    "text": "居住的二檔島納入評估"
  },
  {
    "sequence": 135,
    "start": 400.4,
    "duration": 6.800000000000011,
    "text": "胡玉政府核廢選址可從無人"
  },
  {
    "sequence": 136,
    "start": 407.2,
    "duration": 2.1200000000000045,
    "text": "居住地或較遠的地方開始"
  },
  {
    "sequence": 137,
    "start": 409.32,
    "duration": 3.1200000000000045,
    "text": "陳玉真也表示只要符合三大前提條件"
  },
  {
    "sequence": 138,
    "start": 412.44,
    "duration": 2.5600000000000023,
    "text": "包括地質安全明確補償方案"
  },
  {
    "sequence": 139,
    "start": 415,
    "duration": 2.2799999999999727,
    "text": "以及交由居民以公投方式決定"
  },
  {
    "sequence": 140,
    "start": 417.28,
    "duration": 2.2000000000000455,
    "text": "最終也不一定要是二檔島"
  },
  {
    "sequence": 141,
    "start": 419.48,
    "duration": 1.599999999999966,
    "text": "觀眾朋友 綜合報導"
  },
  {
    "sequence": 142,
    "start": 421.08,
    "duration": 4.8799999999999955,
    "text": "美國將要在二十九號全面暫停"
  },
  {
    "sequence": 143,
    "start": 425.96,
    "duration": 3.240000000000009,
    "text": "低價商品的小額貨免關稅優惠"
  },
  {
    "sequence": 144,
    "start": 430.44,
    "duration": 3.8000000000000114,
    "text": "中華郵政就宣佈 即日起停收"
  },
  {
    "sequence": 145,
    "start": 434.24,
    "duration": 2.480000000000018,
    "text": "計發往美國商品類郵件"
  },
  {
    "sequence": 146,
    "start": 436.72,
    "duration": 3.839999999999975,
    "text": "不過文件類還是可以正常寄送"
  },
  {
    "sequence": 147,
    "start": 440.56,
    "duration": 4.9599999999999795,
    "text": "營業窗口也會提供合作的商業快遞"
  },
  {
    "sequence": 148,
    "start": 445.52,
    "duration": 4.560000000000002,
    "text": "代修服務 只是價格當然會比較高"
  },
  {
    "sequence": 149,
    "start": 450.08,
    "duration": 7.199999999999989,
    "text": "郵局營業就陸續有民眾到窗口"
  },
  {
    "sequence": 150,
    "start": 457.28,
    "duration": 1.2000000000000455,
    "text": "交寄郵件與包裹"
  },
  {
    "sequence": 151,
    "start": 458.48,
    "duration": 1.3599999999999568,
    "text": "櫃檯上貼出公告"
  },
  {
    "sequence": 152,
    "start": 460,
    "duration": 2.519999999999982,
    "text": "即日起暫停收計發往美國的商品"
  },
  {
    "sequence": 153,
    "start": 462.52,
    "duration": 2.819999999999993,
    "text": "類郵件 包括國際商品快捷 國際包裹"
  },
  {
    "sequence": 154,
    "start": 465.34,
    "duration": 2.7600000000000477,
    "text": "國際掛號小包等等 不少有家人或朋友"
  },
  {
    "sequence": 155,
    "start": 468.1,
    "duration": 2.099999999999966,
    "text": "在美國的民眾都覺得很突然"
  },
  {
    "sequence": 156,
    "start": 470.2,
    "duration": 18.480000000000018,
    "text": "很多人有持續寄送衣物和食品等需求"
  },
  {
    "sequence": 157,
    "start": 488.88,
    "duration": 2.5600000000000023,
    "text": "現在得該使用商業快遞業者的服務"
  },
  {
    "sequence": 158,
    "start": 491.44,
    "duration": 2.7200000000000273,
    "text": "同樣以一點五公斤的快捷包裹來試算"
  },
  {
    "sequence": 159,
    "start": 494.16,
    "duration": 2.3999999999999773,
    "text": "中華郵政的運費是一千三百一十元"
  },
  {
    "sequence": 160,
    "start": 496.56,
    "duration": 2.160000000000025,
    "text": "DHL是二四九九元"
  },
  {
    "sequence": 161,
    "start": 498.72,
    "duration": 2.67999999999995,
    "text": "另外一家業者的價格更高 為三千九百五十"
  },
  {
    "sequence": 162,
    "start": 501.4,
    "duration": 1.5200000000000387,
    "text": "八元 超過兩倍價格"
  },
  {
    "sequence": 163,
    "start": 502.92,
    "duration": 1.919999999999959,
    "text": "這些報價都不包含關稅"
  },
  {
    "sequence": 164,
    "start": 504.84,
    "duration": 2.7600000000000477,
    "text": "不只個人需求民生物品 透過郵政公司"
  },
  {
    "sequence": 165,
    "start": 507.6,
    "duration": 2.919999999999959,
    "text": "國際包裹寄貨的店家或賣家也都受影響"
  },
  {
    "sequence": 166,
    "start": 519.4,
    "duration": 4.040000000000077,
    "text": "中華郵政解釋 受美國政府"
  },
  {
    "sequence": 167,
    "start": 523.44,
    "duration": 2.7199999999999136,
    "text": "自八月二十九日起將全面暫停低價商品"
  },
  {
    "sequence": 168,
    "start": 526.16,
    "duration": 2.840000000000032,
    "text": "的小額豁免關稅優惠 所有寄往美國"
  },
  {
    "sequence": 169,
    "start": 529,
    "duration": 2.759999999999991,
    "text": "等於獲低於八百美元的進口郵件都要繳納"
  },
  {
    "sequence": 170,
    "start": 531.76,
    "duration": 3.32000000000005,
    "text": "關稅 但目前全球郵政體系都還沒有提供"
  },
  {
    "sequence": 171,
    "start": 535.08,
    "duration": 2.8799999999999955,
    "text": "寄件人預繳關稅服務 會在研議有進一步"
  },
  {
    "sequence": 172,
    "start": 537.96,
    "duration": 2.0799999999999272,
    "text": "結果之後再恢復收件服務"
  },
  {
    "sequence": 173,
    "start": 548.92,
    "duration": 12.040000000000077,
    "text": "中華郵政統計 一百一三年"
  },
  {
    "sequence": 174,
    "start": 560.96,
    "duration": 2.5599999999999454,
    "text": "約有三十四萬件的美國商品類郵件"
  },
  {
    "sequence": 175,
    "start": 563.52,
    "duration": 2.8799999999999955,
    "text": "多為電商產品 或是寄給親朋好友的物品"
  },
  {
    "sequence": 176,
    "start": 566.4,
    "duration": 3.3999999999999773,
    "text": "包裹 而過往國際包裹也並非主要營收來源"
  },
  {
    "sequence": 177,
    "start": 569.8,
    "duration": 2.9600000000000364,
    "text": "未來有需求的民眾仍可透過郵局營業窗口"
  },
  {
    "sequence": 178,
    "start": 572.76,
    "duration": 2.919999999999959,
    "text": "提供的商業快遞代收服務寄送 受美國"
  },
  {
    "sequence": 179,
    "start": 575.68,
    "duration": 2.7200000000000273,
    "text": "新智影響 包含澳洲還有歐洲多國郵政"
  },
  {
    "sequence": 180,
    "start": 578.56,
    "duration": 3.160000000000082,
    "text": "接連宣佈暫停大部分寄往美國的包裹運送"
  },
  {
    "sequence": 181,
    "start": 581.72,
    "duration": 1.8799999999999955,
    "text": "公視新聞宣言間臺報導"
  },
  {
    "sequence": 182,
    "start": 583.6,
    "duration": 4.399999999999977,
    "text": "到醫美診所打鳳凰電波"
  },
  {
    "sequence": 183,
    "start": 588,
    "duration": 2.480000000000018,
    "text": "或是美國音波要小心"
  },
  {
    "sequence": 184,
    "start": 590.48,
    "duration": 6.039999999999964,
    "text": "有犯罪集團涉嫌從中國非法走私"
  },
  {
    "sequence": 185,
    "start": 596.52,
    "duration": 1.2000000000000455,
    "text": "相關的產品"
  },
  {
    "sequence": 186,
    "start": 597.72,
    "duration": 4.67999999999995,
    "text": "他們除了低價賣給二十多家的診所"
  },
  {
    "sequence": 187,
    "start": 602.4,
    "duration": 3.0400000000000773,
    "text": "也會從網路上來找客人"
  },
  {
    "sequence": 188,
    "start": 605.44,
    "duration": 2.7199999999999136,
    "text": "在沒有醫師執照下"
  },
  {
    "sequence": 189,
    "start": 608.64,
    "duration": 1.5600000000000591,
    "text": "約在飯店施打"
  },
  {
    "sequence": 190,
    "start": 610.2,
    "duration": 4.079999999999927,
    "text": "甚至還篡改設計"
  },
  {
    "sequence": 191,
    "start": 614.28,
    "duration": 5.560000000000059,
    "text": "讓一次性的探頭能夠回充無限使用"
  },
  {
    "sequence": 192,
    "start": 619.84,
    "duration": 3.2799999999999727,
    "text": "警方初估"
  },
  {
    "sequence": 193,
    "start": 623.12,
    "duration": 4.480000000000018,
    "text": "侵權的市值高達了十億元"
  },
  {
    "sequence": 194,
    "start": 627.6,
    "duration": 2.840000000000032,
    "text": "逮捕十二人到案"
  },
  {
    "sequence": 195,
    "start": 630.44,
    "duration": 4.559999999999945,
    "text": "好幾批貨物以電腦零件報關從中國輸入"
  },
  {
    "sequence": 196,
    "start": 635,
    "duration": 3.4400000000000546,
    "text": "臺灣 帶海關接獲請資 內容物不單純"
  },
  {
    "sequence": 197,
    "start": 639.2,
    "duration": 4,
    "text": "開一看全是醫美用品用於"
  },
  {
    "sequence": 198,
    "start": 643.2,
    "duration": 1.7999999999999545,
    "text": "鳳凰電波或美國音波"
  },
  {
    "sequence": 199,
    "start": 645,
    "duration": 4,
    "text": "但警方發現業者未獲許可非法走私來臺"
  },
  {
    "sequence": 200,
    "start": 649,
    "duration": 4.279999999999973,
    "text": "自一百一十二年開始從中國大陸非法"
  },
  {
    "sequence": 201,
    "start": 653.28,
    "duration": 2.0400000000000773,
    "text": "進口未經核准的"
  },
  {
    "sequence": 202,
    "start": 655.32,
    "duration": 5.639999999999986,
    "text": "未經核准的醫療器材後租借給多家醫美診所"
  },
  {
    "sequence": 203,
    "start": 660.96,
    "duration": 3.0799999999999272,
    "text": "無論儀器或探頭相關醫美產品在臺"
  },
  {
    "sequence": 204,
    "start": 664.04,
    "duration": 3.32000000000005,
    "text": "都有指定代理商卻有犯罪集團涉嫌"
  },
  {
    "sequence": 205,
    "start": 667.36,
    "duration": 4.319999999999936,
    "text": "進貧輸品也就是俗稱的水貨甚至不排除"
  },
  {
    "sequence": 206,
    "start": 671.68,
    "duration": 3.9200000000000728,
    "text": "涉及仿冒侵權市值高達十億元以低於"
  },
  {
    "sequence": 207,
    "start": 675.6,
    "duration": 4.159999999999968,
    "text": "市價轉賣至少二十多家診所不乏有連鎖品牌"
  },
  {
    "sequence": 208,
    "start": 679.76,
    "duration": 1.8400000000000318,
    "text": "他們會失智破解"
  },
  {
    "sequence": 209,
    "start": 681.6,
    "duration": 5.360000000000014,
    "text": "篡改他們的晶片原本有使用次數限制"
  },
  {
    "sequence": 210,
    "start": 686.96,
    "duration": 4.279999999999973,
    "text": "的這些醫美探頭耗材等變成可以重複"
  },
  {
    "sequence": 211,
    "start": 691.24,
    "duration": 3.519999999999982,
    "text": "使用非法耗材除了流向診所不乏集團也搞"
  },
  {
    "sequence": 212,
    "start": 694.76,
    "duration": 3.1200000000000045,
    "text": "地下醫美藉由醫美小蜜蜂從網路找"
  },
  {
    "sequence": 213,
    "start": 697.88,
    "duration": 3.4400000000000546,
    "text": "客人相約飯店在沒有醫師執照下違法"
  },
  {
    "sequence": 214,
    "start": 701.32,
    "duration": 3.5599999999999454,
    "text": "替人施打先別說產品本身可能有問題"
  },
  {
    "sequence": 215,
    "start": 704.88,
    "duration": 3.9600000000000364,
    "text": "警方更查出嫌犯篡改設計讓一次性探頭"
  },
  {
    "sequence": 216,
    "start": 708.84,
    "duration": 3.3600000000000136,
    "text": "能夠毀充無限使用鳳凰電波他只能夠打"
  },
  {
    "sequence": 217,
    "start": 712.2,
    "duration": 2.9599999999999227,
    "text": "九百發可是破解版也許可以打個九千發"
  },
  {
    "sequence": 218,
    "start": 715.16,
    "duration": 2.3999999999999773,
    "text": "甚至一萬發以上最差的狀況可能就是"
  },
  {
    "sequence": 219,
    "start": 717.56,
    "duration": 1.9200000000000728,
    "text": "我們做完之後他沒什麼效果"
  },
  {
    "sequence": 220,
    "start": 719.48,
    "duration": 2.5599999999999454,
    "text": "他在不穩定能量狀況下我們可能臉部"
  },
  {
    "sequence": 221,
    "start": 722.04,
    "duration": 2.759999999999991,
    "text": "會造成燙傷或者甚至我們對顏面神經"
  },
  {
    "sequence": 222,
    "start": 724.8,
    "duration": 2.9200000000000728,
    "text": "他會有傷害警方調查全案辦成顧客"
  },
  {
    "sequence": 223,
    "start": 727.72,
    "duration": 3,
    "text": "蒐證這次逮捕十二人到案以醫師法"
  },
  {
    "sequence": 224,
    "start": 730.72,
    "duration": 2.839999999999918,
    "text": "商標法詐欺等罪行移送下一步"
  },
  {
    "sequence": 225,
    "start": 733.56,
    "duration": 3.32000000000005,
    "text": "更要釐清診所是否知情公視新聞"
  },
  {
    "sequence": 226,
    "start": 736.88,
    "duration": 1.3999999999999773,
    "text": "陳冠旭陳詠懿臺北報導"
  },
  {
    "sequence": 227,
    "start": 738.28,
    "duration": 5.800000000000068,
    "text": "有旅客在臺鐵車廂內大聲的講手機"
  },
  {
    "sequence": 228,
    "start": 744.08,
    "duration": 2.839999999999918,
    "text": "列車長前來勸阻"
  },
  {
    "sequence": 229,
    "start": 746.92,
    "duration": 4.2000000000000455,
    "text": "居民旅客不但不聽還大聲謾罵"
  },
  {
    "sequence": 230,
    "start": 751.96,
    "duration": 1.6399999999999864,
    "text": "最後被請下車"
  },
  {
    "sequence": 231,
    "start": 753.6,
    "duration": 3.6399999999999864,
    "text": "也將面臨一萬元以下的罰鍰"
  },
  {
    "sequence": 232,
    "start": 757.24,
    "duration": 3.2000000000000455,
    "text": "而事實上除了臺鐵"
  },
  {
    "sequence": 233,
    "start": 760.44,
    "duration": 4.559999999999945,
    "text": "包括高鐵跟捷運對於擾亂秩序騷擾"
  },
  {
    "sequence": 234,
    "start": 765,
    "duration": 2.080000000000041,
    "text": "他人都有聚在規定"
  },
  {
    "sequence": 235,
    "start": 767.08,
    "duration": 4.360000000000014,
    "text": "男子因手機通話音量過大遭列車長"
  },
  {
    "sequence": 236,
    "start": 771.44,
    "duration": 2.7199999999999136,
    "text": "制止後不滿對話音量是越來越大"
  },
  {
    "sequence": 237,
    "start": 782.48,
    "duration": 4.240000000000009,
    "text": "事情發生在二十五號上午九點多"
  },
  {
    "sequence": 238,
    "start": 786.72,
    "duration": 3.6399999999999864,
    "text": "臺鐵一車次自強號列車上五十五歲"
  },
  {
    "sequence": 239,
    "start": 790.36,
    "duration": 2.8799999999999955,
    "text": "旅行男子因不聽勸阻謾罵遭列車長"
  },
  {
    "sequence": 240,
    "start": 793.24,
    "duration": 2.519999999999982,
    "text": "當場解除運送契約旅行男子"
  },
  {
    "sequence": 241,
    "start": 795.76,
    "duration": 2.6399999999999864,
    "text": "最後在臺中火車站被警方請下車"
  },
  {
    "sequence": 242,
    "start": 798.4,
    "duration": 2.6399999999999864,
    "text": "還將依社會秩序維護法開罰一萬元"
  },
  {
    "sequence": 243,
    "start": 801.04,
    "duration": 3.519999999999982,
    "text": "以下罰鍰因此手機通話音量過大"
  },
  {
    "sequence": 244,
    "start": 804.56,
    "duration": 4.680000000000064,
    "text": "經列車長制止能不聽勸阻謾罵經列車長"
  },
  {
    "sequence": 245,
    "start": 809.24,
    "duration": 3.8799999999999955,
    "text": "解除運送契約警方到場協助該男子"
  },
  {
    "sequence": 246,
    "start": 813.12,
    "duration": 1.8400000000000318,
    "text": "配合警方與排中段下車"
  },
  {
    "sequence": 247,
    "start": 814.96,
    "duration": 2.599999999999909,
    "text": "因為他會影響到其他旅客的"
  },
  {
    "sequence": 248,
    "start": 817.56,
    "duration": 4.2000000000000455,
    "text": "安寧馬以及是影響到通行的動線"
  },
  {
    "sequence": 249,
    "start": 821.76,
    "duration": 3.519999999999982,
    "text": "這些我們就會給他勸導不聽勸阻的"
  },
  {
    "sequence": 250,
    "start": 825.28,
    "duration": 2.6800000000000637,
    "text": "我們就可以跟他解除運送契約"
  },
  {
    "sequence": 251,
    "start": 827.96,
    "duration": 2.480000000000018,
    "text": "高鐵日前宣佈將從九月二十二號起"
  },
  {
    "sequence": 252,
    "start": 830.44,
    "duration": 2.9599999999999227,
    "text": "推出寧靜車廂規定通話要到玄關"
  },
  {
    "sequence": 253,
    "start": 833.4,
    "duration": 1.9200000000000728,
    "text": "聽音樂看影片要戴耳機"
  },
  {
    "sequence": 254,
    "start": 835.32,
    "duration": 3.0799999999999272,
    "text": "聊天音量要放低旅勸不聽就會聚在"
  },
  {
    "sequence": 255,
    "start": 838.72,
    "duration": 2.759999999999991,
    "text": "同位軌道運輸的臺鐵與捷運在運送"
  },
  {
    "sequence": 256,
    "start": 841.48,
    "duration": 3.3999999999999773,
    "text": "契約和旅客須知中雖未明定電子產品"
  },
  {
    "sequence": 257,
    "start": 844.88,
    "duration": 2.3999999999999773,
    "text": "使用規範但也有強調不得騷擾"
  },
  {
    "sequence": 258,
    "start": 847.28,
    "duration": 2.3999999999999773,
    "text": "他人若勸阻不聽就可聚在"
  },
  {
    "sequence": 259,
    "start": 849.68,
    "duration": 1.5600000000000591,
    "text": "那如果勸導無效的話我們一"
  },
  {
    "sequence": 260,
    "start": 851.24,
    "duration": 1.4800000000000182,
    "text": "旅客須知"
  },
  {
    "sequence": 261,
    "start": 852.72,
    "duration": 3.67999999999995,
    "text": "第二三條第一項第三款的規定"
  },
  {
    "sequence": 262,
    "start": 856.4,
    "duration": 2,
    "text": "然後亂探行為來處理"
  },
  {
    "sequence": 263,
    "start": 858.4,
    "duration": 1.2000000000000455,
    "text": "也就是拒絕運送"
  },
  {
    "sequence": 264,
    "start": 859.6,
    "duration": 4.199999999999932,
    "text": "會希望吧對所以就或者是設計一種車廂"
  },
  {
    "sequence": 265,
    "start": 863.8,
    "duration": 2.5200000000000955,
    "text": "是有需要講話的人可以去打"
  },
  {
    "sequence": 266,
    "start": 867.32,
    "duration": 2.519999999999982,
    "text": "民眾表示支持相關規定和作法"
  },
  {
    "sequence": 267,
    "start": 869.84,
    "duration": 3.519999999999982,
    "text": "終結公司的強調捷運列車與雙鐵不同"
  },
  {
    "sequence": 268,
    "start": 873.36,
    "duration": 3.519999999999982,
    "text": "並無列車長隨車旅客若發現脫序事件"
  },
  {
    "sequence": 269,
    "start": 876.88,
    "duration": 2.9600000000000364,
    "text": "可直接通報保全或債務人員相關"
  },
  {
    "sequence": 270,
    "start": 879.84,
    "duration": 2.6399999999999864,
    "text": "人員都會立即進行處理公視新聞"
  },
  {
    "sequence": 271,
    "start": 882.48,
    "duration": 1.67999999999995,
    "text": "陽明瘋狂換群臺中報導"
  },
  {
    "sequence": 272,
    "start": 884.16,
    "duration": 4.040000000000077,
    "text": "推動藍色公路旅遊"
  },
  {
    "sequence": 273,
    "start": 888.2,
    "duration": 2.3599999999999,
    "text": "交通部新航線"
  },
  {
    "sequence": 274,
    "start": 890.56,
    "duration": 2.880000000000109,
    "text": "澎湖的基隆港市航"
  },
  {
    "sequence": 275,
    "start": 893.44,
    "duration": 3.0399999999999636,
    "text": "二十五號晚上由澎湖出發"
  },
  {
    "sequence": 276,
    "start": 896.8,
    "duration": 1.759999999999991,
    "text": "搭載了兩百多名旅客"
  },
  {
    "sequence": 277,
    "start": 898.56,
    "duration": 4.32000000000005,
    "text": "而其中臥鋪的載客率達到了九成四"
  },
  {
    "sequence": 278,
    "start": 902.88,
    "duration": 3.480000000000018,
    "text": "已經了十二個小時的航程"
  },
  {
    "sequence": 279,
    "start": 906.36,
    "duration": 2.6399999999999864,
    "text": "昨天早上抵達基隆港"
  },
  {
    "sequence": 280,
    "start": 909,
    "duration": 2.5599999999999454,
    "text": "而學者分析"
  },
  {
    "sequence": 281,
    "start": 911.56,
    "duration": 3.080000000000041,
    "text": "藍色公路具有票價的優勢"
  },
  {
    "sequence": 282,
    "start": 914.64,
    "duration": 3.0399999999999636,
    "text": "未來要多優化硬體設施"
  },
  {
    "sequence": 283,
    "start": 917.68,
    "duration": 2.4400000000000546,
    "text": "也要克服海象的挑戰"
  },
  {
    "sequence": 284,
    "start": 920.12,
    "duration": 6.2000000000000455,
    "text": "漫步到甲板上等待看日出"
  },
  {
    "sequence": 285,
    "start": 926.48,
    "duration": 1.8400000000000318,
    "text": "兩百多名搭乘澎湖輪的旅客"
  },
  {
    "sequence": 286,
    "start": 928.32,
    "duration": 2.7999999999999545,
    "text": "自二十五號由澎湖出發在船上過夜"
  },
  {
    "sequence": 287,
    "start": 931.12,
    "duration": 2.759999999999991,
    "text": "經歷十一小時航程在二十六號上午"
  },
  {
    "sequence": 288,
    "start": 933.88,
    "duration": 1.4800000000000182,
    "text": "順利抵達基隆港"
  },
  {
    "sequence": 289,
    "start": 935.36,
    "duration": 3.5599999999999454,
    "text": "這條澎湖到基隆的失敗航線"
  },
  {
    "sequence": 290,
    "start": 938.92,
    "duration": 3,
    "text": "搭載兩百八十多名旅客過半是團客"
  },
  {
    "sequence": 291,
    "start": 941.92,
    "duration": 1.8000000000000682,
    "text": "雖然經歷十多小時航程"
  },
  {
    "sequence": 292,
    "start": 943.72,
    "duration": 2.1200000000000045,
    "text": "但是船上有樂團魔術等表演"
  },
  {
    "sequence": 293,
    "start": 945.84,
    "duration": 1.6000000000000227,
    "text": "也提供臥鋪與餐食"
  },
  {
    "sequence": 294,
    "start": 947.44,
    "duration": 2.839999999999918,
    "text": "客輪轉型觀光旅客也覺得新鮮"
  },
  {
    "sequence": 295,
    "start": 950.28,
    "duration": 1.0400000000000773,
    "text": "可能有一點久"
  },
  {
    "sequence": 296,
    "start": 951.32,
    "duration": 2.3199999999999363,
    "text": "如果就是說我們回北部的話在那邊"
  },
  {
    "sequence": 297,
    "start": 953.64,
    "duration": 2.560000000000059,
    "text": "就是當作有住宿那種感覺其實是可以"
  },
  {
    "sequence": 298,
    "start": 956.6,
    "duration": 1.9599999999999227,
    "text": "夏天的時候買機票是很難買的"
  },
  {
    "sequence": 299,
    "start": 958.56,
    "duration": 2.400000000000091,
    "text": "需要從船隻來幫忙"
  },
  {
    "sequence": 300,
    "start": 960.96,
    "duration": 3.2799999999999727,
    "text": "運輸一些交通包括那個人的出生"
  },
  {
    "sequence": 301,
    "start": 964.24,
    "duration": 2.1200000000000045,
    "text": "澎湖縣長陳光富也帶著縣府同仁"
  },
  {
    "sequence": 302,
    "start": 966.36,
    "duration": 0.7999999999999545,
    "text": "親身體驗"
  },
  {
    "sequence": 303,
    "start": 967.16,
    "duration": 2.4400000000000546,
    "text": "直言很期待這條航線成為常態"
  },
  {
    "sequence": 304,
    "start": 969.6,
    "duration": 2.759999999999991,
    "text": "未來希望新船隻繼續優化內裝帶動"
  },
  {
    "sequence": 305,
    "start": 972.36,
    "duration": 3.1200000000000045,
    "text": "觀光也能為澎湖相親提供更多元的旅運"
  },
  {
    "sequence": 306,
    "start": 975.48,
    "duration": 1.3199999999999363,
    "text": "選擇與返鄉方式"
  },
  {
    "sequence": 307,
    "start": 976.8,
    "duration": 1.4400000000000546,
    "text": "雖然航程時間長"
  },
  {
    "sequence": 308,
    "start": 978.24,
    "duration": 2.67999999999995,
    "text": "但對比單程兩千多元的機票價格"
  },
  {
    "sequence": 309,
    "start": 980.92,
    "duration": 1.2000000000000455,
    "text": "具有競爭優勢"
  },
  {
    "sequence": 310,
    "start": 982.28,
    "duration": 4.1200000000000045,
    "text": "越有的話你可以省一個晚上的旅宿費用"
  },
  {
    "sequence": 311,
    "start": 986.4,
    "duration": 3.080000000000041,
    "text": "若你你你團外亂你最少"
  },
  {
    "sequence": 312,
    "start": 989.48,
    "duration": 2.5599999999999454,
    "text": "若搭船你就可以省三千塊以上"
  },
  {
    "sequence": 313,
    "start": 992.04,
    "duration": 11.680000000000064,
    "text": "交通部航港局表示明年有望繼續辦理"
  },
  {
    "sequence": 314,
    "start": 1003.72,
    "duration": 1.6000000000000227,
    "text": "這類觀光包船航班"
  },
  {
    "sequence": 315,
    "start": 1005.32,
    "duration": 2.839999999999918,
    "text": "而未來是否有望讓澎湖基隆航線成為"
  },
  {
    "sequence": 316,
    "start": 1008.16,
    "duration": 2.560000000000059,
    "text": "定期航班關鍵還是要先把船隻數量"
  },
  {
    "sequence": 317,
    "start": 1010.72,
    "duration": 2.3199999999999363,
    "text": "提高才能夠有更完整的規劃"
  },
  {
    "sequence": 318,
    "start": 1013.04,
    "duration": 1.9600000000000364,
    "text": "公視新聞學家林肩綜合報導"
  },
  {
    "sequence": 319,
    "start": 1015,
    "duration": 4.8799999999999955,
    "text": "牛隻在消化纖維的時候"
  },
  {
    "sequence": 320,
    "start": 1019.88,
    "duration": 4.639999999999986,
    "text": "會以打嗝或放屁的方式排放出甲烷"
  },
  {
    "sequence": 321,
    "start": 1024.52,
    "duration": 3.599999999999909,
    "text": "而由於甲烷吸收熱的能力強"
  },
  {
    "sequence": 322,
    "start": 1028.12,
    "duration": 3.240000000000009,
    "text": "是造成全球暖化的主因之一"
  },
  {
    "sequence": 323,
    "start": 1031.36,
    "duration": 2.400000000000091,
    "text": "研究發現"
  },
  {
    "sequence": 324,
    "start": 1033.76,
    "duration": 4.480000000000018,
    "text": "如果讓牛隻使用一種海藻"
  },
  {
    "sequence": 325,
    "start": 1038.24,
    "duration": 1.3199999999999363,
    "text": "海門東"
  },
  {
    "sequence": 326,
    "start": 1040.24,
    "duration": 2.759999999999991,
    "text": "就可以減少九成以上的排放"
  },
  {
    "sequence": 327,
    "start": 1043,
    "duration": 4.160000000000082,
    "text": "為此農業部水事所"
  },
  {
    "sequence": 328,
    "start": 1047.16,
    "duration": 2.119999999999891,
    "text": "花了好幾年的時間"
  },
  {
    "sequence": 329,
    "start": 1049.28,
    "duration": 2.839999999999918,
    "text": "成功繁殖了海門東"
  },
  {
    "sequence": 330,
    "start": 1052.12,
    "duration": 3.2000000000000455,
    "text": "為臺灣競軍全球"
  },
  {
    "sequence": 331,
    "start": 1055.32,
    "duration": 2.480000000000018,
    "text": "返出動物減碳市場"
  },
  {
    "sequence": 332,
    "start": 1057.8,
    "duration": 2.400000000000091,
    "text": "取得了重要的門票"
  },
  {
    "sequence": 333,
    "start": 1060.2,
    "duration": 9.11999999999989,
    "text": "在陽光照射下海中海門東呈現美麗"
  },
  {
    "sequence": 334,
    "start": 1069.32,
    "duration": 1.9600000000000364,
    "text": "紅色在牛隻飼料"
  },
  {
    "sequence": 335,
    "start": 1071.28,
    "duration": 2.900000000000091,
    "text": "如果加入一percent左右的乾燥海門東"
  },
  {
    "sequence": 336,
    "start": 1074.18,
    "duration": 2.6599999999998545,
    "text": "可減少九十percent的甲烷排放"
  },
  {
    "sequence": 337,
    "start": 1076.84,
    "duration": 3.060000000000173,
    "text": "儘管臺灣恆春半島小琉球澎湖都有"
  },
  {
    "sequence": 338,
    "start": 1079.9,
    "duration": 1.0199999999999818,
    "text": "野生族群"
  },
  {
    "sequence": 339,
    "start": 1080.92,
    "duration": 2.439999999999827,
    "text": "但太過零星且夏天會消失"
  },
  {
    "sequence": 340,
    "start": 1083.36,
    "duration": 3.0800000000001546,
    "text": "若想作為飼料添加物必須大量生產"
  },
  {
    "sequence": 341,
    "start": 1086.44,
    "duration": 3.2200000000000273,
    "text": "農業部水事所花了數年時間成功"
  },
  {
    "sequence": 342,
    "start": 1089.66,
    "duration": 3.5399999999999636,
    "text": "讓海門東在眾多強勢早在競爭中突圍"
  },
  {
    "sequence": 343,
    "start": 1093.2,
    "duration": 0.5199999999999818,
    "text": "生長"
  },
  {
    "sequence": 344,
    "start": 1093.72,
    "duration": 3.119999999999891,
    "text": "對應的一個存花培養的一個方式去"
  },
  {
    "sequence": 345,
    "start": 1096.84,
    "duration": 2.9600000000000364,
    "text": "把它做這個太粗最後只保留我們要的"
  },
  {
    "sequence": 346,
    "start": 1099.8,
    "duration": 1,
    "text": "這個四分包子體"
  },
  {
    "sequence": 347,
    "start": 1100.8,
    "duration": 2.880000000000109,
    "text": "讓他在這裡面是佔據優勢成功的"
  },
  {
    "sequence": 348,
    "start": 1103.68,
    "duration": 3,
    "text": "關鍵還包括研究人員原本拿海門東"
  },
  {
    "sequence": 349,
    "start": 1106.68,
    "duration": 3.0599999999999454,
    "text": "成年的配子體來繁殖但失敗改用"
  },
  {
    "sequence": 350,
    "start": 1109.74,
    "duration": 3.0599999999999454,
    "text": "青少年的四分包子體才突破技術"
  },
  {
    "sequence": 351,
    "start": 1112.8,
    "duration": 3.4400000000000546,
    "text": "而四分包子體更能抑制甲烷生成"
  },
  {
    "sequence": 352,
    "start": 1116.24,
    "duration": 2.740000000000009,
    "text": "海門東他最主要的這個抑制甲烷"
  },
  {
    "sequence": 353,
    "start": 1118.98,
    "duration": 2.5399999999999636,
    "text": "的這個主成分秀房的一個主要成分"
  },
  {
    "sequence": 354,
    "start": 1121.52,
    "duration": 3.599999999999909,
    "text": "他可以去使這個流位的浚上是比較趨向"
  },
  {
    "sequence": 355,
    "start": 1125.12,
    "duration": 3.520000000000209,
    "text": "於降低甲烷的這個浚上的生成國內"
  },
  {
    "sequence": 356,
    "start": 1128.64,
    "duration": 3.3999999999998636,
    "text": "如品業者也看好將來可推出低碳如品"
  },
  {
    "sequence": 357,
    "start": 1132.04,
    "duration": 3.3199999999999363,
    "text": "等相關產品甲烷的排放量一直是一個"
  },
  {
    "sequence": 358,
    "start": 1135.36,
    "duration": 3.520000000000209,
    "text": "蠻大的一個痛點能夠大量的減低"
  },
  {
    "sequence": 359,
    "start": 1138.88,
    "duration": 0.4799999999997908,
    "text": "這個"
  },
  {
    "sequence": 360,
    "start": 1139.36,
    "duration": 3.880000000000109,
    "text": "碳排放量都是非常一個令人振奮"
  },
  {
    "sequence": 361,
    "start": 1143.24,
    "duration": 3.0399999999999636,
    "text": "的消息一頭牛排放的甲烷相當一公頃"
  },
  {
    "sequence": 362,
    "start": 1146.28,
    "duration": 3.240000000000009,
    "text": "單森林公園一年碳吸收量透過海門東"
  },
  {
    "sequence": 363,
    "start": 1149.52,
    "duration": 3.6800000000000637,
    "text": "減少動物甲烷排放水市所長張景儀認為"
  },
  {
    "sequence": 364,
    "start": 1153.2,
    "duration": 3.240000000000009,
    "text": "是高效率減碳量產技術已經寄轉給"
  },
  {
    "sequence": 365,
    "start": 1156.44,
    "duration": 2.9600000000000364,
    "text": "國內生技公司目前全球返除動物"
  },
  {
    "sequence": 366,
    "start": 1159.4,
    "duration": 2.839999999999918,
    "text": "減碳市場規模達三十億美元由"
  },
  {
    "sequence": 367,
    "start": 1162.24,
    "duration": 3.519999999999982,
    "text": "七家公司擁有技術臺灣相當是拿到"
  },
  {
    "sequence": 368,
    "start": 1165.76,
    "duration": 3.0799999999999272,
    "text": "第八張門票公視新聞臨近朋友組臺北"
  },
  {
    "sequence": 369,
    "start": 1168.84,
    "duration": 0.44000000000005457,
    "text": "報導"
  },
  {
    "sequence": 370,
    "start": 1169.28,
    "duration": 5.079999999999927,
    "text": "西班牙八月持續遭遇熱浪受到"
  },
  {
    "sequence": 371,
    "start": 1174.36,
    "duration": 1.0800000000001546,
    "text": "野火侵襲"
  },
  {
    "sequence": 372,
    "start": 1175.44,
    "duration": 2.0399999999999636,
    "text": "當局宣佈"
  },
  {
    "sequence": 373,
    "start": 1177.48,
    "duration": 3.7999999999999545,
    "text": "今年夏天發生的一百一十三起"
  },
  {
    "sequence": 374,
    "start": 1181.32,
    "duration": 4.759999999999991,
    "text": "野火波及的市鎮將列為緊急狀態地區"
  },
  {
    "sequence": 375,
    "start": 1186.08,
    "duration": 5.6400000000001,
    "text": "居民跟商家可以獲得緊急援助跟減稅"
  },
  {
    "sequence": 376,
    "start": 1191.72,
    "duration": 6.480000000000018,
    "text": "西班牙遭鑄榮肆虐的幾個主要山林"
  },
  {
    "sequence": 377,
    "start": 1198.2,
    "duration": 3,
    "text": "大火來到八月下旬逐漸趨於穩定"
  },
  {
    "sequence": 378,
    "start": 1201.2,
    "duration": 3.2000000000000455,
    "text": "不過消防員還不能休息截至八月二十六"
  },
  {
    "sequence": 379,
    "start": 1204.4,
    "duration": 3.0399999999999636,
    "text": "號至少還有十五處正在燃燒的野火"
  },
  {
    "sequence": 380,
    "start": 1207.44,
    "duration": 3.0399999999999636,
    "text": "對人民跟財產構成威脅當局宣佈"
  },
  {
    "sequence": 381,
    "start": 1210.48,
    "duration": 3.599999999999909,
    "text": "今年夏天遭野火波及的市鎮為緊急地區"
  },
  {
    "sequence": 382,
    "start": 1214.08,
    "duration": 3.3200000000001637,
    "text": "居民跟企業商家可獲得緊急援助減稅"
  },
  {
    "sequence": 383,
    "start": 1217.4,
    "duration": 0.1999999999998181,
    "text": "等"
  },
  {
    "sequence": 384,
    "start": 1217.6,
