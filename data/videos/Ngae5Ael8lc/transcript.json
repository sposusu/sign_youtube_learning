  },
  {
    "sequence": 410,
    "start": 1256.56,
    "duration": 1.7999999999999545,
    "text": "根據西班牙內政部的報告"
  },
  {
    "sequence": 411,
    "start": 1258.36,
    "duration": 3.4400000000000546,
    "text": "今年夏天野火已經造成多人死亡包含"
  },
  {
    "sequence": 412,
    "start": 1261.8,
    "duration": 3.400000000000091,
    "text": "至少有一名疫消全國有數千人從家人"
  },
  {
    "sequence": 413,
    "start": 1265.2,
    "duration": 3.1599999999998545,
    "text": "撤離不少得在臨時避難所避難此外"
  },
  {
    "sequence": 414,
    "start": 1268.36,
    "duration": 3.0800000000001546,
    "text": "有數十人因涉嫌縱火或疏失而被捕"
  },
  {
    "sequence": 415,
    "start": 1271.44,
    "duration": 3.7200000000000273,
    "text": "調查然而破紀錄的熱浪及乾旱使得多地"
  },
  {
    "sequence": 416,
    "start": 1275.16,
    "duration": 3.240000000000009,
    "text": "野火有一段劇烈的燃燒期顯示人為"
