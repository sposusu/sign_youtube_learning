[
  {
    "start": 0,
    "duration": 12.36,
    "text": "MING PAO CANADA | MING PAO TORONTO",
    "hasSignLanguage": false
  },
  {
    "start": 12.36,
    "duration": 2.26,
    "text": "看新聞 開視野",
    "hasSignLanguage": false
  },
  {
    "start": 14.62,
    "duration": 4.9,
    "text": "歡迎收看今天11月12日的公視手語新聞",
    "hasSignLanguage": false
  },
  {
    "start": 19.52,
    "duration": 1.8399999999999999,
    "text": "首先來關心",
    "hasSignLanguage": true
  },
  {
    "start": 21.36,
    "duration": 2,
    "text": "鳳凰颱風逼近",
    "hasSignLanguage": true
  },
  {
    "start": 23.36,
    "duration": 3.400000000000002,
    "text": "暴風圈已經進入台灣南部陸地",
    "hasSignLanguage": true
  },
  {
    "start": 26.76,
    "duration": 2,
    "text": "雖然強度持續減弱",
    "hasSignLanguage": true
  },
  {
    "start": 28.76,
    "duration": 2,
    "text": "但還是不能掉以輕心",
    "hasSignLanguage": true
  },
  {
    "start": 30.76,
    "duration": 3.9999999999999964,
    "text": "今天停止上班上課的地區",
    "hasSignLanguage": true
  },
  {
    "start": 34.76,
    "duration": 2,
    "text": "包括了有苗栗縣",
    "hasSignLanguage": true
  },
  {
    "start": 36.76,
    "duration": 2,
    "text": "台中市",
    "hasSignLanguage": true
  },
  {
    "start": 38.76,
    "duration": 2,
    "text": "彰化縣",
    "hasSignLanguage": true
  },
  {
    "start": 40.76,
    "duration": 2,
    "text": "雲林縣",
    "hasSignLanguage": true
  },
  {
    "start": 42.76,
    "duration": 2,
    "text": "南投縣",
    "hasSignLanguage": true
  },
  {
    "start": 44.76,
    "duration": 2,
    "text": "嘉義縣市",
    "hasSignLanguage": true
  },
  {
    "start": 46.76,
    "duration": 2,
    "text": "台南市",
    "hasSignLanguage": true
  },
  {
    "start": 48.76,
    "duration": 2,
    "text": "高雄市",
    "hasSignLanguage": true
  },
  {
    "start": 50.76,
    "duration": 2,
    "text": "屏東縣",
    "hasSignLanguage": true
  },
  {
    "start": 52.76,
    "duration": 2,
    "text": "宜蘭縣",
    "hasSignLanguage": true
  },
  {
    "start": 54.76,
    "duration": 2,
    "text": "還有澎湖縣",
    "hasSignLanguage": true
  },
  {
    "start": 56.76,
    "duration": 2,
    "text": "以及瑞穗鄉的奇美國小",
    "hasSignLanguage": true
  },
  {
    "start": 58.76,
    "duration": 2,
    "text": "也是停班停課",
    "hasSignLanguage": true
  },
  {
    "start": 60.76,
    "duration": 4.000000000000007,
    "text": "接著我們就來看",
    "hasSignLanguage": true
  },
  {
    "start": 64.76,
    "duration": 4,
    "text": "氣象署的最新颱風動態說明",
    "hasSignLanguage": true
  },
  {
    "start": 68.76,
    "duration": 4,
    "text": "我們可以看到颱風目前的位置",
    "hasSignLanguage": true
  },
  {
    "start": 72.76,
    "duration": 4,
    "text": "在俄蘭比西南方大約170公里的海面上",
    "hasSignLanguage": true
  },
  {
    "start": 76.76,
    "duration": 4,
    "text": "今天它會逐漸地朝台灣附近的西南海域這邊接近",
    "hasSignLanguage": false
  },
  {
    "start": 80.76,
    "duration": 2,
    "text": "所以雖然它在逐漸的減弱當中",
    "hasSignLanguage": false
  },
  {
    "start": 82.76,
    "duration": 4,
    "text": "不過還是對我們的近海這一帶帶來一些風雨上面的威脅",
    "hasSignLanguage": false
  },
  {
    "start": 86.76,
    "duration": 2,
    "text": "還是要多加留意",
    "hasSignLanguage": false
  },
  {
    "start": 88.76,
    "duration": 2,
    "text": "我們從颱風的潛勢預測圖上面",
    "hasSignLanguage": false
  },
  {
    "start": 90.76,
    "duration": 6,
    "text": "可以看到大約在今天傍晚左右就會相當接近恆春半島的這一帶",
    "hasSignLanguage": false
  },
  {
    "start": 96.76,
    "duration": 2,
    "text": "在今天傍晚左右接近恆春半島",
    "hasSignLanguage": false
  },
  {
    "start": 98.76,
    "duration": 4,
    "text": "在傍晚到晚間就會通過台灣的南段陸地",
    "hasSignLanguage": false
  },
  {
    "start": 102.76,
    "duration": 4,
    "text": "並且從台東附近往東北出海",
    "hasSignLanguage": false
  },
  {
    "start": 106.76,
    "duration": 2,
    "text": "而預估它在往東北方向移動這段期間",
    "hasSignLanguage": false
  },
  {
    "start": 108.76,
    "duration": 2,
    "text": "會有快速減弱的趨勢",
    "hasSignLanguage": false
  },
  {
    "start": 110.76,
    "duration": 2,
    "text": "可能會轉為熱帶性低氣",
    "hasSignLanguage": false
  },
  {
    "start": 112.76,
    "duration": 2,
    "text": "或是進一步的變性為溫帶氣旋",
    "hasSignLanguage": false
  },
  {
    "start": 114.76,
    "duration": 4,
    "text": "今天晚間左右就會逐漸登陸到台灣的南段陸地並且出海",
    "hasSignLanguage": false
  },
  {
    "start": 118.76,
    "duration": 4,
    "text": "那這段期間還是要留意颱風所帶來的影響",
    "hasSignLanguage": false
  },
  {
    "start": 122.76,
    "duration": 4,
    "text": "至於我們在山區附近其實剛剛也有提到",
    "hasSignLanguage": false
  },
  {
    "start": 126.76,
    "duration": 3.999999999999986,
    "text": "整體的降雨都比較明顯在過去一段時間",
    "hasSignLanguage": false
  },
  {
    "start": 130.76,
    "duration": 2,
    "text": "所以山區土石的含水量比較偏高",
    "hasSignLanguage": false
  },
  {
    "start": 132.76,
    "duration": 4,
    "text": "也提醒大家盡量避免前往山區活動",
    "hasSignLanguage": false
  },
  {
    "start": 138.76,
    "duration": 2,
    "text": "昨天宜蘭大雨不斷",
    "hasSignLanguage": true
  },
  {
    "start": 140.76,
    "duration": 2,
    "text": "尤其是蘇澳",
    "hasSignLanguage": true
  },
  {
    "start": 142.76,
    "duration": 4,
    "text": "昨天晚間被淹成了一座孤島",
    "hasSignLanguage": true
  },
  {
    "start": 146.76,
    "duration": 4,
    "text": "連外道路幾乎都被阻斷",
    "hasSignLanguage": true
  },
  {
    "start": 150.76,
    "duration": 4,
    "text": "最嚴重的地方水淹有一層樓高",
    "hasSignLanguage": true
  },
  {
    "start": 154.76,
    "duration": 6,
    "text": "國軍也出動AAV拐兩棲突襲車來前進救援",
    "hasSignLanguage": true
  },
  {
    "start": 160.76,
    "duration": 6,
    "text": "大雨下不停水已經淹到看不到馬路",
    "hasSignLanguage": true
  },
  {
    "start": 166.76,
    "duration": 4,
    "text": "山的便電箱疑似因為積水短路發出巨大爆炸聲響",
    "hasSignLanguage": false
  },
  {
    "start": 170.76,
    "duration": 4,
    "text": "馬路瞬間陷入一片黑暗",
    "hasSignLanguage": false
  },
  {
    "start": 174.76,
    "duration": 4,
    "text": "鳳凰颱風的外圍環流加上東北季風的共扮效應",
    "hasSignLanguage": false
  },
  {
    "start": 178.76,
    "duration": 2,
    "text": "為宜蘭地區帶來驚人與世",
    "hasSignLanguage": false
  },
  {
    "start": 180.76,
    "duration": 2,
    "text": "蘇澳每小時雨量超過120毫米",
    "hasSignLanguage": false
  },
  {
    "start": 182.76,
    "duration": 2,
    "text": "多處水深及夭",
    "hasSignLanguage": false
  },
  {
    "start": 184.76,
    "duration": 4,
    "text": "就連救護車都拋錨卡在半路",
    "hasSignLanguage": false
  },
  {
    "start": 188.76,
    "duration": 4,
    "text": "被大水圍困的民眾寸步難行",
    "hasSignLanguage": false
  },
  {
    "start": 192.76,
    "duration": 2,
    "text": "只能靠消防人員的橡皮艇一一將人救出",
    "hasSignLanguage": false
  },
  {
    "start": 194.76,
    "duration": 4,
    "text": "行動不便的長者則由消防人員揹著拖困",
    "hasSignLanguage": false
  },
  {
    "start": 198.76,
    "duration": 2,
    "text": "截至週二晚間10點半",
    "hasSignLanguage": false
  },
  {
    "start": 200.76,
    "duration": 3,
    "text": "已經救援27人 撤離112人",
    "hasSignLanguage": false
  },
  {
    "start": 203.76,
    "duration": 3,
    "text": "共139人到蘇澳鎮公所",
    "hasSignLanguage": false
  },
  {
    "start": 206.76,
    "duration": 3,
    "text": "外國人不敢遇到這麼大的雨",
    "hasSignLanguage": false
  },
  {
    "start": 209.76,
    "duration": 2,
    "text": "一下子水就跑出來了",
    "hasSignLanguage": false
  },
  {
    "start": 211.76,
    "duration": 3,
    "text": "到客廳了 也是有一點緊張",
    "hasSignLanguage": false
  },
  {
    "start": 214.76,
    "duration": 3,
    "text": "蘇澳的連外道路幾乎都被大水阻斷",
    "hasSignLanguage": false
  },
  {
    "start": 217.76,
    "duration": 2,
    "text": "救援困難",
    "hasSignLanguage": false
  },
  {
    "start": 222.76,
    "duration": 2,
    "text": "蘇澳鎮長李明哲表示",
    "hasSignLanguage": false
  },
  {
    "start": 224.76,
    "duration": 3,
    "text": "整個蘇澳市區幾乎變成一個孤島",
    "hasSignLanguage": false
  },
  {
    "start": 227.76,
    "duration": 2,
    "text": "最嚴重的地方水淹一層樓高",
    "hasSignLanguage": false
  },
  {
    "start": 229.76,
    "duration": 4,
    "text": "我們對外的道路其實都已經淹水了",
    "hasSignLanguage": false
  },
  {
    "start": 233.76,
    "duration": 2,
    "text": "車輛也沒有辦法進出",
    "hasSignLanguage": false
  },
  {
    "start": 235.76,
    "duration": 3,
    "text": "因為整個蘇澳溪的這個溪水暴漲",
    "hasSignLanguage": false
  },
  {
    "start": 238.76,
    "duration": 2,
    "text": "我們一直抽水 再一直抽水",
    "hasSignLanguage": false
  },
  {
    "start": 240.76,
    "duration": 3,
    "text": "可是還是沒有辦法把這個水液降低",
    "hasSignLanguage": false
  },
  {
    "start": 243.76,
    "duration": 3,
    "text": "路面無法步行 居民垂直避難撤到二樓",
    "hasSignLanguage": false
  },
  {
    "start": 246.76,
    "duration": 4,
    "text": "軍方緊急出動AAV拐兩棲突擊車救援",
    "hasSignLanguage": false
  },
  {
    "start": 252.76,
    "duration": 1,
    "text": "氣象署表示",
    "hasSignLanguage": false
  },
  {
    "start": 253.76,
    "duration": 3,
    "text": "鳳凰颱風的暴風圈已經進入南部陸地",
    "hasSignLanguage": false
  },
  {
    "start": 256.76,
    "duration": 3,
    "text": "有可能在週三傍晚前後登陸屏東",
    "hasSignLanguage": false
  },
  {
    "start": 259.76,
    "duration": 2,
    "text": "將持續觀察颱風減弱的程度",
    "hasSignLanguage": false
  },
  {
    "start": 261.76,
    "duration": 2,
    "text": "決定警報解除的時間",
    "hasSignLanguage": false
  },
  {
    "start": 263.76,
    "duration": 2,
    "text": "下午到傍晚之間",
    "hasSignLanguage": false
  },
  {
    "start": 265.76,
    "duration": 3,
    "text": "就會接近我們屏東這一帶的陸地",
    "hasSignLanguage": false
  },
  {
    "start": 268.76,
    "duration": 3,
    "text": "此外它可能在明天的晚上到深夜這段時間",
    "hasSignLanguage": false
  },
  {
    "start": 271.76,
    "duration": 3,
    "text": "就從台東到屏東交界這地帶逐漸出海",
    "hasSignLanguage": false
  },
  {
    "start": 274.76,
    "duration": 3,
    "text": "對比宜蘭的雨勢會逐漸趨於緩和",
    "hasSignLanguage": false
  },
  {
    "start": 277.76,
    "duration": 4,
    "text": "氣象署提醒週三在台東地區雨勢相對明顯",
    "hasSignLanguage": false
  },
  {
    "start": 281.76,
    "duration": 3,
    "text": "迎風面的基隆北海岸也要留意較大雨勢",
    "hasSignLanguage": false
  },
  {
    "start": 284.76,
    "duration": 4,
    "text": "公視新聞 林靜倫 朱鳳竹 提倡綜合報道",
    "hasSignLanguage": true
  },
  {
    "start": 288.76,
    "duration": 3,
    "text": "因應鳳凰颱風來襲",
    "hasSignLanguage": true
  },
  {
    "start": 291.76,
    "duration": 7,
    "text": "今天中午前東部幹縣樹林到台東停駛",
    "hasSignLanguage": true
  },
  {
    "start": 298.76,
    "duration": 4,
    "text": "而連日好雨讓馬太安西暴漲",
    "hasSignLanguage": true
  },
  {
    "start": 302.76,
    "duration": 3,
    "text": "從左岸沒有堤防的地方",
    "hasSignLanguage": true
  },
  {
    "start": 305.76,
    "duration": 4,
    "text": "衝入了萬榮鄉明麗村",
    "hasSignLanguage": true
  },
  {
    "start": 309.76,
    "duration": 5,
    "text": "而村長就質疑是疏峻變道惹禍",
    "hasSignLanguage": true
  },
  {
    "start": 314.76,
    "duration": 5,
    "text": "水利署長到現場會勘向民眾致歉",
    "hasSignLanguage": true
  },
  {
    "start": 319.76,
    "duration": 7,
    "text": "澄清主要原因是河道淤積所導致",
    "hasSignLanguage": true
  },
  {
    "start": 326.76,
    "duration": 9,
    "text": "而昨晚泥水甚至把一整個貨櫃都給沖走",
    "hasSignLanguage": true
  },
  {
    "start": 335.76,
    "duration": 12,
    "text": "泥水大到沖走一整個貨櫃",
    "hasSignLanguage": true
  },
  {
    "start": 347.76,
    "duration": 2,
    "text": "這是昨晚八點多",
    "hasSignLanguage": false
  },
  {
    "start": 349.76,
    "duration": 2,
    "text": "明麗部落民眾拍下的驚險畫面",
    "hasSignLanguage": false
  },
  {
    "start": 351.76,
    "duration": 2,
    "text": "鳳凰颱風雨勢驚人",
    "hasSignLanguage": false
  },
  {
    "start": 353.76,
    "duration": 2,
    "text": "花蓮馬太安西再度溢流",
    "hasSignLanguage": false
  },
  {
    "start": 355.76,
    "duration": 3,
    "text": "滾滾洪流夾帶大量沙石",
    "hasSignLanguage": false
  },
  {
    "start": 358.76,
    "duration": 3,
    "text": "沿著大排灌進萬榮鄉明麗村",
    "hasSignLanguage": false
  },
  {
    "start": 361.76,
    "duration": 2,
    "text": "太誇張了太誇張了",
    "hasSignLanguage": false
  },
  {
    "start": 363.76,
    "duration": 2,
    "text": "明麗部落居民指函太誇張",
    "hasSignLanguage": false
  },
  {
    "start": 365.76,
    "duration": 2,
    "text": "因為不定時的一坡坡泥水",
    "hasSignLanguage": false
  },
  {
    "start": 367.76,
    "duration": 2,
    "text": "從十號晚間就開始",
    "hasSignLanguage": false
  },
  {
    "start": 369.76,
    "duration": 3,
    "text": "昨天早上也出現沖走汽車",
    "hasSignLanguage": false
  },
  {
    "start": 372.76,
    "duration": 2,
    "text": "民宅也遭殃了災情",
    "hasSignLanguage": false
  },
  {
    "start": 374.76,
    "duration": 2,
    "text": "山貓直接開進房子裡面",
    "hasSignLanguage": false
  },
  {
    "start": 376.76,
    "duration": 2,
    "text": "要把裡面的淤泥鏟除出來",
    "hasSignLanguage": false
  },
  {
    "start": 378.76,
    "duration": 2,
    "text": "趁著雨勢跟水勢的空檔",
    "hasSignLanguage": false
  },
  {
    "start": 380.76,
    "duration": 3,
    "text": "要協助這邊來趕快恢復原狀",
    "hasSignLanguage": false
  },
  {
    "start": 383.76,
    "duration": 3,
    "text": "明麗村長質疑是疏峻變道惹禍",
    "hasSignLanguage": false
  },
  {
    "start": 386.76,
    "duration": 3,
    "text": "從七月到九月時就曾經多次通報",
    "hasSignLanguage": false
  },
  {
    "start": 389.76,
    "duration": 3,
    "text": "擔心一流口有危險卻沒有處理",
    "hasSignLanguage": false
  },
  {
    "start": 392.76,
    "duration": 4,
    "text": "這個破口從七月份到昨天一流",
    "hasSignLanguage": false
  },
  {
    "start": 396.76,
    "duration": 3,
    "text": "我多少次的通報會勘",
    "hasSignLanguage": false
  },
  {
    "start": 399.76,
    "duration": 2,
    "text": "那時候紀連城也特別交代",
    "hasSignLanguage": false
  },
  {
    "start": 401.76,
    "duration": 2,
    "text": "結果還是沒有動作",
    "hasSignLanguage": false
  },
  {
    "start": 403.76,
    "duration": 2,
    "text": "水利署長到場會勘 鞠躬致歉",
    "hasSignLanguage": false
  },
  {
    "start": 405.76,
    "duration": 2,
    "text": "強調沒有做好是疏忽",
    "hasSignLanguage": false
  },
  {
    "start": 407.76,
    "duration": 3,
    "text": "但也澄清跟疏峻變道沒有關係",
    "hasSignLanguage": false
  },
  {
    "start": 410.76,
    "duration": 2,
    "text": "主要是因為淤積導致",
    "hasSignLanguage": false
  },
  {
    "start": 412.76,
    "duration": 3,
    "text": "疏峻的變道有關嗎 沒有關係",
    "hasSignLanguage": false
  },
  {
    "start": 415.76,
    "duration": 1,
    "text": "它雖然有打個變道",
