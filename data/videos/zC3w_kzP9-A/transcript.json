[
  {
    "sequence": 1,
    "start": 0,
    "duration": 12,
    "text": "(音樂)"
  },
  {
    "sequence": 2,
    "start": 12,
    "duration": 2,
    "text": "看新聞 開視野"
  },
  {
    "sequence": 3,
    "start": 14,
    "duration": 5,
    "text": "歡迎收看今天11月18號的公視手語新聞"
  },
  {
    "sequence": 4,
    "start": 19,
    "duration": 2,
    "text": "首先來關心"
  },
  {
    "sequence": 5,
    "start": 21,
    "duration": 2,
    "text": "東京聽奧賽事"
  },
  {
    "sequence": 6,
    "start": 23,
    "duration": 5,
    "text": "昨天登場的是10公尺空氣手槍"
  },
  {
    "sequence": 7,
    "start": 28,
    "duration": 4,
    "text": "而台灣選手高雅如與許明瑞都闖進決賽"
  },
  {
    "sequence": 8,
    "start": 32,
    "duration": 3,
    "text": "最後高雅如是以第四名坐收"
  },
  {
    "sequence": 9,
    "start": 35,
    "duration": 4,
    "text": "而許明瑞受到預賽狀態起伏的影響"
  },
  {
    "sequence": 10,
    "start": 39,
    "duration": 3,
    "text": "最後是以第六名遭到淘汰"
  },
  {
    "sequence": 11,
    "start": 42,
    "duration": 5,
    "text": "兩位選手明天將合作挑戰空氣手槍團體賽"
  },
  {
    "sequence": 12,
    "start": 47,
    "duration": 3,
    "text": "全力為台灣拼下獎牌"
  },
  {
    "sequence": 13,
    "start": 50,
    "duration": 5,
    "text": "這裡是涉及比賽場館"
  },
  {
    "sequence": 14,
    "start": 56,
    "duration": 4,
    "text": "由於日本對槍支管制相當嚴格"
  },
  {
    "sequence": 15,
    "start": 60,
    "duration": 4,
    "text": "場館並未開放一般民眾入場觀賽"
  },
  {
    "sequence": 16,
    "start": 64,
    "duration": 4,
    "text": "10公尺空氣手槍預賽男子組"
  },
  {
    "sequence": 17,
    "start": 68,
    "duration": 3,
    "text": "許明瑞以第六名挺進決賽"
  },
  {
    "sequence": 18,
    "start": 71,
    "duration": 2,
    "text": "女子組方面"
  },
  {
    "sequence": 19,
    "start": 73,
    "duration": 3,
    "text": "高雅如名列第四 順利晉級"
  },
  {
    "sequence": 20,
    "start": 76,
    "duration": 3,
    "text": "不過謝婉爭責無緣決賽"
  },
  {
    "sequence": 21,
    "start": 79,
    "duration": 4,
    "text": "接下來帶您一起來看決賽的情況"
  },
  {
    "sequence": 22,
    "start": 83,
    "duration": 4,
    "text": "上屆聽澳涉及拿下易營一同的高雅如"
  },
  {
    "sequence": 23,
    "start": 87,
    "duration": 3,
