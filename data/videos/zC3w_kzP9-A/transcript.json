  {
    "sequence": 32,
    "start": 110,
    "duration": 4,
    "text": "被打進樓 被打進樓"
  },
  {
    "sequence": 33,
    "start": 114,
    "duration": 3,
    "text": "被二樓都被拋掉了"
  },
  {
    "sequence": 34,
    "start": 117,
    "duration": 3,
    "text": "我就趕快把她拉下來"
  },
  {
    "sequence": 35,
    "start": 120,
    "duration": 2,
