    "sequence": 155,
    "start": 465,
    "duration": 3,
    "text": "中國與日本關係緊張"
  },
  {
    "sequence": 156,
    "start": 468,
    "duration": 2,
    "text": "日本外務省"
  },
  {
    "sequence": 157,
    "start": 470,
    "duration": 4,
    "text": "昨天派官員到中國來進行溝通"
  },
  {
    "sequence": 158,
    "start": 474,
    "duration": 4,
    "text": "不過前總統馬英九則是批評"
  },
  {
    "sequence": 159,
    "start": 478,
    "duration": 2,
    "text": "高市早苗躁進"
  },
  {
    "sequence": 160,
    "start": 480,
    "duration": 4,
    "text": "對此總統賴清德呼籲"
  },
  {
    "sequence": 161,
    "start": 484,
    "duration": 4,
    "text": "應該要尊重日本國內政治"
  },
  {
    "sequence": 162,
    "start": 488,
    "duration": 3,
    "text": "而中方行為嚴重衝擊"
  },
  {
    "sequence": 163,
    "start": 491,
    "duration": 2,
    "text": "印太和平穩定"
  },
  {
    "sequence": 164,
    "start": 493,
    "duration": 2,
    "text": "希望中國三思"
  },
  {
    "sequence": 165,
    "start": 495,
    "duration": 4,
    "text": "日本首相高市早苗"
  },
  {
    "sequence": 166,
    "start": 499,
    "duration": 1,
    "text": "表態台灣有事"
  },
  {
    "sequence": 167,
    "start": 500,
    "duration": 2,
    "text": "可能構成日本存亡危機事態"
  },
  {
    "sequence": 168,
    "start": 502,
    "duration": 2,
    "text": "引發中日關係緊張"
  },
  {
    "sequence": 169,
    "start": 504,
    "duration": 2,
    "text": "中國連日來動作頻頻"
  },
  {
    "sequence": 170,
    "start": 506,
    "duration": 1,
    "text": "包括呼籲民眾"
  },
  {
    "sequence": 171,
    "start": 507,
    "duration": 1,
    "text": "戰務赴日旅遊留學"
  },
  {
    "sequence": 172,
    "start": 508,
    "duration": 2,
    "text": "也派出海警艦艇編隊"
  },
  {
    "sequence": 173,
    "start": 510,
    "duration": 2,
    "text": "在釣魚台海域巡航"
  },
  {
    "sequence": 174,
    "start": 512,
    "duration": 2,
    "text": "17日至19日更連三天"
  },
  {
    "sequence": 175,
    "start": 514,
    "duration": 3,
    "text": "在黃海中部海域進行實彈射擊"
  },
  {
    "sequence": 176,
    "start": 517,
    "duration": 2,
    "text": "而日本內閣官方長官木園仍指出"
  },
  {
    "sequence": 177,
    "start": 519,
    "duration": 2,
    "text": "中日人員交流縮減"
  },
  {
    "sequence": 178,
    "start": 521,
    "duration": 2,
    "text": "不符合兩國領袖會談確認的"
  },
  {
    "sequence": 179,
    "start": 523,
    "duration": 2,
    "text": "推進戰略互惠等方向"
  },
  {
    "sequence": 180,
    "start": 525,
    "duration": 4,
    "text": "以強烈要求中方採取適當措施"
  },
  {
    "sequence": 181,
    "start": 542,
    "duration": 3,
    "text": "為避免局勢進一步升級"
  },
  {
    "sequence": 182,
    "start": 545,
    "duration": 2,
    "text": "日本外務省亞洲大洋洲局長"
  },
  {
    "sequence": 183,
    "start": 547,
    "duration": 1,
    "text": "驚起陣仗"
  },
  {
    "sequence": 184,
    "start": 548,
    "duration": 1,
    "text": "週一出訪北京"
  },
  {
    "sequence": 185,
    "start": 549,
    "duration": 3,
    "text": "預定18日與中外交部亞洲司長"
  },
  {
    "sequence": 186,
    "start": 552,
    "duration": 2,
    "text": "劉敬松等人面對面溝通"
  },
  {
    "sequence": 187,
    "start": 554,
    "duration": 3,
    "text": "在台議題掀起中日波瀾下"
  },
  {
    "sequence": 188,
    "start": 557,
    "duration": 2,
    "text": "前總馬英九批評高市早苗奏進"
  },
  {
    "sequence": 189,
    "start": 559,
    "duration": 2,
    "text": "對此總賴清德呼籲"
  },
  {
    "sequence": 190,
    "start": 561,
    "duration": 2,
    "text": "五國應尊重日本國內政治"
  },
  {
    "sequence": 191,
    "start": 563,
    "duration": 1,
    "text": "而中方行為"
  },
  {
    "sequence": 192,
    "start": 564,
    "duration": 2,
    "text": "嚴重衝擊印太和平穩定"
  },
  {
    "sequence": 193,
    "start": 566,
    "duration": 2,
    "text": "希望中國三思"
  },
  {
    "sequence": 194,
    "start": 572,
    "duration": 2,
    "text": "社會持續關注"
  },
  {
    "sequence": 195,
    "start": 574,
    "duration": 3,
    "text": "也呼籲中國應該要克制"
  },
  {
    "sequence": 196,
    "start": 577,
    "duration": 3,
    "text": "展現大國的風範"
  },
  {
    "sequence": 197,
    "start": 580,
    "duration": 2,
    "text": "不要成為區域和平穩定的"
  },
  {
    "sequence": 198,
    "start": 582,
    "duration": 2,
    "text": "麻煩製造者"
  },
  {
    "sequence": 199,
    "start": 584,
    "duration": 4,
    "text": "日本各界對於中國這樣的挑釁"
  },
  {
    "sequence": 200,
    "start": 588,
    "duration": 2,
    "text": "各界都非常的憤怒"
  },
  {
    "sequence": 201,
    "start": 590,
    "duration": 3,
    "text": "對中國來講未必會在"
  },
  {
    "sequence": 202,
    "start": 593,
    "duration": 4,
    "text": "國際關係上得到這個好處"
  },
  {
    "sequence": 203,
    "start": 597,
    "duration": 1,
    "text": "台日協會長蘇嘉全認為"
  },
  {
    "sequence": 204,
    "start": 598,
    "duration": 2,
    "text": "日本對於中方的抗議恐嚇"
  },
  {
    "sequence": 205,
    "start": 600,
    "duration": 2,
    "text": "已經習以為常"
  },
  {
    "sequence": 206,
    "start": 602,
    "duration": 1,
    "text": "據未來台日合作"
  },
  {
    "sequence": 207,
    "start": 603,
    "duration": 3,
    "text": "將持續朝全面正向發展前進"
  },
  {
    "sequence": 208,
    "start": 606,
    "duration": 1,
    "text": "公視新聞評論"
  },
  {
    "sequence": 209,
    "start": 607,
    "duration": 1,
    "text": "許家瑞、方俊懷、陳柏玉"
  },
  {
    "sequence": 210,
    "start": 608,
    "duration": 3,
    "text": "台北新北報導"
  },
  {
    "sequence": 211,
    "start": 630,
    "duration": 3,
    "text": "無人來協助處理"
  },
  {
    "sequence": 212,
    "start": 633,
    "duration": 3,
    "text": "昨天鎮長公開致歉"
  },
  {
    "sequence": 213,
    "start": 636,
    "duration": 3,
    "text": "坦言有疏失"
  },
  {
    "sequence": 214,
    "start": 639,
    "duration": 1,
    "text": "而另外"
  },
  {
    "sequence": 215,
    "start": 640,
    "duration": 3,
    "text": "燕波飯店在颱風期間"
  },
  {
    "sequence": 216,
    "start": 643,
    "duration": 4,
    "text": "超過30輛車在地下室泡水"
  },
  {
    "sequence": 217,
    "start": 647,
    "duration": 4,
    "text": "有11名住客受災"
  },
  {
    "sequence": 218,
    "start": 651,
    "duration": 2,
    "text": "他們不滿業者到現在"
  },
  {
    "sequence": 219,
    "start": 653,
    "duration": 2,
    "text": "還沒有明確的補償方案"
  },
  {
    "sequence": 220,
    "start": 655,
    "duration": 7,
    "text": "打算要提出集體訴訟"
  },
  {
    "sequence": 221,
    "start": 662,
    "duration": 2,
    "text": "挖土機忙著清除淤泥"
  },
  {
    "sequence": 222,
    "start": 664,
    "duration": 2,
    "text": "街道上則到處堆置的"
  },
  {
    "sequence": 223,
    "start": 666,
    "duration": 2,
    "text": "泡水傢俱與垃圾"
  },
  {
    "sequence": 224,
    "start": 668,
    "duration": 1,
    "text": "鳳凰颱風豪雨"
  },
  {
    "sequence": 225,
    "start": 669,
    "duration": 2,
    "text": "重創宜蘭縣蘇澳鎮"
  },
  {
    "sequence": 226,
    "start": 671,
    "duration": 1,
    "text": "11後晚間中原路"
  },
  {
    "sequence": 227,
    "start": 672,
    "duration": 2,
    "text": "一度水淹一層樓高"
  },
  {
    "sequence": 228,
    "start": 674,
    "duration": 2,
    "text": "一名78歲黃姓獨居老婦"
  },
  {
    "sequence": 229,
    "start": 676,
    "duration": 2,
    "text": "在住家一樓溺水死亡"
  },
  {
    "sequence": 230,
    "start": 678,
    "duration": 1,
    "text": "但在後第六天"
  },
  {
    "sequence": 231,
    "start": 679,
    "duration": 2,
    "text": "蘇澳鎮災害應變中心"
  },
  {
    "sequence": 232,
    "start": 681,
    "duration": 1,
    "text": "才公布罹難者"
  },
  {
    "sequence": 233,
    "start": 682,
    "duration": 3,
    "text": "家屬與鄰居都不滿證供所延遲通報"
  },
  {
    "sequence": 234,
    "start": 685,
    "duration": 1,
    "text": "他本來是在樓上"
  },
  {
    "sequence": 235,
    "start": 686,
    "duration": 2,
    "text": "可是他可能想看"
  },
  {
    "sequence": 236,
    "start": 688,
    "duration": 1,
    "text": "看看下面的狀況"
  },
  {
    "sequence": 237,
    "start": 689,
    "duration": 2,
    "text": "因為雨太大 聲音很大"
  },
  {
    "sequence": 238,
    "start": 691,
    "duration": 2,
    "text": "對 所以他有點擔心"
  },
  {
    "sequence": 239,
    "start": 693,
    "duration": 2,
    "text": "所以他可能要下來關心水勢"
  },
  {
    "sequence": 240,
    "start": 695,
    "duration": 2,
    "text": "事發到現在"
  },
  {
    "sequence": 241,
    "start": 697,
    "duration": 5,
    "text": "鎮長跟縣長說他們昨天"
  },
  {
    "sequence": 242,
    "start": 702,
    "duration": 3,
    "text": "他們才受到說有人傷亡"
  },
  {
    "sequence": 243,
    "start": 705,
    "duration": 2,
    "text": "子女因為聯絡不上黃姓老婦"
  },
  {
    "sequence": 244,
    "start": 707,
    "duration": 1,
    "text": "12號從外縣市趕回"
  },
  {
    "sequence": 245,
    "start": 708,
    "duration": 2,
    "text": "才發現母親倒在一樓客廳"
  },
  {
    "sequence": 246,
    "start": 710,
    "duration": 2,
    "text": "通報消防局與警方"
  },
  {
    "sequence": 247,
    "start": 712,
    "duration": 2,
    "text": "一名先死亡未送醫"
  },
  {
    "sequence": 248,
    "start": 714,
    "duration": 2,
    "text": "檢方13號會同法醫相驗"
  },
  {
    "sequence": 249,
    "start": 716,
    "duration": 2,
    "text": "確認身前溺水死亡"
  },
  {
    "sequence": 250,
    "start": 718,
    "duration": 1,
    "text": "14號里長還致電"
  },
  {
    "sequence": 251,
    "start": 719,
    "duration": 2,
    "text": "公所里幹事詢問補助"
  },
  {
    "sequence": 252,
    "start": 721,
    "duration": 1,
    "text": "家屬無法接受"
  },
  {
    "sequence": 253,
    "start": 722,
    "duration": 2,
    "text": "始終無人協助處理"
  },
  {
    "sequence": 254,
    "start": 724,
    "duration": 2,
    "text": "蘇澳鎮長17號致歉"
  },
  {
    "sequence": 255,
    "start": 726,
    "duration": 2,
    "text": "坦承是通報鏈出了問題"
  },
  {
    "sequence": 256,
    "start": 728,
    "duration": 3,
    "text": "因為是公所來對整個通報鏈"
  },
  {
    "sequence": 257,
    "start": 731,
    "duration": 3,
    "text": "我想有出了一些問題"
  },
  {
    "sequence": 258,
    "start": 734,
    "duration": 2,
    "text": "我們回來也都已經"
  },
  {
    "sequence": 259,
    "start": 736,
    "duration": 2,
    "text": "在開始做這樣子的檢討"
  },
  {
    "sequence": 260,
    "start": 738,
    "duration": 3,
    "text": "那我在這裡就向我們"
  },
  {
    "sequence": 261,
    "start": 741,
    "duration": 2,
    "text": "這個死者致上最大的歉意"
  },
  {
    "sequence": 262,
    "start": 743,
    "duration": 4,
    "text": "山貓和水車不斷進出地下室"
  },
  {
    "sequence": 263,
    "start": 747,
    "duration": 3,
    "text": "燕坡飯店四季雙泉管地下停車場"
  },
  {
    "sequence": 264,
    "start": 750,
    "duration": 2,
    "text": "有超過30輛車泡水"
  },
  {
    "sequence": 265,
    "start": 752,
    "duration": 2,
    "text": "11名受災住客指控業者"
  },
  {
    "sequence": 266,
    "start": 754,
    "duration": 2,
    "text": "為妥善履行防災義務"
  },
  {
    "sequence": 267,
    "start": 756,
    "duration": 3,
    "text": "且請投保300萬公共意外責任險"
  },
  {
    "sequence": 268,
    "start": 759,
    "duration": 2,
    "text": "至今未有明確補償方案"
  },
  {
    "sequence": 269,
    "start": 761,
    "duration": 2,
    "text": "計畫展開集體訴訟"
  },
  {
    "sequence": 270,
    "start": 763,
    "duration": 2,
    "text": "不論飯店的保險金額是多少"
  },
  {
    "sequence": 271,
    "start": 765,
    "duration": 2,
    "text": "只要是經過第三幫公正單位"
  },
  {
    "sequence": 272,
    "start": 767,
    "duration": 1,
    "text": "釐清權責後"
  },
  {
    "sequence": 273,
    "start": 768,
    "duration": 3,
    "text": "本集團將會承擔起應付的責任"
  },
  {
    "sequence": 274,
    "start": 771,
    "duration": 2,
    "text": "絕對不會有推諉的行為"
  },
  {
    "sequence": 275,
    "start": 773,
    "duration": 1,
    "text": "飯店業者強調"
  },
  {
    "sequence": 276,
    "start": 774,
    "duration": 2,
    "text": "理解車主財損與不便"
  },
  {
    "sequence": 277,
    "start": 776,
    "duration": 2,
    "text": "脫掉費用均全額支付"
  },
  {
    "sequence": 278,
    "start": 778,
    "duration": 2,
    "text": "後續會加速委託第三方公正單位"
  },
  {
    "sequence": 279,
    "start": 780,
    "duration": 2,
    "text": "釐清相關責任不會推諉"
  },
  {
    "sequence": 280,
    "start": 782,
    "duration": 1,
    "text": "公視新聞"
  },
  {
    "sequence": 281,
    "start": 783,
    "duration": 2,
    "text": "林靜倫 楊明峰 彭煥群 宜蘭報導"
  },
  {
    "sequence": 282,
    "start": 785,
    "duration": 5,
    "text": "而同樣受到鳳凰颱風影響的是"
  },
  {
    "sequence": 283,
    "start": 790,
    "duration": 4,
    "text": "花蓮馬太安溪下游的閩麗村"
  },
  {
    "sequence": 284,
    "start": 795,
    "duration": 4,
    "text": "由於映色湖溢流 泥水沖入"
  },
  {
    "sequence": 285,
    "start": 799,
    "duration": 5,
    "text": "造成許多的房屋被淹沒在泥濘當中"
  },
  {
    "sequence": 286,
    "start": 804,
    "duration": 6,
    "text": "昨天 國軍持續協助居民整理家園"
  },
  {
    "sequence": 287,
    "start": 810,
    "duration": 4,
    "text": "同時 在重型機具趕工清淤下"
  },
  {
    "sequence": 288,
    "start": 814,
    "duration": 3,
    "text": "部落的精神象徵"
  },
  {
    "sequence": 289,
    "start": 817,
    "duration": 4,
    "text": "紋面阿嬤雕像也重建田嶼"
  },
  {
    "sequence": 290,
    "start": 825,
    "duration": 3,
    "text": "很心痛喔"
  },
  {
    "sequence": 291,
    "start": 828,
    "duration": 1,
    "text": "真的不知道怎麼整理"
  },
  {
    "sequence": 292,
    "start": 829,
    "duration": 3,
    "text": "家裝從客廳到廚房一片狼藉 全是泥濘"
  },
  {
    "sequence": 293,
    "start": 832,
    "duration": 4,
    "text": "花蓮縣萬榕桑 明麗部落居民只能無奈苦授"
  },
  {
    "sequence": 294,
    "start": 836,
    "duration": 2,
    "text": "在國軍弟兄協助下整理家園"
  },
  {
    "sequence": 295,
    "start": 838,
    "duration": 3,
    "text": "所有清出來的家當都往馬路上擺"
  },
  {
    "sequence": 296,
    "start": 841,
    "duration": 3,
    "text": "好不容易 有人挖出被淤泥覆蓋的櫃子"
  },
  {
    "sequence": 297,
    "start": 844,
    "duration": 3,
    "text": "找到護照 戶口名簿等重要文件"
  },
  {
    "sequence": 298,
    "start": 847,
    "duration": 4,
    "text": "我完全都沒有辦法了 全部都摧毀了"
  },
  {
    "sequence": 299,
    "start": 851,
    "duration": 3,
    "text": "太多石頭了 沒有辦法"
  },
  {
    "sequence": 300,
    "start": 854,
    "duration": 3,
    "text": "很感謝國軍來協助 當然"
  },
  {
    "sequence": 301,
    "start": 857,
    "duration": 2,
    "text": "有人協助我們都要感恩"
  },
  {
    "sequence": 302,
    "start": 859,
    "duration": 3,
    "text": "看著國軍揮汗纏土 居民滿滿感謝"
  },
  {
    "sequence": 303,
    "start": 862,
    "duration": 1,
    "text": "空拍畫面可以看到"
  },
  {
    "sequence": 304,
    "start": 863,
    "duration": 3,
    "text": "明麗部落大面積都是泥沙淤積"
  },
  {
    "sequence": 305,
    "start": 866,
    "duration": 3,
    "text": "怪獸山貓不斷趕進度來回清淤"
  },
  {
    "sequence": 306,
    "start": 869,
    "duration": 2,
    "text": "17號也終於讓部落精神象徵"
  },
  {
    "sequence": 307,
    "start": 871,
    "duration": 3,
    "text": "紋面阿嬤雕像重建田嶼"
  },
  {
    "sequence": 308,
    "start": 874,
    "duration": 4,
    "text": "非常感謝我們所有民眾 我們台灣的民眾"
  },
  {
    "sequence": 309,
    "start": 878,
    "duration": 1,
    "text": "很有這個愛心"
  },
  {
    "sequence": 310,
    "start": 879,
    "duration": 2,
    "text": "但是我看這個情況"
  },
  {
    "sequence": 311,
    "start": 881,
    "duration": 2,
    "text": "跟光復是非常不同的"
  },
  {
    "sequence": 312,
    "start": 883,
    "duration": 3,
    "text": "這邊都是石頭 泥沙比較少"
  },
  {
    "sequence": 313,
    "start": 886,
    "duration": 4,
    "text": "所以說用大機器來處理這個是最恰當"
  },
  {
    "sequence": 314,
    "start": 890,
    "duration": 5,
    "text": "跨45線3K到明麗村部落都已經搶通"
  },
  {
    "sequence": 315,
    "start": 895,
    "duration": 2,
    "text": "部落最重要的聚會所"
  },
  {
    "sequence": 316,
    "start": 897,
    "duration": 3,
    "text": "這邊裡面應該今天也可以把它清出來"
  },
  {
    "sequence": 317,
    "start": 900,
    "duration": 2,
    "text": "自然通行應該預計在四天"
  },
  {
    "sequence": 318,
    "start": 902,
    "duration": 1,
    "text": "明麗部落滿目瘡痍"
  },
  {
    "sequence": 319,
    "start": 903,
    "duration": 2,
    "text": "就是因為日前鳳凰颱風"
  },
  {
    "sequence": 320,
    "start": 905,
    "duration": 2,
    "text": "導致馬太安溪溪雪暴漲釀災"
  },
  {
    "sequence": 321,
    "start": 907,
    "duration": 2,
    "text": "而上游的兩個驗測湖"
  },
  {
    "sequence": 322,
    "start": 909,
    "duration": 2,
    "text": "林保署透過空拍監測"
  },
  {
    "sequence": 323,
    "start": 911,
    "duration": 3,
    "text": "目前驗測湖一 蓄水量32.4萬立方公尺"
  },
  {
    "sequence": 324,
    "start": 914,
    "duration": 3,
    "text": "是溢流前的0.36%"
  },
  {
    "sequence": 325,
    "start": 917,
    "duration": 3,
    "text": "驗測湖三 蓄水量漲至約5萬立方公尺"
  },
  {
    "sequence": 326,
    "start": 920,
    "duration": 4,
    "text": "穩定溢流中 對下游河道水位抬升 因此"
  },
  {
    "sequence": 327,
    "start": 924,
    "duration": 5,
    "text": "溢流口左岸是原先崩塌下來之後殘存的土地"
  },
  {
    "sequence": 328,
    "start": 929,
    "duration": 3,
    "text": "我們在從9月23開始看到現在"
  },
  {
    "sequence": 329,
    "start": 932,
    "duration": 4,
    "text": "它有些許變化 但是都很輕微"
  },
  {
    "sequence": 330,
    "start": 936,
    "duration": 3,
    "text": "看起來還算是正常穩定"
  },
  {
    "sequence": 331,
    "start": 939,
    "duration": 3,
    "text": "林保署指出 驗測湖一 溢流口左岸"
  },
  {
    "sequence": 332,
    "start": 942,
    "duration": 3,
    "text": "還有約1億立方公尺的土砂堆積在坡面"
  },
  {
    "sequence": 333,
    "start": 945,
    "duration": 3,
    "text": "但未來可能因地震豪雨讓邊坡滑落"
  },
  {
    "sequence": 334,
    "start": 948,
    "duration": 3,
    "text": "再次阻塞河道 會持續密切監控"
  },
  {
    "sequence": 335,
    "start": 951,
    "duration": 4,
    "text": "公視新聞 文嘉凱 葉美玄 許家瑞 花蓮報導"
  },
  {
    "sequence": 336,
    "start": 969,
    "duration": 3,
    "text": "民眾騎機車載著一整箱雞蛋"
  },
  {
    "sequence": 337,
    "start": 972,
    "duration": 3,
    "text": "17號一大早來到彈航換彈"
  },
  {
    "sequence": 338,
    "start": 975,
    "duration": 3,
    "text": "台中無期的龍中彈航遭十二萬元交報"
  },
  {
    "sequence": 339,
    "start": 978,
    "duration": 3,
    "text": "民眾騎機車載著一整箱雞蛋"
  },
  {
    "sequence": 340,
