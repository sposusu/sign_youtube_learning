[
  {
    "start": 0,
    "duration": 12,
    "text": "(音樂)",
    "hasSignLanguage": false
  },
  {
    "start": 12,
    "duration": 3,
    "text": "看新聞 開視野",
    "hasSignLanguage": false
  },
  {
    "start": 15,
    "duration": 5,
    "text": "歡迎收看今天12月10號的公視手語新聞",
    "hasSignLanguage": true
  },
  {
    "start": 20,
    "duration": 3,
    "text": "首先要來關心",
    "hasSignLanguage": true
  },
  {
    "start": 23,
    "duration": 5,
    "text": "長期致力於國內外聽障體育的龍人陳康",
    "hasSignLanguage": true
  },
  {
    "start": 28,
    "duration": 6,
    "text": "曾經擔任國際聽障運動總會ICSD的主席",
    "hasSignLanguage": true
  },
  {
    "start": 34,
    "duration": 5,
    "text": "以及首任道德委員",
    "hasSignLanguage": true
  },
  {
    "start": 39,
    "duration": 5,
    "text": "而日前 在會員代表大會當中",
    "hasSignLanguage": true
  },
  {
    "start": 44,
    "duration": 5,
    "text": "他以最高票成功連任道德委員",
    "hasSignLanguage": true
  },
  {
    "start": 49,
    "duration": 3,
    "text": "而這個職務有什麼重要",
    "hasSignLanguage": true
  },
  {
    "start": 52,
    "duration": 4,
    "text": "對於台灣的國際能見度又有什麼意義呢",
    "hasSignLanguage": true
  },
  {
    "start": 56,
    "duration": 3,
    "text": "我們現在請陳康來告訴我們",
    "hasSignLanguage": true
  },
  {
    "start": 86,
    "duration": 11,
    "text": "(音樂)",
    "hasSignLanguage": false
  },
  {
    "start": 97,
    "duration": 5,
    "text": "國際聽障運動總會道德委員會於2022年成立",
    "hasSignLanguage": false
  },
  {
    "start": 102,
    "duration": 4,
    "text": "是獨立運作的單位 共有三名委員",
    "hasSignLanguage": false
  },
  {
    "start": 106,
    "duration": 3,
    "text": "主要負責調查性評 權勢霸凌",
    "hasSignLanguage": false
  },
  {
    "start": 109,
    "duration": 4,
    "text": "以及各會員國協會是否正常運作等申訴案件",
    "hasSignLanguage": false
  },
  {
    "start": 113,
    "duration": 3,
    "text": "他將調查結果回報給總會裡監視",
    "hasSignLanguage": false
  },
  {
    "start": 116,
    "duration": 4,
    "text": "陳康擔任第一任委員 受到疫情影響",
    "hasSignLanguage": false
  },
  {
    "start": 120,
    "duration": 4,
    "text": "任期僅三年 這次他以最高票成功連任",
    "hasSignLanguage": false
  },
  {
    "start": 124,
    "duration": 3,
    "text": "第二任期將回到完整的四年",
    "hasSignLanguage": false
  },
  {
    "start": 127,
    "duration": 3,
    "text": "他也表示 能再度當選",
    "hasSignLanguage": false
  },
  {
    "start": 130,
    "duration": 4,
    "text": "是因為各會員國對台灣的印象良好",
    "hasSignLanguage": false
  },
  {
    "start": 134,
    "duration": 3,
    "text": "我會當選是因為大家都信任我",
    "hasSignLanguage": false
  },
  {
    "start": 137,
    "duration": 4,
    "text": "這份信任也象徵大家對台灣的信任",
    "hasSignLanguage": false
  },
  {
    "start": 141,
    "duration": 5,
    "text": "陳康在第一任期 共受理調查與審議32件倫理事件",
    "hasSignLanguage": false
  },
  {
    "start": 146,
    "duration": 4,
    "text": "過程中始終秉持公正 客觀 超然的立場",
    "hasSignLanguage": false
  },
  {
    "start": 150,
    "duration": 3,
    "text": "獲得總會與各國代表一致肯定",
    "hasSignLanguage": false
  },
  {
    "start": 153,
    "duration": 4,
    "text": "也期待他在第二任期 持續推動制度更完善",
    "hasSignLanguage": false
  },
  {
    "start": 157,
    "duration": 4,
    "text": "為聽障選手打造更安心的比賽環境",
    "hasSignLanguage": false
  },
  {
    "start": 161,
    "duration": 5,
    "text": "此外 國際聽障運動總會會員代表大會也通過表決",
    "hasSignLanguage": false
  },
  {
    "start": 166,
    "duration": 5,
    "text": "確定2029年夏季聽障奧運將由希臘雅典主辦",
    "hasSignLanguage": false
  },
  {
    "start": 171,
    "duration": 4,
    "text": "公視新聞紐宣文整理報導",
    "hasSignLanguage": true
  },
  {
    "start": 175,
    "duration": 3,
    "text": "接著讀報時間來看到",
    "hasSignLanguage": true
  },
  {
    "start": 178,
    "duration": 3,
    "text": "中國時報是",
    "hasSignLanguage": true
  },
  {
    "start": 181,
    "duration": 4,
    "text": "美國總統川普在8日宣布",
    "hasSignLanguage": true
  },
  {
    "start": 185,
    "duration": 7,
    "text": "批准回答向大陸出口H200人工智慧晶片",
    "hasSignLanguage": true
  },
  {
    "start": 192,
    "duration": 6,
    "text": "而美國政府將會從中抽取25%的分潤",
    "hasSignLanguage": true
  },
  {
    "start": 198,
    "duration": 5,
    "text": "據了解 這一筆費用將會從製造地臺灣生產",
    "hasSignLanguage": true
  },
  {
    "start": 203,
    "duration": 5,
    "text": "並且運往美國的時候以關稅方式徵收",
    "hasSignLanguage": true
  },
  {
    "start": 208,
    "duration": 4,
    "text": "自由時報報導 財政部公布11月進出口",
    "hasSignLanguage": true
  },
  {
    "start": 212,
    "duration": 6,
    "text": "有640.5億美元 改寫歷史新高",
    "hasSignLanguage": true
  },
  {
    "start": 218,
    "duration": 7,
    "text": "年增率達到56% 連續25個月正成長",
    "hasSignLanguage": true
  },
  {
    "start": 225,
    "duration": 5,
    "text": "而這也是第三度超車南韓",
    "hasSignLanguage": true
  },
  {
    "start": 230,
    "duration": 5,
    "text": "聯合報提到了 南韓電子入境卡系統",
    "hasSignLanguage": true
  },
  {
    "start": 235,
    "duration": 7,
    "text": "今年2月上線至今 一直稱呼我們為「中國臺灣」",
    "hasSignLanguage": true
  },
  {
    "start": 242,
    "duration": 4,
    "text": "外交部昨天拉高分費表示",
    "hasSignLanguage": true
  },
  {
    "start": 246,
    "duration": 5,
    "text": "也同時注意到了臺韓貿易之間存在的巨額逆差",
    "hasSignLanguage": true
  },
  {
    "start": 251,
    "duration": 3,
    "text": "顯示兩國關係仍有不對等之處",
    "hasSignLanguage": true
  },
  {
    "start": 254,
    "duration": 3,
    "text": "將會全面檢視跟南韓政府的關係",
    "hasSignLanguage": true
  },
  {
    "start": 257,
    "duration": 6,
    "text": "呼籲南韓盡快改正不恰當的稱呼",
    "hasSignLanguage": true
  },
  {
    "start": 263,
    "duration": 8,
    "text": "去年0403強震 花蓮天王興大樓嚴重傾斜倒塌",
    "hasSignLanguage": true
  },
  {
    "start": 271,
    "duration": 10,
    "text": "花蓮地檢署昨天已故失致死罪嫌 起訴了營造公司陳姓負責人",
    "hasSignLanguage": true
  },
  {
    "start": 281,
    "duration": 9,
    "text": "檢方指出 天王興大樓因為施工與結構設計瑕疵",
    "hasSignLanguage": true
  },
  {
    "start": 290,
    "duration": 6,
    "text": "導致了鋼筋的強度只能發揮百分之七十",
    "hasSignLanguage": true
  },
  {
    "start": 296,
    "duration": 6,
    "text": "造成一人死亡 數百人無家可歸",
    "hasSignLanguage": true
  },
  {
    "start": 302,
    "duration": 6,
    "text": "陳姓負責人 事前欽呼法官 事後又否認犯行",
    "hasSignLanguage": true
  },
  {
    "start": 308,
    "duration": 5,
    "text": "盡請法官從重量刑",
    "hasSignLanguage": true
  },
  {
    "start": 313,
    "duration": 4,
    "text": "去年0403 花蓮發生規模7.2強震",
    "hasSignLanguage": false
  },
  {
    "start": 317,
    "duration": 3,
    "text": "導致天王興大樓嚴重傾斜坍塌",
    "hasSignLanguage": false
  },
  {
    "start": 320,
    "duration": 2,
    "text": "造成大樓住戶康樓需不幸罹難",
    "hasSignLanguage": false
  },
  {
    "start": 322,
    "duration": 6,
    "text": "花蓮地檢署調查發現 天王興大樓有結構計算設計及承造等缺失",
    "hasSignLanguage": false
  },
  {
    "start": 328,
    "duration": 4,
    "text": "造成一樓樑柱先破壞 又因建築物抗震能力不足",
    "hasSignLanguage": false
  },
  {
    "start": 332,
    "duration": 4,
    "text": "向南傾斜倒塌 有設計不良 偷工減料之嫌",
    "hasSignLanguage": false
  },
  {
    "start": 336,
    "duration": 3,
    "text": "9 日一過失致死罪嫌 起訴陳姓營造商",
    "hasSignLanguage": true
  },
  {
    "start": 339,
    "duration": 5,
    "text": "陳姓營造商他待呼公司的管理",
    "hasSignLanguage": true
  },
  {
    "start": 344,
    "duration": 5,
    "text": "也沒有確實的監督他的所屬員工 包商 施工",
    "hasSignLanguage": true
  },
  {
    "start": 349,
    "duration": 5,
    "text": "導致天王興大樓有潛開的重大瑕疵",
    "hasSignLanguage": true
  },
  {
    "start": 354,
    "duration": 5,
    "text": "進而造成康姓女子死亡 以及數以百計的住戶無家可歸",
    "hasSignLanguage": true
  },
  {
    "start": 359,
    "duration": 5,
    "text": "且於飯後食口否認犯行 因此夾官進行法院重重量刑",
    "hasSignLanguage": true
  },
  {
    "start": 364,
    "duration": 5,
    "text": "檢方調查大樓營造公司建築師 土木技師等4人",
    "hasSignLanguage": true
  },
  {
    "start": 369,
    "duration": 5,
    "text": "其中營造公司謝姓經理陳姓土木技師兩人已死亡不起訴",
    "hasSignLanguage": false
  },
  {
    "start": 374,
    "duration": 3,
    "text": "設計的曹姓建築師移民國外多年",
    "hasSignLanguage": false
  },
  {
    "start": 377,
    "duration": 2,
    "text": "檢方也對他發佈通緝",
    "hasSignLanguage": false
  },
  {
    "start": 379,
    "duration": 3,
    "text": "而檢方比對資料後意外發現 2018年",
    "hasSignLanguage": false
  },
  {
    "start": 382,
    "duration": 5,
    "text": "0206地震倒塌的無居無宿 建築也由曹南設計",
    "hasSignLanguage": false
  },
  {
    "start": 407,
    "duration": 3,
    "text": "負責的應該要有所表示",
    "hasSignLanguage": false
  },
  {
    "start": 410,
    "duration": 4,
    "text": "因他們的疏失造成天王興大樓一人死亡",
    "hasSignLanguage": false
  },
  {
    "start": 414,
    "duration": 2,
    "text": "里民失去家園表示譴責",
    "hasSignLanguage": false
  },
  {
    "start": 416,
    "duration": 5,
    "text": "同時也會協助天王興大樓爭取相關權益",
    "hasSignLanguage": false
  },
  {
    "start": 421,
    "duration": 2,
    "text": "天王興大樓主委王貞元強調",
    "hasSignLanguage": false
  },
  {
    "start": 423,
    "duration": 4,
    "text": "未來將配合司法調查與後續重建行政程序",
    "hasSignLanguage": false
  },
  {
    "start": 427,
    "duration": 4,
    "text": "也希望此事件能促使未來建築專業制度更為嚴謹",
    "hasSignLanguage": false
  },
  {
    "start": 431,
    "duration": 2,
    "text": "避免悲劇重演",
    "hasSignLanguage": false
  },
  {
    "start": 433,
    "duration": 5,
    "text": "新紀新文 黃佩甘 陳柏玉 溫家凱 花蓮報導",
    "hasSignLanguage": true
  },
  {
    "start": 438,
    "duration": 3,
    "text": "台語歌手曹雅雯近兩年",
    "hasSignLanguage": true
  },
  {
    "start": 441,
    "duration": 5,
    "text": "多次遭到一位新加坡籍女歌迷來跟蹤騷擾",
