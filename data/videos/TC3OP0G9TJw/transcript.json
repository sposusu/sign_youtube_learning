  },
  {
    "start": 967.2,
    "duration": 1,
    "text": "回顧我國代表團",
    "hasSignLanguage": false
  },
  {
    "start": 968.2,
    "duration": 2,
    "text": "歷年的參賽成績",
    "hasSignLanguage": false
  },
  {
    "start": 970.2,
    "duration": 2,
    "text": "2009年的臺北聽澳",
    "hasSignLanguage": false
  },
  {
    "start": 972.2,
    "duration": 2,
    "text": "拿下33面獎牌的好成績",
    "hasSignLanguage": false
  },
  {
    "start": 974.2,
    "duration": 2,
    "text": "2017年聽澳",
