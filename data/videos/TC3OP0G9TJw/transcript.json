  },
  {
    "start": 1241.2,
    "duration": 3,
    "text": "奪牌重點項目之一",
    "hasSignLanguage": true
  },
  {
    "start": 1244.2,
    "duration": 5,
    "text": "上屆聽奧女雙拿下一面銀牌",
    "hasSignLanguage": true
  },
  {
    "start": 1249.2,
    "duration": 3,
    "text": "混雙團體分別拿下銅牌",
    "hasSignLanguage": true
  },
  {
    "start": 1252.2,
    "duration": 4,
    "text": "而這次代表團幾乎以原班人馬出征",
