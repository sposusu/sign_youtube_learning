  },
  {
    "start": 1123.2,
    "duration": 2,
    "text": "還有多一點點戰術",
    "hasSignLanguage": false
  },
  {
    "start": 1125.2,
    "duration": 3,
    "text": "然後偶爾出去打比賽",
    "hasSignLanguage": false
  },
  {
    "start": 1128.2,
    "duration": 2,
    "text": "來加經驗",
    "hasSignLanguage": false
  },
  {
    "start": 1130.2,
    "duration": 3,
    "text": "上屆聽奧和林佳葷搭檔",
    "hasSignLanguage": false
  },
  {
    "start": 1133.2,
    "duration": 2,
    "text": "混雙奪下銀牌的王俊偉",
    "hasSignLanguage": false
  },
  {
    "start": 1135.2,
    "duration": 3,
    "text": "同樣是從2013年保加利亞索菲亞聽奧",
