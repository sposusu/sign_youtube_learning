  },
  {
    "start": 1268.2,
    "duration": 2,
    "text": "雙方打得勢均力敵",
    "hasSignLanguage": false
  },
  {
    "start": 1270.2,
    "duration": 3,
    "text": "但這次的混雙組合與上一屆有所不同",
