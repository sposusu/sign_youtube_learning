  },
  {
    "start": 996.2,
    "duration": 2,
    "text": "網球女將林佳葷",
    "hasSignLanguage": false
  },
  {
    "start": 998.2,
    "duration": 2,
    "text": "特別做了充滿臺灣元素的",
