  },
  {
    "start": 1162.2,
    "duration": 2,
    "text": "年輕選手體能出色",
    "hasSignLanguage": false
  },
  {
    "start": 1164.2,
    "duration": 3,
    "text": "但在戰術觀念上仍需要經驗累積",
    "hasSignLanguage": false
  },
  {
    "start": 1167.2,
    "duration": 2,
    "text": "因此兩個人訓練時不斷磨合",
