  },
  {
    "start": 1030.2,
    "duration": 2,
    "text": "用行動告訴世界",
    "hasSignLanguage": false
  },
  {
    "start": 1032.2,
    "duration": 2,
    "text": "障礙無法阻擋夢想",
    "hasSignLanguage": false
  },
  {
    "start": 1034.2,
    "duration": 4,
    "text": "公視新聞陳佳馨張子嘉臺北報導",
