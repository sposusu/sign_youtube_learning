  },
  {
    "start": 1077.2,
    "duration": 3,
    "text": "就一路征戰至今的資深選手",
    "hasSignLanguage": true
  },
  {
    "start": 1080.2,
    "duration": 3,
    "text": "林佳葷與王俊偉",
    "hasSignLanguage": true
  },
  {
    "start": 1083.2,
    "duration": 5,
    "text": "也將帶領新生代全力拼戰東京聽奧",
    "hasSignLanguage": true
  },
  {
    "start": 1088.2,
    "duration": 4,
    "text": "站好腳步 眼神緊盯每一顆球",
    "hasSignLanguage": true
  },
  {
    "start": 1092.2,
    "duration": 3,
    "text": "上一屆奪下一金二銀的林佳葷",
    "hasSignLanguage": false
  },
  {
    "start": 1095.2,
    "duration": 2,
    "text": "特別加強往前階級訓練",
    "hasSignLanguage": false
  },
  {
    "start": 1097.2,
    "duration": 4,
    "text": "自2013年起連續四屆參加聽奧的她",
    "hasSignLanguage": false
  },
  {
    "start": 1101.2,
    "duration": 1,
    "text": "經驗豐富",
