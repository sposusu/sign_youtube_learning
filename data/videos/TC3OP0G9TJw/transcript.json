  },
  {
    "start": 1172.2,
    "duration": 3,
    "text": "不管是在做球",
    "hasSignLanguage": false
  },
  {
    "start": 1175.2,
    "duration": 2,
    "text": "或者是說搶球",
    "hasSignLanguage": false
  },
  {
    "start": 1177.2,
    "duration": 4,
    "text": "或者是說我們在補位的時候",
    "hasSignLanguage": false
  },
  {
    "start": 1181.2,
    "duration": 2,
    "text": "我覺得會比較難一點",
    "hasSignLanguage": false
  },
  {
    "start": 1183.2,
    "duration": 2,
    "text": "因為有時候球來得太快了",
    "hasSignLanguage": false
  },
  {
    "start": 1185.2,
    "duration": 2,
    "text": "然後就是有點沒辦法說",
    "hasSignLanguage": false
  },
  {
    "start": 1187.2,
    "duration": 4,
    "text": "我這時候要變得說我很果斷",
    "hasSignLanguage": false
  },
  {
    "start": 1191.2,
    "duration": 3,
    "text": "男子網球隊這屆新增兩名新人",
    "hasSignLanguage": false
  },
  {
    "start": 1194.2,
    "duration": 2,
    "text": "面對聽奧舞台",
    "hasSignLanguage": false
  },
  {
    "start": 1196.2,
    "duration": 4,
    "text": "各個摩拳擦掌期待與各國好手競技",
    "hasSignLanguage": false
  },
  {
    "start": 1200.2,
    "duration": 3,
    "text": "對於兩位資深的去待年輕的",
