[
  {
    "sequence": 1,
    "start": 0,
    "duration": 12,
    "text": "MING PAO CANADA | MING PAO TORONTO"
  },
  {
    "sequence": 2,
    "start": 12,
    "duration": 2,
    "text": "看新聞 開視野"
  },
  {
    "sequence": 3,
    "start": 14,
    "duration": 6,
    "text": "歡迎收看今天9月4號的公視手語新聞"
  },
  {
    "sequence": 4,
    "start": 20,
    "duration": 2,
    "text": "首先來關心"
  },
  {
    "sequence": 5,
    "start": 22,
    "duration": 5,
    "text": "中共昨天舉行九三閱兵"
  },
  {
    "sequence": 6,
    "start": 27,
    "duration": 5,
    "text": "中國國家主席習近平與俄羅斯總統普廷"
  },
  {
    "sequence": 7,
    "start": 32,
    "duration": 5,
    "text": "北韓領導人金正恩三人同台亮相"
  },
  {
    "sequence": 8,
    "start": 37,
    "duration": 7,
    "text": "現場還秀出了多項新型武器和戰略核武"
  },
  {
    "sequence": 9,
    "start": 44,
    "duration": 4,
    "text": "對外展現嚇阻力道"
  },
  {
    "sequence": 10,
    "start": 48,
    "duration": 3,
    "text": "而我方陸委會則批判"
  },
  {
    "sequence": 11,
    "start": 51,
    "duration": 3,
    "text": "中共對抗戰沒有貢獻"
  },
  {
    "sequence": 12,
    "start": 54,
    "duration": 3,
    "text": "不管慶祝活動有多麼盛大"
  },
  {
    "sequence": 13,
    "start": 57,
    "duration": 3,
    "text": "都無法掩蓋歷史事實"
  },
  {
    "sequence": 14,
    "start": 60,
    "duration": 10,
    "text": "明放發射響禮炮揭開大會序幕"
  },
  {
    "sequence": 15,
    "start": 70,
    "duration": 3,
    "text": "中共舉行九三閱兵引起國際關注"
  },
  {
    "sequence": 16,
    "start": 73,
    "duration": 4,
    "text": "有26國的元首及國際組織領袖受邀出席"
  },
  {
    "sequence": 17,
    "start": 77,
    "duration": 4,
    "text": "中國國家主席習近平與其夫人彭麗媛親自迎接"
  },
  {
    "sequence": 18,
    "start": 81,
    "duration": 7,
    "text": "俄羅斯總統普廷 北韓領導人金正恩壓軸踏上紅毯"
  },
  {
    "sequence": 19,
    "start": 88,
    "duration": 2,
    "text": "與習近平互動熱絡"
  },
  {
    "sequence": 20,
    "start": 90,
    "duration": 4,
    "text": "三人一同登上天安門城樓 首度同台亮相"
  },
  {
    "sequence": 21,
    "start": 94,
    "duration": 3,
    "text": "至於前國民黨主席洪秀柱面對陸委會譴責"
  },
  {
    "sequence": 22,
    "start": 97,
    "duration": 3,
    "text": "仍出席九三閱兵 現蹤觀禮台"
  },
  {
    "sequence": 23,
    "start": 100,
    "duration": 3,
    "text": "習近平一身中山裝效仿前領導人毛澤東"
  },
  {
    "sequence": 24,
    "start": 103,
    "duration": 4,
    "text": "發表談話提及中國堅持走和平發展道路"
  },
  {
    "sequence": 25,
    "start": 107,
    "duration": 3,
    "text": "指世界面臨和平與戰爭對話與衝突的對立"
  },
  {
    "sequence": 26,
    "start": 110,
    "duration": 4,
    "text": "要加快建軍 習近平談話隻字未提台灣"
  },
  {
    "sequence": 27,
    "start": 114,
    "duration": 2,
    "text": "但緊扣維護國家主權"
  },
  {
    "sequence": 28,
    "start": 116,
    "duration": 4,
    "text": "加快建設世界一流軍隊"
  },
  {
    "sequence": 29,
    "start": 120,
    "duration": 7,
    "text": "堅決維護國家主權統一 領土完整"
  },
  {
    "sequence": 30,
    "start": 127,
    "duration": 3,
    "text": "習近平隨後登上紅旗檢閱車檢閱部隊"
  },
  {
    "sequence": 31,
    "start": 130,
    "duration": 4,
    "text": "地面有各式戰甲車 無人機 無人艇部隊"
  },
  {
    "sequence": 32,
    "start": 134,
    "duration": 2,
    "text": "應急系列反艦飛彈"
  },
  {
    "sequence": 33,
    "start": 136,
    "duration": 5,
    "text": "空中則有殲35匿蹤戰機 空警600艦載型預警機首度現身"
  },
  {
    "sequence": 34,
    "start": 141,
    "duration": 5,
    "text": "其中中共集中展示陸海空的戰略核武"
  },
  {
    "sequence": 35,
    "start": 146,
    "duration": 3,
    "text": "包括金雷一 巨浪三 東風61導彈"
  },
  {
    "sequence": 36,
    "start": 149,
    "duration": 2,
    "text": "展現強大嚇阻力道"
  },
  {
    "sequence": 37,
    "start": 151,
    "duration": 3,
    "text": "外界解讀 威嚇美國為首的西方國家"
  },
  {
    "sequence": 38,
    "start": 154,
    "duration": 2,
    "text": "這樣的一個恐嚇的作為"
  },
  {
    "sequence": 39,
    "start": 156,
    "duration": 2,
    "text": "當然也可能會被中共拿來運用"
  },
  {
    "sequence": 40,
    "start": 158,
    "duration": 3,
    "text": "就是去減緩西方在台灣有事的時候"
  },
  {
    "sequence": 41,
    "start": 161,
    "duration": 3,
    "text": "去介入的時間力道跟它的速度"
  },
  {
    "sequence": 42,
    "start": 164,
    "duration": 3,
    "text": "共軍也首度曝光750公里戰術飛彈"
  },
  {
    "sequence": 43,
    "start": 167,
    "duration": 3,
    "text": "國防部前視察盧德允分析"
  },
  {
    "sequence": 44,
    "start": 170,
    "duration": 3,
    "text": "若用於台海作戰 火力恐涵蓋台灣本道"
  },
  {
    "sequence": 45,
    "start": 173,
    "duration": 2,
    "text": "考驗國軍防空火網"
  },
  {
    "sequence": 46,
    "start": 175,
    "duration": 3,
    "text": "針對中共試圖搶奪抗戰勝利話語權"
  },
  {
    "sequence": 47,
    "start": 178,
    "duration": 2,
    "text": "陸委會則強烈反駁"
  },
  {
    "sequence": 48,
    "start": 180,
    "duration": 2,
    "text": "中共只圖擴大自身勢力"
  },
  {
    "sequence": 49,
    "start": 182,
    "duration": 2,
    "text": "對戰事並沒有貢獻"
  },
  {
    "sequence": 50,
    "start": 184,
    "duration": 3,
    "text": "不管中共花多少資源辦清楚活動"
  },
  {
    "sequence": 51,
    "start": 187,
    "duration": 2,
    "text": "都掩蓋不了鐵一般的歷史事實"
  },
  {
    "sequence": 52,
    "start": 189,
    "duration": 2,
    "text": "它會希望去傳達給美國的是說"
  },
  {
    "sequence": 53,
    "start": 191,
    "duration": 4,
    "text": "你美國你既然有第一島鏈的日韓"
  },
  {
    "sequence": 54,
    "start": 195,
    "duration": 2,
    "text": "菲律賓 台灣跟澳洲"
  },
  {
    "sequence": 55,
    "start": 197,
    "duration": 3,
    "text": "那我自己這一邊我也有一個北朝鮮"
  },
  {
    "sequence": 56,
    "start": 200,
    "duration": 3,
    "text": "加我中國加俄羅斯這樣子的一個佈局"
  },
  {
    "sequence": 57,
    "start": 203,
    "duration": 2,
    "text": "震盪中共閱兵的敏感時刻"
  },
  {
    "sequence": 58,
    "start": 205,
    "duration": 3,
    "text": "傳出一艘美國公務船三號陷中台海"
  },
  {
    "sequence": 59,
    "start": 208,
    "duration": 2,
    "text": "穿越海峽中線"
  },
  {
    "sequence": 60,
    "start": 210,
    "duration": 3,
    "text": "對此國防部回應相關情況純屬異色"
  },
  {
    "sequence": 61,
    "start": 213,
    "duration": 3,
    "text": "公司新聞黃子杰 吳嘉寶 台北報導"
  },
  {
    "sequence": 62,
    "start": 216,
    "duration": 4,
    "text": "俄羅斯總統普廷與北韓領導人"
  },
  {
    "sequence": 63,
    "start": 220,
    "duration": 4,
    "text": "金正恩在出席完大閱兵之後"
  },
  {
    "sequence": 64,
    "start": 224,
    "duration": 3,
    "text": "隨即展開會晤"
  },
  {
    "sequence": 65,
    "start": 227,
    "duration": 4,
    "text": "金正恩表示願意盡最大努力"
  },
  {
    "sequence": 66,
    "start": 231,
    "duration": 4,
    "text": "幫助俄羅斯解決任何困難"
  },
  {
    "sequence": 67,
    "start": 235,
    "duration": 3,
    "text": "而普廷在記者會上也首度鬆口"
  },
  {
    "sequence": 68,
    "start": 238,
    "duration": 2,
    "text": "願意在條件成熟下"
  },
  {
    "sequence": 69,
    "start": 240,
    "duration": 3,
    "text": "與烏克蘭總統澤倫斯基會面"
  },
  {
    "sequence": 70,
    "start": 243,
    "duration": 3,
    "text": "但要澤倫斯基親自到莫斯科"
  },
  {
    "sequence": 71,
    "start": 247,
    "duration": 3,
    "text": "在一同出席紀念二戰勝利80周年的大閱兵後"
  },
  {
    "sequence": 72,
    "start": 250,
    "duration": 4,
    "text": "俄羅斯總統普廷和北韓領導人金正恩搭同一輛車"
  },
  {
    "sequence": 73,
    "start": 254,
    "duration": 2,
    "text": "前往釣魚台國賓館會談"
  },
  {
    "sequence": 74,
    "start": 256,
    "duration": 4,
    "text": "這是金正恩掌權以來首次參加重大多邊場合"
  },
  {
    "sequence": 75,
    "start": 260,
    "duration": 2,
    "text": "也首度跟中俄領導人同台"
  },
  {
    "sequence": 76,
    "start": 262,
    "duration": 3,
    "text": "雙方在會談中針對加強合作表態"
  },
  {
    "sequence": 77,
    "start": 265,
    "duration": 4,
    "text": "普廷也盛讚北韓部隊曾與俄軍並肩作戰"
  },
  {
    "sequence": 78,
    "start": 277,
    "duration": 11,
    "text": "(俄語)"
  },
  {
    "sequence": 79,
    "start": 288,
    "duration": 1,
    "text": "根據南韓研判"
  },
  {
    "sequence": 80,
    "start": 289,
    "duration": 3,
    "text": "北韓從去年以來已派遣大約一萬五千名士兵"
  },
  {
    "sequence": 81,
    "start": 292,
    "duration": 3,
    "text": "並向俄羅斯提供飛彈與火炮支援"
  },
  {
    "sequence": 82,
    "start": 295,
    "duration": 4,
    "text": "普廷稍後在北京舉行的記者會上談到二無局勢"
  },
  {
    "sequence": 83,
    "start": 299,
    "duration": 4,
    "text": "他表示不會以領土交換來換取烏克蘭的安全保證"
  },
  {
    "sequence": 84,
    "start": 303,
    "duration": 4,
    "text": "也認為烏克蘭總統澤倫斯基應該赴莫斯科跟他會面"
  },
  {
    "sequence": 85,
    "start": 332,
    "duration": 1,
    "text": "除了與金正恩的會談"
  },
  {
    "sequence": 86,
    "start": 333,
    "duration": 2,
    "text": "普廷還參與上和組織相關活動"
  },
  {
    "sequence": 87,
    "start": 335,
    "duration": 2,
    "text": "並與多國領導人互動"
  },
  {
    "sequence": 88,
    "start": 337,
    "duration": 3,
    "text": "他再次強調上和組織並非針對任何一方"
  },
  {
    "sequence": 89,
    "start": 340,
    "duration": 2,
    "text": "而是以合作為核心"
  },
  {
    "sequence": 90,
    "start": 363,
    "duration": 2,
    "text": "普廷與金正恩在北京的會晤"
  },
  {
    "sequence": 91,
    "start": 365,
    "duration": 2,
    "text": "不僅展現雙邊緊密關係"
  },
  {
    "sequence": 92,
    "start": 367,
    "duration": 2,
    "text": "也釋放出對外界的正式訊號"
  },
  {
    "sequence": 93,
    "start": 369,
    "duration": 4,
    "text": "除了金正恩可能與中國國家主席習近平舉行雙邊會談"
  },
  {
    "sequence": 94,
    "start": 373,
    "duration": 3,
    "text": "甚至傳出有望舉行中二潮三方會晤"
  },
  {
    "sequence": 95,
    "start": 376,
    "duration": 3,
    "text": "國際社會將高度關注這三位領導人的互動"
  },
  {
    "sequence": 96,
    "start": 379,
    "duration": 3,
    "text": "是否會進一步挑戰現有的國際秩序"
  },
  {
    "sequence": 97,
    "start": 382,
    "duration": 2,
    "text": "公視新聞政委人鍾建剛編譯"
  },
  {
    "sequence": 98,
    "start": 392,
    "duration": 2,
    "text": "中列詞秋季"
  },
  {
    "sequence": 99,
    "start": 394,
    "duration": 3,
    "text": "更透過臉書發文"
  },
  {
    "sequence": 100,
    "start": 397,
    "duration": 5,
    "text": "強調台灣人熱愛和平"
  },
  {
    "sequence": 101,
    "start": 402,
    "duration": 2,
    "text": "不拿槍桿子紀念"
  },
  {
    "sequence": 102,
    "start": 404,
    "duration": 2,
    "text": "而是緬懷賢烈"
  },
  {
    "sequence": 103,
    "start": 406,
    "duration": 10,
    "text": "九三聚人節這一天"
  },
  {
    "sequence": 104,
    "start": 416,
    "duration": 2,
    "text": "總統賴清德上午前往圓山中列詞"
  },
  {
    "sequence": 105,
    "start": 418,
    "duration": 2,
    "text": "主持秋季典禮擔任主計官"
  },
  {
    "sequence": 106,
    "start": 420,
    "duration": 3,
    "text": "並由副總統蕭美琴及五院代表配機"
  },
  {
    "sequence": 107,
    "start": 423,
    "duration": 5,
    "text": "到了奏國歌環節"
  },
  {
    "sequence": 108,
    "start": 428,
    "duration": 3,
    "text": "後方的立法院長韓國瑜最新明顯"
  },
  {
    "sequence": 109,
    "start": 431,
    "duration": 2,
    "text": "賴笑兩人相較含蓄"
  },
  {
    "sequence": 110,
    "start": 433,
    "duration": 2,
    "text": "不過賴總統則在臉書發文"
  },
  {
    "sequence": 111,
    "start": 435,
    "duration": 3,
    "text": "表示台灣人民熱愛和平不拿槍桿子紀念"
  },
  {
    "sequence": 112,
    "start": 438,
    "duration": 2,
    "text": "而是緬懷賢烈記取歷史的教訓"
  },
  {
    "sequence": 113,
    "start": 440,
    "duration": 3,
    "text": "相信手中的裝備是用來保衛國家"
  },
  {
    "sequence": 114,
    "start": 443,
    "duration": 2,
    "text": "不是用來侵略擴張"
  },
  {
    "sequence": 115,
    "start": 447,
    "duration": 3,
    "text": "陸軍司令部則在前一晚推出嶄新陸軍的形象影片"
  },
  {
    "sequence": 116,
    "start": 450,
    "duration": 3,
    "text": "甚至忠實呈現了M1A2T戰車"
  },
  {
    "sequence": 117,
    "start": 453,
    "duration": 2,
    "text": "海馬士多管火箭等訓練畫面"
  },
  {
    "sequence": 118,
    "start": 455,
    "duration": 2,
    "text": "要展示新式武器裝備籌勃"
  },
  {
    "sequence": 119,
    "start": 457,
    "duration": 3,
    "text": "以及實戰化訓練的階段成果"
  },
  {
    "sequence": 120,
    "start": 460,
    "duration": 3,
    "text": "而九三軍人節的由來"
  },
  {
    "sequence": 121,
    "start": 463,
    "duration": 2,
    "text": "其實是民國34年9月2日"
  },
  {
    "sequence": 122,
    "start": 465,
    "duration": 3,
    "text": "日本簽訂降伏文書向同盟國投降"
  },
  {
    "sequence": 123,
    "start": 468,
    "duration": 2,
    "text": "標誌著二戰的終結"
  },
  {
    "sequence": 124,
    "start": 470,
    "duration": 2,
    "text": "隔年國民政府將每年的9月3日"
  },
  {
    "sequence": 125,
    "start": 472,
    "duration": 2,
    "text": "定為抗戰勝利紀念日"
  },
  {
    "sequence": 126,
    "start": 474,
    "duration": 3,
    "text": "並在民國44年為了增進三軍團結"
  },
  {
    "sequence": 127,
    "start": 477,
    "duration": 3,
    "text": "定為軍人節表彰國軍烈士的犧牲"
  },
  {
    "sequence": 128,
    "start": 480,
    "duration": 2,
    "text": "國民黨則是不滿賴總統以終戰形容"
  },
  {
    "sequence": 129,
    "start": 482,
    "duration": 2,
    "text": "卻絕口不提抗戰二字"
  },
  {
    "sequence": 130,
    "start": 505,
    "duration": 3,
    "text": "藍營強調80年前的抗戰毫無疑問"
  },
  {
    "sequence": 131,
    "start": 508,
    "duration": 3,
    "text": "是中華民國政府領導國軍迎戰日軍"
  },
  {
    "sequence": 132,
    "start": 511,
    "duration": 2,
    "text": "而親民黨主席宋楚瑜"
  },
  {
    "sequence": 133,
    "start": 513,
    "duration": 2,
    "text": "也對中共刻意選在九三這天"
  },
  {
    "sequence": 134,
    "start": 515,
    "duration": 3,
    "text": "舉辦閱兵與眾欣賞向對岸喊話"
  },
  {
