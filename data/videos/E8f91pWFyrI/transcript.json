[
  {
    "sequence": 1,
    "start": 0,
    "duration": 12,
    "text": "[音樂]"
  },
  {
    "sequence": 2,
    "start": 12,
    "duration": 2,
    "text": "看新聞、開視野"
  },
  {
    "sequence": 3,
    "start": 14,
    "duration": 5,
    "text": "歡迎收看今天10月27號的公視手語新聞"
  },
  {
    "sequence": 4,
    "start": 19,
    "duration": 2,
    "text": "首先來關心"
  },
  {
    "sequence": 5,
    "start": 21,
    "duration": 4,
    "text": "為了防堵非洲豬瘟疫情擴散"
  },
  {
    "sequence": 6,
    "start": 25,
    "duration": 3,
    "text": "行政府長卓榮泰昨天宣布"
  },
  {
    "sequence": 7,
    "start": 28,
    "duration": 6,
    "text": "全國豬隻禁運、禁載再延長10天"
  },
  {
    "sequence": 8,
    "start": 34,
    "duration": 7,
    "text": "而昨天是完成了5441家養豬場訪視工作"
  },
  {
    "sequence": 9,
    "start": 41,
    "duration": 2,
    "text": "檢測都過關"
  },
  {
    "sequence": 10,
    "start": 43,
    "duration": 5,
    "text": "今天會開始進行第二輪的查訪"
  },
  {
    "sequence": 11,
    "start": 48,
    "duration": 4,
    "text": "而另外對於檢出非洲豬瘟"
  },
  {
    "sequence": 12,
    "start": 52,
    "duration": 2,
    "text": "未在無期的這家養豬場"
  },
  {
    "sequence": 13,
    "start": 54,
    "duration": 3,
    "text": "有和兩位獸醫師合作"
  },
  {
    "sequence": 14,
    "start": 57,
    "duration": 3,
    "text": "其中一位王姓人員"
  },
  {
    "sequence": 15,
    "start": 60,
    "duration": 2,
    "text": "有獸醫佐的證書"
  },
  {
    "sequence": 16,
    "start": 62,
    "duration": 4,
    "text": "但是沒有獸醫職業執照"
  },
  {
    "sequence": 17,
    "start": 66,
    "duration": 4,
    "text": "將交由檢調來協助查查"
  },
  {
    "sequence": 18,
    "start": 70,
    "duration": 4,
    "text": "台中無期確定出現非洲豬瘟疫情"
  },
  {
    "sequence": 19,
    "start": 74,
    "duration": 2,
    "text": "台中市東寶說26號持續"
  },
  {
    "sequence": 20,
    "start": 76,
    "duration": 3,
    "text": "在台中採檢抽樣30個養豬場"
  },
  {
    "sequence": 21,
    "start": 79,
    "duration": 2,
    "text": "也消毒了31場"
  },
  {
    "sequence": 22,
    "start": 81,
    "duration": 2,
    "text": "而經過台中市府清查"
  },
  {
    "sequence": 23,
    "start": 83,
    "duration": 2,
    "text": "詮釋168場養豬場"
  },
  {
    "sequence": 24,
    "start": 85,
    "duration": 2,
    "text": "其中16場為停養狀態"
  },
  {
    "sequence": 25,
    "start": 87,
    "duration": 2,
    "text": "其餘包括40個關聯場"
  },
  {
    "sequence": 26,
    "start": 89,
    "duration": 1,
    "text": "檢測都是陰性"
  },
  {
    "sequence": 27,
    "start": 90,
    "duration": 3,
    "text": "而行政府長卓榮泰也主持防疫會議"
  },
  {
    "sequence": 28,
    "start": 93,
    "duration": 4,
    "text": "宣布全國阻止禁運禁載再延長10天"
  },
  {
    "sequence": 29,
    "start": 97,
    "duration": 1,
    "text": "在潛伏期間"
  },
  {
    "sequence": 30,
    "start": 98,
    "duration": 2,
    "text": "除了不能大意之外"
  },
  {
    "sequence": 31,
    "start": 100,
    "duration": 2,
    "text": "是沒有太多的異狀的"
  },
  {
    "sequence": 32,
    "start": 102,
    "duration": 4,
    "text": "我們要延長整個禁運禁載的時間"
  },
  {
    "sequence": 33,
    "start": 106,
    "duration": 3,
    "text": "10天再延長10天"
  },
  {
    "sequence": 34,
    "start": 109,
    "duration": 1,
    "text": "卓榮泰強調"
  },
  {
    "sequence": 35,
    "start": 110,
    "duration": 1,
    "text": "第一階段的防疫作戰"
  },
  {
    "sequence": 36,
    "start": 111,
    "duration": 2,
    "text": "已經初步掌握疫情範圍"
  },
  {
    "sequence": 37,
    "start": 113,
    "duration": 2,
    "text": "但目前還是處於潛伏期"
  },
  {
    "sequence": 38,
    "start": 115,
    "duration": 1,
    "text": "防疫不可輕忽"
  },
  {
    "sequence": 39,
    "start": 116,
    "duration": 2,
    "text": "也宣布落實疫調"
  },
  {
    "sequence": 40,
    "start": 118,
    "duration": 2,
    "text": "除於清運安全有序"
  },
  {
    "sequence": 41,
    "start": 120,
    "duration": 2,
    "text": "以及嚴守邊境等措施"
  },
  {
    "sequence": 42,
    "start": 122,
    "duration": 3,
    "text": "27號起展開第二輪的訪查疫調"
  },
  {
    "sequence": 43,
    "start": 125,
    "duration": 1,
    "text": "除於處理的部分"
  },
  {
    "sequence": 44,
    "start": 126,
    "duration": 3,
    "text": "將全面清查全國435家"
  },
  {
    "sequence": 45,
    "start": 129,
    "duration": 3,
    "text": "除於養豬場的珍珠設備及過程"
  },
  {
    "sequence": 46,
    "start": 132,
    "duration": 2,
    "text": "未來會加強查核標準"
  },
  {
    "sequence": 47,
    "start": 134,
    "duration": 2,
    "text": "而環境部也到台中文山掩埋場"
  },
  {
    "sequence": 48,
    "start": 136,
    "duration": 2,
    "text": "了解除於處理的方式"
  },
  {
    "sequence": 49,
    "start": 138,
    "duration": 2,
    "text": "直接在他們幾個地方"
  },
  {
    "sequence": 50,
    "start": 140,
    "duration": 2,
    "text": "進行直接的一個掩埋"
  },
  {
    "sequence": 51,
    "start": 142,
    "duration": 2,
    "text": "最重要的是說這個掩埋"
  },
  {
    "sequence": 52,
    "start": 144,
    "duration": 2,
    "text": "必須每日要進行復土"
  },
  {
    "sequence": 53,
    "start": 146,
    "duration": 2,
    "text": "能夠來避免這個蚊蠅"
  },
  {
    "sequence": 54,
    "start": 148,
    "duration": 3,
    "text": "或是野生動物跑進來覓食"
  },
  {
    "sequence": 55,
    "start": 151,
    "duration": 1,
    "text": "根據規定"
  },
  {
    "sequence": 56,
    "start": 152,
    "duration": 2,
    "text": "除於餵養豬隻必須以90度"
  },
  {
    "sequence": 57,
    "start": 154,
    "duration": 2,
    "text": "珍珠超過一個小時以上"
  },
  {
    "sequence": 58,
    "start": 156,
    "duration": 1,
    "text": "並回傳資料"
  },
  {
    "sequence": 59,
    "start": 157,
    "duration": 1,
    "text": "但環境部指出"
  },
  {
    "sequence": 60,
    "start": 158,
    "duration": 2,
    "text": "無期乾養豬場"
  },
  {
    "sequence": 61,
    "start": 160,
    "duration": 2,
    "text": "8月沒有任何的上傳紀錄"
  },
  {
    "sequence": 62,
    "start": 162,
    "duration": 3,
    "text": "轄管的台中市府卻只有兩次查訪"
  },
  {
    "sequence": 63,
    "start": 165,
    "duration": 1,
    "text": "不符合規定"
  },
  {
    "sequence": 64,
    "start": 166,
    "duration": 3,
    "text": "是否和疫情有關將由農業部來調查"
  },
  {
    "sequence": 65,
    "start": 169,
    "duration": 2,
    "text": "而無期養豬場也因為檢驗期"
  },
  {
    "sequence": 66,
    "start": 171,
    "duration": 2,
    "text": "出現10天的空窗期"
  },
  {
    "sequence": 67,
    "start": 173,
    "duration": 1,
    "text": "備受質疑"
  },
  {
    "sequence": 68,
    "start": 174,
    "duration": 3,
    "text": "是否也將對該豬場的兩位獸醫來調查"
  },
  {
    "sequence": 69,
    "start": 177,
    "duration": 3,
    "text": "我想他們的這個執行過程"
  },
  {
    "sequence": 70,
    "start": 180,
    "duration": 2,
    "text": "有沒有違反相關的規定"
  },
  {
    "sequence": 71,
    "start": 182,
    "duration": 1,
    "text": "我們已經啟動調查"
  },
  {
    "sequence": 72,
    "start": 183,
    "duration": 3,
    "text": "必要時我們會移送檢調來調查"
  },
  {
    "sequence": 73,
    "start": 186,
    "duration": 2,
    "text": "另外非洲豬瘟的感染源"
  },
  {
    "sequence": 74,
    "start": 188,
    "duration": 1,
    "text": "疑似就是來自"
  },
  {
    "sequence": 75,
    "start": 189,
    "duration": 2,
    "text": "無期清潔隊所提供的除餘"
  },
  {
    "sequence": 76,
    "start": 191,
    "duration": 1,
    "text": "環保局表示"
  },
  {
    "sequence": 77,
    "start": 192,
    "duration": 2,
    "text": "除餘都是畜牧場依法來飆售"
  },
  {
    "sequence": 78,
    "start": 194,
    "duration": 2,
    "text": "而行政府強調"
  },
  {
    "sequence": 79,
    "start": 196,
    "duration": 2,
    "text": "未來10天將以5天為一個階段"
  },
  {
    "sequence": 80,
    "start": 198,
    "duration": 2,
    "text": "來擬定作戰計畫並滾動檢討"
  },
  {
    "sequence": 81,
    "start": 200,
    "duration": 2,
    "text": "防堵疫情擴散"
  },
  {
    "sequence": 82,
    "start": 202,
    "duration": 2,
    "text": "公司鮮武林健身棚患群"
  },
  {
    "sequence": 83,
    "start": 204,
    "duration": 2,
    "text": "台中報導"
  },
  {
    "sequence": 84,
    "start": 206,
    "duration": 4,
    "text": "台灣爆發非洲豬瘟疫情"
  },
  {
    "sequence": 85,
    "start": 210,
    "duration": 2,
    "text": "有立委擔心"
  },
  {
    "sequence": 86,
    "start": 212,
    "duration": 4,
    "text": "淘寶等境外電商販售的肉製品"
  },
  {
    "sequence": 87,
    "start": 216,
    "duration": 4,
    "text": "可能會夾帶病毒進來台灣"
  },
  {
    "sequence": 88,
    "start": 220,
    "duration": 2,
    "text": "淘寶回應"
  },
  {
    "sequence": 89,
    "start": 222,
    "duration": 3,
    "text": "針對所有肉類製品"
  },
  {
    "sequence": 90,
    "start": 225,
    "duration": 7,
    "text": "實施台灣用戶阻斷下單等三重管控措施"
  },
  {
    "sequence": 91,
    "start": 232,
    "duration": 3,
    "text": "而中華郵政也表示"
  },
  {
    "sequence": 92,
    "start": 235,
    "duration": 3,
    "text": "相關包裹在進口投遞前"
  },
  {
    "sequence": 93,
    "start": 238,
    "duration": 3,
    "text": "都有先經過海關的查驗"
  },
  {
    "sequence": 94,
    "start": 241,
    "duration": 3,
    "text": "才完成檢疫"
  },
  {
    "sequence": 95,
    "start": 255,
    "duration": 3,
    "text": "通過小包裹衝關衝破防疫防線"
  },
  {
    "sequence": 96,
    "start": 258,
    "duration": 7,
    "text": "就怕境外電商可能成為防疫破口"
  },
  {
    "sequence": 97,
    "start": 265,
    "duration": 2,
    "text": "民進黨立委吳思耀指出"
  },
  {
    "sequence": 98,
    "start": 267,
    "duration": 2,
    "text": "行政部門應該趕快補破網"
  },
  {
    "sequence": 99,
    "start": 269,
    "duration": 3,
    "text": "研議嚴禁境外電商郵寄肉製品包裹"
  },
  {
    "sequence": 100,
    "start": 272,
    "duration": 2,
    "text": "強化海關查驗"
  },
  {
    "sequence": 101,
    "start": 285,
    "duration": 3,
    "text": "全面性的來從嚴管理"
  },
  {
    "sequence": 102,
    "start": 288,
    "duration": 3,
    "text": "該進就進該管就管該罰就罰"
  },
  {
    "sequence": 103,
    "start": 291,
    "duration": 2,
    "text": "吳思耀指出包含財政"
  },
  {
    "sequence": 104,
    "start": 293,
    "duration": 2,
    "text": "農業甚至是微發展部"
  },
  {
    "sequence": 105,
    "start": 295,
    "duration": 3,
    "text": "都應該跨部會動起來管理境外電商"
  },
  {
    "sequence": 106,
    "start": 298,
    "duration": 2,
    "text": "淘寶對外發聲明回應"
  },
  {
    "sequence": 107,
    "start": 300,
    "duration": 2,
    "text": "淘寶台灣站依循台灣法規"
  },
  {
    "sequence": 108,
    "start": 302,
    "duration": 3,
    "text": "針對肉類製品實施三重防護"
  },
  {
    "sequence": 109,
    "start": 305,
    "duration": 3,
    "text": "包含台灣IP用戶相關商品搜尋屏蔽"
  },
  {
    "sequence": 110,
    "start": 308,
    "duration": 2,
    "text": "台灣用戶阻斷下單"
  },
  {
    "sequence": 111,
    "start": 310,
    "duration": 2,
    "text": "以及台灣地址禁止運輸"
  },
  {
    "sequence": 112,
    "start": 312,
    "duration": 2,
    "text": "實際測試淘寶網頁"
  },
  {
    "sequence": 113,
    "start": 314,
    "duration": 3,
    "text": "想購買肉類製品都會跳出不可售"
  },
  {
    "sequence": 114,
    "start": 317,
    "duration": 2,
    "text": "或台灣地址官方物流不可運"
  },
  {
    "sequence": 115,
    "start": 319,
    "duration": 9,
    "text": "中華郵政指出相關包裹"
  },
  {
    "sequence": 116,
    "start": 328,
    "duration": 3,
    "text": "在進口投遞前都有先經過海關查驗"
  },
  {
    "sequence": 117,
    "start": 331,
    "duration": 2,
    "text": "檢疫完成清關後"
  },
  {
    "sequence": 118,
    "start": 333,
    "duration": 2,
    "text": "再由中華郵政以國內包裹投遞"
  },
  {
    "sequence": 119,
    "start": 335,
    "duration": 2,
    "text": "農業部長陳俊濟表示"
  },
  {
    "sequence": 120,
    "start": 337,
    "duration": 3,
    "text": "邊境會管制加嚴取締朝清零方向去做"
  },
  {
    "sequence": 121,
    "start": 344,
    "duration": 2,
    "text": "防堵疫區肉製品進到台灣"
  },
  {
    "sequence": 122,
    "start": 346,
    "duration": 2,
    "text": "陳俊濟表示防護不只光靠豬農"
  },
  {
    "sequence": 123,
    "start": 348,
    "duration": 3,
    "text": "也得仰賴全國消費者一起配合"
  },
  {
    "sequence": 124,
    "start": 351,
    "duration": 2,
    "text": "杜絕任何非洲豬瘟破口"
  },
  {
    "sequence": 125,
    "start": 353,
    "duration": 2,
    "text": "公視新聞由彥辭郭駒林臺報導"
  },
  {
    "sequence": 126,
    "start": 375,
    "duration": 3,
    "text": "業者喊冤說是誤會"
  },
  {
    "sequence": 127,
    "start": 378,
    "duration": 3,
    "text": "但是市府昨天駁斥"
  },
  {
    "sequence": 128,
    "start": 381,
    "duration": 5,
    "text": "指出業者先隱匿了貨車的位置"
  },
  {
    "sequence": 129,
    "start": 386,
    "duration": 5,
    "text": "謊稱指運送問題肉跟蝦子"
  },
  {
    "sequence": 130,
    "start": 391,
    "duration": 6,
    "text": "被追問之後才交出貨車GPS定位的資料"
  },
  {
    "sequence": 131,
    "start": 397,
    "duration": 5,
    "text": "而且車上還有674件貨品運送"
  },
  {
    "sequence": 132,
    "start": 402,
    "duration": 3,
    "text": "對於說謊隱匿的行為"
  },
  {
    "sequence": 133,
    "start": 405,
    "duration": 5,
    "text": "市府決定要重罰大榮300萬元"
  },
  {
    "sequence": 134,
    "start": 410,
    "duration": 3,
    "text": "勒令停業一周"
  },
  {
    "sequence": 135,
    "start": 413,
    "duration": 5,
    "text": "並且移送遞減署來進行偵辦"
  },
  {
    "sequence": 136,
    "start": 418,
    "duration": 5,
    "text": "一次污染貨品回收後"
  },
  {
    "sequence": 137,
    "start": 423,
    "duration": 2,
    "text": "被送往焚化爐銷毀"
  },
  {
    "sequence": 138,
    "start": 425,
    "duration": 3,
    "text": "家裡大榮貨運23號受彰化業者委託"
  },
  {
    "sequence": 139,
    "start": 428,
    "duration": 3,
    "text": "運送疑似非洲豬瘟肉品到高雄"
  },
  {
    "sequence": 140,
    "start": 431,
    "duration": 2,
    "text": "遭市府攔截裁罰"
  },
  {
    "sequence": 141,
    "start": 433,
    "duration": 2,
    "text": "業者25號晚間發聲明喊冤"
  },
  {
    "sequence": 142,
    "start": 435,
    "duration": 2,
    "text": "表示員工需調閱大量運輸資料"
  },
  {
    "sequence": 143,
    "start": 437,
    "duration": 1,
    "text": "才延誤回覆"
  },
  {
    "sequence": 144,
    "start": 438,
    "duration": 2,
    "text": "隔天就遭高市府駁斥"
  },
  {
    "sequence": 145,
    "start": 440,
    "duration": 15,
    "text": "23號下午"
  },
  {
    "sequence": 146,
    "start": 455,
    "duration": 3,
    "text": "問題豬肉正式送到業者的大發營業所"
  },
  {
    "sequence": 147,
    "start": 458,
    "duration": 3,
    "text": "但衛生局上門後業者拖了一個半小時"
  },
  {
    "sequence": 148,
    "start": 461,
    "duration": 2,
    "text": "才交代大貨車位置"
  },
  {
    "sequence": 149,
    "start": 463,
    "duration": 3,
    "text": "還謊稱車上只有問題豬肉跟蝦子"
  },
  {
    "sequence": 150,
    "start": 466,
    "duration": 4,
    "text": "但其實貨車還載了674件冷鏈等貨品"
  },
  {
    "sequence": 151,
    "start": 470,
    "duration": 2,
    "text": "要分送12個行政區"
  },
  {
    "sequence": 152,
    "start": 472,
    "duration": 13,
    "text": "高市府指控業者說謊隱匿"
  },
  {
    "sequence": 153,
    "start": 485,
    "duration": 2,
    "text": "延遲提供運送清單等行為"
  },
  {
    "sequence": 154,
    "start": 487,
    "duration": 3,
    "text": "以嚴重妨礙並延宕食安風險管控"
  },
  {
    "sequence": 155,
    "start": 490,
    "duration": 2,
    "text": "將依食安法重罰三百萬元"
  },
  {
    "sequence": 156,
    "start": 492,
    "duration": 3,
    "text": "勒令停業一週並移送地檢署偵辦"
  },
  {
    "sequence": 157,
    "start": 495,
    "duration": 2,
    "text": "但不只貨運公司對防疫輕忽大意"
  },
  {
    "sequence": 158,
    "start": 497,
    "duration": 2,
    "text": "臺南後幣也有養豬場"
  },
  {
    "sequence": 159,
    "start": 499,
    "duration": 2,
    "text": "24號還載運活豬移動"
  },
  {
    "sequence": 160,
    "start": 501,
    "duration": 11,
    "text": "農業部22號已禁運活豬"
  },
  {
    "sequence": 161,
    "start": 512,
    "duration": 3,
    "text": "豬農坦言不知道同豬場不能異地移動"
  },
  {
    "sequence": 162,
    "start": 515,
    "duration": 2,
    "text": "也會載13頭母豬要去百合分場"
  },
  {
    "sequence": 163,
    "start": 517,
    "duration": 4,
    "text": "東寶出貨報派人到兩個豬場訪視並消毒"
  },
  {
    "sequence": 164,
    "start": 521,
    "duration": 3,
    "text": "雖未發現異常但違反禁運令是事實"
  },
  {
    "sequence": 165,
    "start": 524,
    "duration": 2,
    "text": "後續也將依動物傳染病防治條例"
  },
  {
    "sequence": 166,
    "start": 526,
    "duration": 2,
    "text": "對豬農裁罰35萬"
  },
  {
    "sequence": 167,
    "start": 528,
    "duration": 3,
    "text": "公視新聞陳幻 孟昭犬 高雄臺南報導"
  },
  {
    "sequence": 168,
    "start": 545,
    "duration": 4,
    "text": "美中官員自25號起先展開了密集的磋商"
  },
  {
    "sequence": 169,
    "start": 549,
    "duration": 5,
    "text": "美方貿易代表指出雙方的談判順利"
  },
  {
    "sequence": 170,
    "start": 554,
    "duration": 6,
    "text": "並且表示中國將暫緩稀土出口管制"
  },
  {
    "sequence": 171,
    "start": 560,
    "duration": 3,
    "text": "並且恢復購買美國的黃豆"
  },
  {
    "sequence": 172,
    "start": 563,
    "duration": 5,
    "text": "而美國則不會對中方克徵百分之百關稅"
  },
  {
    "sequence": 173,
    "start": 568,
    "duration": 7,
    "text": "自由時報報導對於川普即將與習近平會晤"
  },
  {
    "sequence": 174,
    "start": 575,
    "duration": 2,
    "text": "美國國務卿表示"
  },
  {
    "sequence": 175,
    "start": 577,
    "duration": 3,
    "text": "不會為了與中國達成貿易協議"
  },
  {
    "sequence": 176,
    "start": 580,
    "duration": 3,
    "text": "而放棄支持台灣"
  },
  {
    "sequence": 177,
    "start": 583,
    "duration": 3,
    "text": "中國時報是提到了"
  },
  {
    "sequence": 178,
    "start": 586,
    "duration": 2,
    "text": "重安節快到了"
  },
  {
    "sequence": 179,
    "start": 588,
    "duration": 2,
    "text": "台北市有議員指出"
  },
  {
    "sequence": 180,
    "start": 590,
    "duration": 2,
    "text": "相較於台東"
  },
  {
    "sequence": 181,
    "start": 592,
    "duration": 3,
    "text": "每月匯入勁勞卡100%"
  },
  {
    "sequence": 182,
    "start": 595,
    "duration": 5,
    "text": "台東每月匯入勁勞卡1500點"
  },
  {
    "sequence": 183,
    "start": 600,
    "duration": 2,
    "text": "台中有1000點"
  },
  {
    "sequence": 184,
    "start": 602,
    "duration": 4,
    "text": "台北只有480點根本不夠用"
  },
  {
    "sequence": 185,
    "start": 606,
    "duration": 3,
    "text": "要求市府評估加碼"
  },
  {
    "sequence": 186,
    "start": 609,
    "duration": 2,
    "text": "而社會局則表示"
  },
  {
    "sequence": 187,
    "start": 611,
    "duration": 5,
    "text": "增加點數要考量預算將會嚴意改善"
  },
  {
    "sequence": 188,
    "start": 616,
    "duration": 3,
    "text": "看報紙重點繼續來關心"
  },
  {
    "sequence": 189,
    "start": 619,
    "duration": 3,
    "text": "為了遏止公務員違法到中國"
  },
  {
    "sequence": 190,
    "start": 622,
    "duration": 3,
    "text": "政府委員會日前宣布"
  },
  {
    "sequence": 191,
    "start": 625,
    "duration": 2,
    "text": "各機關公務人員"
  },
  {
    "sequence": 192,
    "start": 627,
    "duration": 2,
    "text": "包含學校的公務員"
  },
  {
    "sequence": 193,
    "start": 629,
    "duration": 4,
    "text": "要到中國、香港、還有澳門"
  },
  {
    "sequence": 194,
    "start": 633,
    "duration": 3,
    "text": "必須要事先通報"
  },
  {
    "sequence": 195,
    "start": 636,
    "duration": 3,
    "text": "違者將被懲處"
  },
  {
    "sequence": 196,
    "start": 639,
    "duration": 3,
    "text": "為了遏止公務員違法附錄的情形不斷發生"
  },
  {
    "sequence": 197,
    "start": 642,
    "duration": 2,
    "text": "陸委會9月公布修正公務員"
  },
  {
    "sequence": 198,
    "start": 644,
    "duration": 2,
    "text": "附錄港澳相關規範"
  },
  {
    "sequence": 199,
    "start": 646,
    "duration": 2,
    "text": "後續也把學校公務員納入"
  },
  {
    "sequence": 200,
    "start": 648,
    "duration": 3,
    "text": "相關公務人員附錄必須經過許可"
  },
  {
    "sequence": 201,
    "start": 651,
    "duration": 2,
    "text": "通報附錄事由跟行程"
  },
  {
    "sequence": 202,
    "start": 653,
    "duration": 3,
    "text": "維持情節重大一次計兩大過免職"
  },
  {
    "sequence": 203,
    "start": 656,
    "duration": 2,
    "text": "明年7月1日上路"
  },
  {
    "sequence": 204,
    "start": 658,
    "duration": 1,
    "text": "有特定身份的人"
  },
  {
    "sequence": 205,
    "start": 659,
    "duration": 2,
    "text": "不管是我方的人還是對方的人"
  },
  {
    "sequence": 206,
    "start": 661,
    "duration": 2,
    "text": "都會給予特別的規範限制"
  },
  {
    "sequence": 207,
    "start": 663,
    "duration": 2,
    "text": "這個是基於兩岸交流"
  },
  {
    "sequence": 208,
    "start": 665,
    "duration": 3,
    "text": "在一個對等和平尊嚴的基礎之上"
  },
  {
    "sequence": 209,
    "start": 668,
    "duration": 2,
    "text": "我們希望不要危及到國家的安全"
  },
  {
    "sequence": 210,
    "start": 670,
    "duration": 3,
    "text": "根據陸委會公布的建議懲處原則"
  },
  {
    "sequence": 211,
    "start": 673,
    "duration": 2,
    "text": "違規樣態包括未經許可附錄"
  },
  {
    "sequence": 212,
    "start": 675,
    "duration": 3,
    "text": "返台後沒有一線填具附錄人員"
  },
  {
    "sequence": 213,
    "start": 678,
    "duration": 1,
    "text": "返台通報表"
  },
  {
    "sequence": 214,
    "start": 679,
    "duration": 3,
    "text": "返台拒絕或沒有詳實說明事由跟行程"
  },
  {
    "sequence": 215,
    "start": 682,
    "duration": 2,
    "text": "基層違規三次計一次大過"
  },
  {
    "sequence": 216,
    "start": 684,
    "duration": 3,
    "text": "高階違規一次計兩次過"
  },
  {
    "sequence": 217,
    "start": 687,
    "duration": 1,
    "text": "不過再也立委質疑"
  },
  {
    "sequence": 218,
    "start": 688,
    "duration": 2,
    "text": "可能沒效果又擾民"
  },
  {
    "sequence": 219,
    "start": 690,
    "duration": 2,
    "text": "甚至出現寒蟬效應"
  },
  {
    "sequence": 220,
    "start": 692,
    "duration": 3,
    "text": "目的就是要讓學術界要近身"
  },
  {
    "sequence": 221,
    "start": 695,
    "duration": 2,
    "text": "製造更多的寒蟬效應"
  },
  {
    "sequence": 222,
    "start": 697,
    "duration": 3,
    "text": "未來幾首學者前往大陸交流訪問"
  },
  {
    "sequence": 223,
    "start": 700,
    "duration": 2,
    "text": "也會被貼上標籤"
  },
  {
    "sequence": 224,
    "start": 702,
    "duration": 2,
    "text": "行程自我審查的機制"
  },
  {
    "sequence": 225,
    "start": 704,
    "duration": 2,
    "text": "變成是在台灣內部找敵人"
  },
  {
    "sequence": 226,
    "start": 706,
    "duration": 4,
    "text": "而且也在升高兩岸的惡意的危險"
  },
  {
    "sequence": 227,
    "start": 710,
    "duration": 3,
    "text": "請陸委會不要一直只是"
  },
  {
    "sequence": 228,
    "start": 713,
    "duration": 3,
    "text": "在製造兩岸的緊張"
  },
  {
    "sequence": 229,
    "start": 716,
    "duration": 1,
    "text": "陸委會則回應"
  },
  {
    "sequence": 230,
    "start": 717,
    "duration": 2,
    "text": "依照兩岸條例第九條規定"
  },
  {
    "sequence": 231,
    "start": 719,
    "duration": 1,
    "text": "公務人員附錄"
  },
  {
    "sequence": 232,
    "start": 720,
    "duration": 1,
    "text": "按照職等高低不同"
  },
  {
    "sequence": 233,
    "start": 721,
    "duration": 2,
    "text": "分別必須經由內政部或"
  },
  {
    "sequence": 234,
    "start": 723,
    "duration": 2,
    "text": "服務機關許可後才可以附錄"
  },
  {
    "sequence": 235,
    "start": 725,
    "duration": 2,
    "text": "是依法行政"
  },
  {
    "sequence": 236,
    "start": 727,
    "duration": 3,
    "text": "也指出公立學校教師沒有兼任行政職務"
  },
  {
    "sequence": 237,
    "start": 730,
    "duration": 2,
    "text": "不用依照許可辦法或作業要點"
  },
  {
    "sequence": 238,
    "start": 732,
    "duration": 2,
    "text": "申請許可或報準"
  },
  {
    "sequence": 239,
    "start": 734,
    "duration": 3,
    "text": "公視新聞翁農 許家瑞 台北報導"
  },
  {
    "sequence": 240,
    "start": 737,
    "duration": 5,
    "text": "來關心醫療人員的工作環境"
  },
  {
    "sequence": 241,
    "start": 742,
    "duration": 1,
    "text": "根據調查"
  },
  {
    "sequence": 242,
    "start": 743,
    "duration": 3,
    "text": "住院醫師平均每個月工時"
  },
  {
    "sequence": 243,
    "start": 746,
    "duration": 3,
    "text": "經常超過300個小時"
  },
  {
    "sequence": 244,
    "start": 749,
    "duration": 3,
    "text": "醫師在面臨高壓的環境下"
  },
  {
    "sequence": 245,
    "start": 752,
    "duration": 2,
    "text": "還得無酬加班"
  },
  {
    "sequence": 246,
    "start": 754,
    "duration": 3,
    "text": "導致身心俱疲"
  },
  {
    "sequence": 247,
    "start": 757,
    "duration": 3,
    "text": "如果在制度面跟醫院的經營端"
  },
  {
    "sequence": 248,
    "start": 760,
    "duration": 2,
    "text": "不能夠立即改善"
  },
  {
    "sequence": 249,
    "start": 762,
    "duration": 5,
    "text": "醫師出走恐怕會對台灣醫療產生重大衝擊"
  },
  {
    "sequence": 250,
    "start": 767,
    "duration": 5,
    "text": "醫師疲憊的身影"
  },
  {
    "sequence": 251,
    "start": 772,
    "duration": 2,
    "text": "在腸腔中匆匆穿梭"
  },
  {
    "sequence": 252,
    "start": 774,
    "duration": 3,
    "text": "營造出台灣醫療的隱憂"
  },
  {
    "sequence": 253,
    "start": 777,
    "duration": 3,
    "text": "人力短缺 薪資降化與過度工時問題"
  },
  {
    "sequence": 254,
    "start": 780,
    "duration": 2,
    "text": "再度浮上檯面"
  },
  {
    "sequence": 255,
    "start": 782,
    "duration": 3,
    "text": "不能申報加班費 也沒有休息到"
  },
  {
    "sequence": 256,
    "start": 785,
    "duration": 2,
    "text": "老實說這對於病人安全來說"
  },
  {
    "sequence": 257,
    "start": 787,
    "duration": 1,
    "text": "不是一件好事"
  },
  {
    "sequence": 258,
    "start": 788,
    "duration": 3,
    "text": "超時的工作會增加決策的錯誤率"
  },
  {
    "sequence": 259,
    "start": 791,
    "duration": 3,
    "text": "這是我想大家顯而易見的事情"
  },
  {
    "sequence": 260,
    "start": 794,
    "duration": 3,
    "text": "根據勞動部的指引"
  },
  {
    "sequence": 261,
    "start": 797,
    "duration": 3,
    "text": "如果一個月工時超過276小時"
  },
  {
    "sequence": 262,
    "start": 800,
    "duration": 4,
    "text": "或連續兩個月平均超過256小時"
  },
  {
    "sequence": 263,
    "start": 804,
    "duration": 2,
    "text": "再發生中風與心肌梗塞"
  },
  {
    "sequence": 264,
    "start": 806,
    "duration": 3,
    "text": "就跟過勞高度相關"
  },
  {
    "sequence": 265,
    "start": 809,
    "duration": 3,
    "text": "然而不分科和住院醫師的工時"
  },
  {
    "sequence": 266,
    "start": 812,
    "duration": 3,
    "text": "普遍落在300至320小時"
  },
  {
    "sequence": 267,
    "start": 815,
    "duration": 3,
    "text": "遠遠超過這個門檻"
  },
  {
    "sequence": 268,
    "start": 818,
    "duration": 3,
    "text": "我自己經驗比較多是"
  },
  {
    "sequence": 269,
    "start": 821,
    "duration": 3,
    "text": "心肌的感覺在中段睡眠的時候比較明顯"
  },
  {
    "sequence": 270,
    "start": 824,
    "duration": 3,
    "text": "然後再就是注意力"
  },
  {
    "sequence": 271,
    "start": 827,
    "duration": 3,
    "text": "你可以知道注意力就是沒這麼的集中"
  },
  {
    "sequence": 272,
    "start": 830,
    "duration": 6,
    "text": "許多年輕醫師都曾經抱有憧憬"
  },
  {
    "sequence": 273,
    "start": 836,
    "duration": 3,
    "text": "一為熬過不分科醫師與住院醫師階段後"
  },
  {
    "sequence": 274,
    "start": 839,
    "duration": 3,
    "text": "工作壓力便會大幅減輕"
  },
  {
    "sequence": 275,
    "start": 842,
    "duration": 2,
    "text": "但現實便非如此"
  },
  {
    "sequence": 276,
    "start": 844,
    "duration": 2,
    "text": "醫治筆調查顯示"
  },
  {
    "sequence": 277,
    "start": 846,
    "duration": 2,
    "text": "主治醫師平均週工時"
  },
  {
    "sequence": 278,
    "start": 848,
    "duration": 2,
    "text": "仍達49小時"
  },
  {
    "sequence": 279,
    "start": 850,
    "duration": 1,
    "text": "即便工時稍降"
  },
  {
    "sequence": 280,
    "start": 851,
    "duration": 3,
    "text": "責任與壓力依舊沉重"
  },
  {
    "sequence": 281,
    "start": 854,
    "duration": 4,
    "text": "中小型的醫院我覺得主治醫師"
  },
  {
    "sequence": 282,
    "start": 858,
    "duration": 4,
    "text": "哪怕你是20年 30年的智力教授等級的"
  },
  {
    "sequence": 283,
    "start": 862,
    "duration": 3,
    "text": "都要去第一線去睡在醫院去值班"
  },
  {
    "sequence": 284,
    "start": 865,
    "duration": 6,
    "text": "這是以前很多科可能沒有這樣子的狀況"
  },
  {
    "sequence": 285,
    "start": 871,
    "duration": 5,
    "text": "集中症的這些任務實在是太龐大的壓力"
  },
  {
    "sequence": 286,
    "start": 876,
    "duration": 4,
    "text": "下面的人又越來越不願意走我們這個課"
  },
  {
    "sequence": 287,
    "start": 880,
    "duration": 2,
    "text": "所以就變成說"
  },
  {
    "sequence": 288,
    "start": 882,
    "duration": 5,
    "text": "無止盡的一直會去奉獻在醫院困在醫院"
  },
  {
    "sequence": 289,
    "start": 887,
    "duration": 4,
    "text": "目前已有部分醫院開始調整值班制度"
  },
  {
    "sequence": 290,
    "start": 891,
    "duration": 2,
    "text": "增聘護理與行政人員"
  },
  {
    "sequence": 291,
    "start": 893,
    "duration": 3,
    "text": "並逐步關注年輕醫師的需求"
  },
  {
    "sequence": 292,
    "start": 896,
    "duration": 3,
    "text": "當社會理解醫療工作者的辛勞"
  },
  {
    "sequence": 293,
    "start": 899,
    "duration": 3,
    "text": "並建立更友善的制度與合理的資源時"
  },
  {
    "sequence": 294,
    "start": 902,
    "duration": 3,
    "text": "醫師們才能繼續以專業與熱情"
  },
  {
    "sequence": 295,
    "start": 905,
    "duration": 3,
    "text": "守護病人的健康與生活品質"
  },
  {
    "sequence": 296,
    "start": 908,
    "duration": 4,
    "text": "記者袁紅書 顧展龍採訪報導"
  },
  {
    "sequence": 297,
    "start": 912,
    "duration": 3,
    "text": "新聞急檢來看到"
  },
  {
    "sequence": 298,
    "start": 915,
    "duration": 5,
    "text": "燕子口燕色湖持續進行減災工程"
  },
  {
    "sequence": 299,
    "start": 920,
    "duration": 3,
    "text": "昨天開挖深草線"
  },
  {
    "sequence": 300,
    "start": 923,
    "duration": 3,
    "text": "引流湖水已經有成效"
  },
  {
    "sequence": 301,
    "start": 927,
    "duration": 4,
    "text": "而另外 花蓮馬太安溪燕色湖"
  },
  {
    "sequence": 302,
    "start": 931,
    "duration": 2,
    "text": "釀災滿一個月之後"
  },
  {
    "sequence": 303,
    "start": 933,
    "duration": 4,
    "text": "各地到光復鄉的志工陸續退場"
  },
  {
    "sequence": 304,
    "start": 937,
    "duration": 3,
    "text": "花蓮縣府開始招募臨時工"
  },
  {
    "sequence": 305,
    "start": 940,
    "duration": 5,
    "text": "為期三個月實薪190元"
  },
  {
    "sequence": 306,
    "start": 945,
    "duration": 7,
    "text": "而另外 泰國王太后辭世舉國哀悼"
  },
  {
    "sequence": 307,
    "start": 952,
    "duration": 3,
    "text": "當局呼籲旅客保持莊重"
  },
  {
    "sequence": 308,
    "start": 955,
    "duration": 5,
    "text": "而近期去泰國酒吧等營業場所時間"
  },
  {
    "sequence": 309,
    "start": 960,
    "duration": 2,
    "text": "可能會有異動"
  },
  {
    "sequence": 310,
    "start": 962,
    "duration": 4,
    "text": "節慶活動也可能會延期"
  },
  {
    "sequence": 311,
    "start": 966,
    "duration": 4,
    "text": "接著來看我們的整理報導"
  },
  {
    "sequence": 312,
    "start": 970,
    "duration": 7,
    "text": "泰國王太后失利級24號"
  },
  {
    "sequence": 313,
    "start": 977,
    "duration": 2,
    "text": "因為血液感染病逝"
  },
  {
    "sequence": 314,
    "start": 979,
    "duration": 1,
    "text": "享壽93歲"
  },
  {
    "sequence": 315,
    "start": 980,
    "duration": 2,
    "text": "泰國進入果桑期"
  },
  {
    "sequence": 316,
    "start": 982,
    "duration": 2,
    "text": "機關學校都降半期"
  },
  {
    "sequence": 317,
    "start": 984,
    "duration": 3,
    "text": "多數民眾穿上黑衣服表達追思"
  },
  {
    "sequence": 318,
    "start": 987,
    "duration": 1,
    "text": "而觀光業部分"
  },
  {
    "sequence": 319,
    "start": 988,
    "duration": 2,
    "text": "雖然並沒有禁止娛樂或慶典活動"
  },
  {
    "sequence": 320,
    "start": 990,
    "duration": 2,
    "text": "但提醒要保持莊重"
  },
  {
    "sequence": 321,
    "start": 992,
    "duration": 1,
    "text": "旅遊業者提醒"
  },
  {
    "sequence": 322,
    "start": 993,
    "duration": 3,
    "text": "雖然大部分旅遊景點照常開放"
  },
  {
    "sequence": 323,
    "start": 996,
    "duration": 3,
    "text": "不過有節慶元素的活動可能會延後舉行"
  },
  {
    "sequence": 324,
    "start": 999,
    "duration": 3,
    "text": "酒吧等娛樂場所營業時間也可能有異動"
  },
  {
    "sequence": 325,
    "start": 1002,
    "duration": 2,
    "text": "建議旅客準備深色衣服"
  },
  {
    "sequence": 326,
    "start": 1004,
    "duration": 2,
    "text": "尊重當地悼念氛圍"
  },
  {
    "sequence": 327,
    "start": 1006,
    "duration": 3,
    "text": "也要避免談論王氏級政治議題"
  },
  {
    "sequence": 328,
    "start": 1009,
    "duration": 3,
    "text": "花蓮馬太安溪燕色湖釀災滿一個月後"
  },
  {
    "sequence": 329,
    "start": 1012,
    "duration": 4,
    "text": "花蓮縣府與勞動部合作聘用天災理事工"
  },
  {
    "sequence": 330,
    "start": 1016,
    "duration": 3,
    "text": "讓災區失業者獲得短期就業安置"
  },
  {
    "sequence": 331,
    "start": 1019,
    "duration": 2,
    "text": "工作包含家園重建"
  },
  {
    "sequence": 332,
    "start": 1021,
    "duration": 2,
    "text": "環境清理與物資搬運"
  },
  {
    "sequence": 333,
    "start": 1023,
    "duration": 1,
    "text": "為期三個月"
  },
  {
    "sequence": 334,
    "start": 1024,
    "duration": 2,
    "text": "每月最高工時150小時"
  },
  {
    "sequence": 335,
    "start": 1026,
    "duration": 2,
    "text": "時薪190元"
  },
  {
    "sequence": 336,
    "start": 1028,
    "duration": 2,
    "text": "開放四個地點登記報名"
  },
  {
    "sequence": 337,
    "start": 1030,
    "duration": 1,
    "text": "昨天針對燕子口"
  },
  {
    "sequence": 338,
    "start": 1031,
    "duration": 2,
    "text": "燕色湖壩體開挖深草線"
  },
  {
    "sequence": 339,
    "start": 1033,
    "duration": 1,
    "text": "引流湖水"
  },
  {
    "sequence": 340,
    "start": 1034,
    "duration": 2,
    "text": "泥保署花蓮分署表示"
  },
  {
    "sequence": 341,
    "start": 1036,
    "duration": 2,
    "text": "水位已經緩降"
  },
  {
    "sequence": 342,
    "start": 1038,
    "duration": 2,
    "text": "乳丹橋橋面積水也有退縮"
  },
  {
    "sequence": 343,
    "start": 1040,
    "duration": 3,
    "text": "但壩體結構未顯著削弱"
  },
  {
    "sequence": 344,
    "start": 1043,
    "duration": 2,
    "text": "接下來仍會繼續作業"
  },
  {
    "sequence": 345,
    "start": 1045,
    "duration": 2,
    "text": "記者綜合報導"
  },
  {
    "sequence": 346,
    "start": 1047,
    "duration": 3,
    "text": "國際消息來看"
  },
  {
    "sequence": 347,
    "start": 1050,
    "duration": 2,
    "text": "發生在19號"
  },
  {
    "sequence": 348,
    "start": 1052,
    "duration": 3,
    "text": "法國巴黎羅浮宮珠寶切案"
  },
  {
    "sequence": 349,
    "start": 1055,
    "duration": 3,
    "text": "出現了重大進展"
  },
  {
    "sequence": 350,
    "start": 1058,
    "duration": 1,
    "text": "媒體指出"
  },
  {
    "sequence": 351,
    "start": 1059,
    "duration": 3,
    "text": "警方逮捕到了兩名嫌犯"
  },
  {
    "sequence": 352,
    "start": 1062,
    "duration": 2,
    "text": "而其中一名男子"
  },
  {
    "sequence": 353,
    "start": 1064,
    "duration": 3,
    "text": "還正準備從機場出境"
  },
  {
    "sequence": 354,
    "start": 1067,
    "duration": 2,
    "text": "警方雖然出面證實"
  },
  {
    "sequence": 355,
    "start": 1069,
    "duration": 4,
    "text": "但是也對消息外洩感到遺憾"
  },
  {
    "sequence": 356,
    "start": 1073,
    "duration": 3,
    "text": "在羅浮宮的遊客"
  },
  {
    "sequence": 357,
    "start": 1076,
    "duration": 1,
    "text": "有些已經聽說了"
  },
  {
    "sequence": 358,
    "start": 1077,
    "duration": 3,
    "text": "之前大膽偷竊的盜賊落網"
  },
  {
    "sequence": 359,
    "start": 1080,
    "duration": 1,
    "text": "最先報導的是"
  },
  {
    "sequence": 360,
    "start": 1081,
    "duration": 1,
    "text": "法國媒體巴黎人報"
  },
  {
    "sequence": 361,
    "start": 1082,
    "duration": 2,
    "text": "從消息人士那邊所得知"
  },
  {
    "sequence": 362,
    "start": 1100,
    "duration": 2,
    "text": "巴黎檢察官貝庫歐發聲明"
  },
  {
    "sequence": 363,
    "start": 1102,
    "duration": 2,
    "text": "證實當局展開逮捕行動"
  },
  {
    "sequence": 364,
    "start": 1104,
    "duration": 2,
    "text": "但並未透露被捕人數"
  },
  {
    "sequence": 365,
    "start": 1106,
    "duration": 2,
    "text": "或嫌犯身份等細節"
  },
  {
    "sequence": 366,
    "start": 1108,
    "duration": 2,
    "text": "也沒有證實是否追回任何珠寶"
  },
  {
    "sequence": 367,
    "start": 1110,
    "duration": 2,
    "text": "貝庫歐也對走漏風聲不滿"
  },
  {
    "sequence": 368,
    "start": 1112,
    "duration": 2,
    "text": "表示這只會對已經動員的"
  },
  {
    "sequence": 369,
    "start": 1114,
    "duration": 3,
    "text": "百來名調查人員的工作造成阻礙"
  },
  {
    "sequence": 370,
    "start": 1117,
    "duration": 2,
    "text": "包括搜尋失竊的珠寶"
  },
  {
    "sequence": 371,
    "start": 1119,
    "duration": 1,
    "text": "以及所有嫌犯"
  },
  {
    "sequence": 372,
    "start": 1120,
    "duration": 1,
    "text": "根據巴黎人報的報導"
  },
  {
    "sequence": 373,
    "start": 1121,
    "duration": 3,
    "text": "兩名30多歲來自賽納聖丹尼省"
  },
  {
    "sequence": 374,
    "start": 1124,
    "duration": 2,
    "text": "男子25號晚間被捕"
  },
  {
    "sequence": 375,
    "start": 1126,
    "duration": 3,
    "text": "該區是法國最貧困的地區之一"
  },
  {
    "sequence": 376,
    "start": 1129,
    "duration": 2,
    "text": "美聯社根據一名未經授權的警官"
  },
  {
    "sequence": 377,
    "start": 1131,
    "duration": 2,
    "text": "私下透露報導指出"
  },
  {
    "sequence": 378,
    "start": 1133,
    "duration": 2,
    "text": "警方過去對嫌犯有所掌握"
  },
  {
    "sequence": 379,
    "start": 1135,
    "duration": 1,
    "text": "其中一人被逮捕時"
  },
  {
    "sequence": 380,
    "start": 1136,
    "duration": 3,
    "text": "正試圖搭上飛往阿爾及利亞的班機"
  },
  {
    "sequence": 381,
    "start": 1139,
    "duration": 2,
    "text": "並補充其中一名嫌犯"
  },
  {
    "sequence": 382,
    "start": 1141,
    "duration": 2,
    "text": "是根據DNA機證鎖定身份"
  },
  {
    "sequence": 383,
    "start": 1143,
    "duration": 2,
    "text": "貝庫歐稍早前曾指出"
  },
  {
    "sequence": 384,
    "start": 1145,
    "duration": 2,
    "text": "鑒識專家在犯罪現場"
  },
  {
    "sequence": 385,
    "start": 1147,
    "duration": 2,
    "text": "鑒識多達150份證據"
  },
  {
    "sequence": 386,
    "start": 1149,
    "duration": 2,
    "text": "羅浮宮博物館19號遭竊賊"
  },
  {
    "sequence": 387,
    "start": 1151,
    "duration": 3,
    "text": "闖入並掏走多件珠寶館藏"
  },
  {
    "sequence": 388,
    "start": 1154,
    "duration": 2,
    "text": "財損估達八千八百萬歐元"
  },
  {
    "sequence": 389,
    "start": 1156,
    "duration": 2,
    "text": "竊賊當時假扮施工工人"
  },
  {
    "sequence": 390,
    "start": 1158,
    "duration": 2,
    "text": "停車在羅浮宮外牆下等"
  },
  {
    "sequence": 391,
    "start": 1160,
    "duration": 1,
    "text": "以降低警覺"
  },
  {
    "sequence": 392,
    "start": 1161,
    "duration": 3,
    "text": "以三十公尺伸縮梯和藍式升降機"
  },
  {
    "sequence": 393,
    "start": 1164,
    "duration": 1,
    "text": "破窗進入長廊"
  },
  {
    "sequence": 394,
    "start": 1165,
    "duration": 2,
    "text": "竊取八件珍品"
  },
  {
    "sequence": 395,
    "start": 1167,
    "duration": 2,
    "text": "包含法蘭西皇帝納珀倫一世"
  },
  {
    "sequence": 396,
    "start": 1169,
    "duration": 2,
    "text": "送給第二任妻子馬利路易斯皇后的"
  },
  {
    "sequence": 397,
    "start": 1171,
    "duration": 2,
    "text": "祖母綠鑽石項鍊等"
  },
  {
    "sequence": 398,
    "start": 1173,
    "duration": 2,
    "text": "公視新聞黃遠林編譯"
  },
  {
    "sequence": 399,
    "start": 1185,
    "duration": 4,
    "text": "其他地區早晚也偏涼"
  },
  {
    "sequence": 400,
    "start": 1189,
    "duration": 3,
    "text": "而桃園以北跟東北部"
  },
  {
    "sequence": 401,
    "start": 1192,
    "duration": 3,
    "text": "濕冷的天氣會持續到週三"
  },
  {
    "sequence": 402,
    "start": 1195,
    "duration": 4,
    "text": "可能要到週四才有機會看到陽光"
  },
  {
    "sequence": 403,
    "start": 1199,
    "duration": 3,
    "text": "土石泥流漫上路面"
  },
  {
    "sequence": 404,
    "start": 1202,
    "duration": 2,
    "text": "新北市雙溪區連日大雨"
  },
  {
    "sequence": 405,
    "start": 1204,
    "duration": 1,
    "text": "山區直衝而下的土石"
  },
  {
    "sequence": 406,
    "start": 1205,
    "duration": 2,
    "text": "甚至沖毀了道路護欄"
  },
  {
    "sequence": 407,
    "start": 1207,
    "duration": 2,
    "text": "路面也嚴重受損變形"
  },
  {
    "sequence": 408,
    "start": 1209,
    "duration": 2,
    "text": "阻斷北38線道行車路線"
  },
  {
    "sequence": 409,
    "start": 1211,
    "duration": 4,
    "text": "工程人員被妥車輛在遮雨棚雨勢一緩就出動"
  },
  {
    "sequence": 410,
    "start": 1215,
    "duration": 3,
    "text": "公署也協調當地警方進行交通管制措施"
  },
  {
    "sequence": 411,
    "start": 1218,
    "duration": 12,
    "text": "大台北市區白天一度雨停"
  },
  {
    "sequence": 412,
    "start": 1230,
    "duration": 2,
    "text": "但雲層偏後仍不見陽光"
  },
  {
    "sequence": 413,
    "start": 1232,
    "duration": 2,
    "text": "週日起隨東北疾風又再增強"
  },
  {
    "sequence": 414,
    "start": 1234,
    "duration": 2,
    "text": "中部以北低溫來到21度左右"
  },
  {
    "sequence": 415,
    "start": 1236,
    "duration": 1,
    "text": "迎風面也持續降雨"
  },
  {
    "sequence": 416,
    "start": 1237,
    "duration": 2,
    "text": "氣象署發佈大雨特報"
  },
  {
    "sequence": 417,
    "start": 1239,
    "duration": 2,
    "text": "迎風面激動北海岸"
  },
  {
    "sequence": 418,
    "start": 1241,
    "duration": 2,
    "text": "雙北山區和宜蘭還是要留意大雨"
  },
  {
    "sequence": 419,
    "start": 1243,
    "duration": 1,
    "text": "探方即落實"
  },
  {
    "sequence": 420,
    "start": 1244,
    "duration": 2,
    "text": "這波東北疾風將持續影響到週三"
  },
  {
    "sequence": 421,
    "start": 1246,
    "duration": 2,
    "text": "其中週二跟週三這兩天"
  },
  {
    "sequence": 422,
    "start": 1248,
    "duration": 3,
    "text": "在宜蘭地區可能會有局部大雨的狀況"
  },
  {
    "sequence": 423,
    "start": 1251,
    "duration": 2,
    "text": "雨勢還是比較多一些"
  },
  {
    "sequence": 424,
    "start": 1253,
    "duration": 1,
    "text": "而且在週二的時候"
  },
  {
    "sequence": 425,
    "start": 1254,
    "duration": 2,
    "text": "包括北海岸跟大台北山區"
  },
  {
    "sequence": 426,
    "start": 1256,
    "duration": 2,
    "text": "也是會有一些局部大雨的情況"
  },
  {
    "sequence": 427,
    "start": 1258,
    "duration": 2,
    "text": "週四到週五東北疾風減弱"
  },
  {
    "sequence": 428,
    "start": 1260,
    "duration": 3,
    "text": "桃園以北到大台北西側有機會見到陽光"
  },
  {
    "sequence": 429,
    "start": 1263,
    "duration": 2,
    "text": "但週六起又會再有一波東北疾風暴道"
  },
  {
