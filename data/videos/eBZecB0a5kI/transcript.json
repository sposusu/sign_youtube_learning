[
  {
    "start": 0,
    "duration": 12,
    "text": "(音樂)",
    "hasSignLanguage": false
  },
  {
    "start": 12,
    "duration": 2,
    "text": "看新聞 開視野",
    "hasSignLanguage": false
  },
  {
    "start": 14,
    "duration": 5,
    "text": "歡迎收看今天九月二十四號的公視手語新聞",
    "hasSignLanguage": false
  },
  {
    "start": 19,
    "duration": 5,
    "text": "小鄉來關心 隨著牆台劃家沙離開",
    "hasSignLanguage": true
  },
  {
    "start": 24,
    "duration": 5,
    "text": "海上颱風警報 已經在昨晚八點半解除",
    "hasSignLanguage": true
  },
  {
    "start": 29,
    "duration": 4,
    "text": "不過這次颱風 已經造成14個人死亡",
    "hasSignLanguage": true
  },
  {
    "start": 33,
    "duration": 3,
    "text": "還有18個人受傷",
    "hasSignLanguage": true
  },
  {
    "start": 36,
    "duration": 4,
    "text": "災情最嚴重的是在花蓮",
    "hasSignLanguage": true
  },
  {
    "start": 40,
    "duration": 3,
    "text": "馬太安溪的燕色湖溢流",
    "hasSignLanguage": true
  },
  {
    "start": 43,
    "duration": 4,
    "text": "洪水夾雜著沙石衝向下游",
    "hasSignLanguage": true
  },
  {
    "start": 47,
    "duration": 3,
    "text": "大橋瞬間被沖毀",
    "hasSignLanguage": true
  },
  {
    "start": 50,
    "duration": 4,
    "text": "下午更是直接淹進了光復市區",
    "hasSignLanguage": true
  },
  {
    "start": 54,
    "duration": 3,
    "text": "當地成了汪洋一片",
    "hasSignLanguage": true
  },
  {
    "start": 57,
    "duration": 4,
    "text": "許多人緊急逃到二三樓避難",
    "hasSignLanguage": true
  },
  {
    "start": 61,
    "duration": 9,
    "text": "滾滾泥流灌進超市 貨架商品東倒西歪",
    "hasSignLanguage": true
  },
  {
    "start": 70,
    "duration": 3,
    "text": "店員抓著木板前進 保命優先",
